metadata:
  project: E36 Restomod -- Hella 6PV010946-141 Accelerator Pedal (DBW) Wiring
  description: >-
    Hella 6PV010946-141 standalone floor-mount accelerator pedal wired to
    MaxxECU RACE. Phase 3 (07K engine). RHD fallback option -- use this harness
    if the BMW E46 pedal bracket (epedal-bmw-e46.wv) does not fit the RHD pedal box.
    Hella pedal is a universal floor-mount module with no OEM bracket dependency;
    mount position is fully custom-fabricated (aluminum plate + 3x M6 studs).
    MaxxECU has a native pre-defined profile for this pedal.
    APS wiring is CABIN-TO-CABIN ONLY -- no firewall bulkhead crossing required
    (same as E46 variant). MaxxECU is cabin-mounted.
    Confirmed C2 pin assignments: APS1 → C2 E4 (AIN 6), APS2 → C2 F1 (AIN 7).
    Source: MaxxECU RACE GEN1 C2 pinout (maxxecu.com/webhelp/wirings-maxxecu_pinout.html).
    Cross-reference docs/dbw-pinouts.md for specs and comparison.

# ── TODO list ──────────────────────────────────────────────────────────────────
#
#   [ ] Only use this harness if BMW E46 bracket (epedal-bmw-e46.wv) fails RHD fitment
#   [ ] Fabricate floor-mount bracket -- aluminum plate, 3x M6 studs, position
#       for natural foot travel and return spring clearance
#   [ ] Source Hella 6PV010946-141 connector + terminals
#       (Hella part or pigtail from donor application)
#   [x] Confirm MaxxECU AIN pin numbers for APS1 and APS2
#       CONFIRMED: APS1 → C2 E4 (AIN 6), APS2 → C2 F1 (AIN 7)
#       Source: MaxxECU RACE GEN1 C2 pinout — maxxecu.com/webhelp/wirings-maxxecu_pinout.html
#   [x] APS routing: crosses firewall via Maven Connector B (Phase 3 install)
#   [ ] Verify bench: APS1 and APS2 idle/WOT voltages before installing in car
#   [ ] Load MaxxECU native Hella profile in MTune before calibration wizard
#   [ ] Run e-throttle calibration wizard after wiring

# ── Connectors ─────────────────────────────────────────────────────────────────

connectors:

  HELLA_PEDAL:
    type: "Hella 6PV010946-141 Standalone Accelerator Pedal Module"
    subtype: "Universal floor-mount -- fabricate bracket, no OEM pedal box needed"
    pincount: 6
    pinlabels:
      - "Pin 1 (GND 1 / sensor GND circuit 1)"
      - "Pin 2 (+5V 2 / sensor supply circuit 2)"
      - "Pin 3 (TPS 2 / APS2 signal)"
      - "Pin 4 (GND 2 / sensor GND circuit 2)"
      - "Pin 5 (+5V 1 / sensor supply circuit 1)"
      - "Pin 6 (TPS 1 / APS1 signal)"
    notes: >-
      6-pin dual-track hall-effect sensor (same dual-redundancy principle as E46 pedal).
      MaxxECU has a native pre-defined Hella profile -- select it in MTune before
      running the pedal calibration wizard.
      Universal floor-mount module -- mount position fabricated from aluminum plate.
      Used in Porsche 944/914 swaps and kit cars for exactly this reason.
      Source: Hella OEM supply or from a donor application. ~$80-120 new.
      Pinout source: MaxxECU E-Pedals Wiring Docs (maxxecu.se/webhelp/wirings-e_pedals.html).
      Note: Hella pin order differs from E46 pedal — signal wires are 6/3, not 4/6.

  MAXXECU_C2:
    type: "MaxxECU RACE GEN1 C2 connector (32-pin Molex CMC)"
    subtype: "Cabin-mounted ECU -- APS signal inputs at C2 E4 (AIN 6) and C2 F1 (AIN 7)"
    pincount: 2
    pinlabels:
      - "C2 E4 (AIN 6) — APS1 signal input"
      - "C2 F1 (AIN 7) — APS2 signal input"
    notes: >-
      Confirmed from MaxxECU RACE GEN1 C2 pinout:
        C2 E4 = AIN 6 (0-5V analog input)
        C2 F1 = AIN 7 (0-5V analog input)
      Source: maxxecu.com/webhelp/wirings-maxxecu_pinout.html
      AIN 5 (C2 G3) is occupied by the virtual clutch position sensor.
      MTune path: Settings → E-Throttle → Pedal position → load Hella 6PV010946-141
      native profile, then assign AIN 6 (APS1) and AIN 7 (APS2).

  MAXXECU_SUPPLY:
    type: "MaxxECU RACE main CMC supply rails"
    subtype: "+5V sensor supply (CMC G1) and Sensor GND (CMC H1) -- shared bus"
    pincount: 2
    pinlabels:
      - "CMC G1 (+5V sensor supply) — shared with TPS/MAP/CLT/CAM"
      - "CMC H1 (Sensor GND) — shared sensor ground bus"
    notes: >-
      Both APS circuits tap the same MaxxECU +5V sensor supply rail (CMC G1).
      Both APS sensor grounds return to the sensor GND bus (CMC H1).
      Do NOT connect APS GND to chassis GND or engine GND (C2 G4). Must go to sensor GND bus.
      Same supply points as E46 variant (epedal-bmw-e46.wv).

# ── Cables ─────────────────────────────────────────────────────────────────────

cables:

  CABLE_PEDAL_TO_MAXXECU:
    gauge: "24 AWG"
    length: "1.5 m"
    wirecount: 6
    colors: [BN, RD, WH, BN, RD, WH]
    shield: true
    notes: >-
      Cabin-only run: Hella pedal connector (footwell) → MaxxECU connector area (firewall).
      No firewall crossing. Route along tunnel/sill, away from audio wiring.
      24 AWG sufficient -- low-current sensor signals only.
      Shielded 6-conductor; drain shield at MaxxECU end only (single-end drain).
      Tie drain wire to CMC H1 (Sensor GND).
      Wire 1 BN: GND1 (pedal pin 1) → MAXXECU_SUPPLY GND bus (CMC H1).
      Wire 2 RD: +5V2 (pedal pin 2) → MAXXECU_SUPPLY +5V rail (CMC G1).
      Wire 3 WH: TPS2/APS2 signal (pedal pin 3) → MAXXECU_C2 F1 (AIN 7).
      Wire 4 BN: GND2 (pedal pin 4) → MAXXECU_SUPPLY GND bus (CMC H1).
      Wire 5 RD: +5V1 (pedal pin 5) → MAXXECU_SUPPLY +5V rail (CMC G1).
      Wire 6 WH: TPS1/APS1 signal (pedal pin 6) → MAXXECU_C2 E4 (AIN 6).
      Note: wire-color order differs from E46 variant -- label both ends clearly.
      APS crosses firewall via Maven Connector B (see harnesses/firewall-crossing-maven.wv).

# ── Connections ────────────────────────────────────────────────────────────────

connections:
  # APS signals: Hella pedal → MaxxECU C2 (AIN 6 / AIN 7)
  -
    - HELLA_PEDAL: [6, 3]
    - CABLE_PEDAL_TO_MAXXECU: [6, 3]
    - MAXXECU_C2: [1, 2]
  # APS supplies: Hella pedal → MaxxECU CMC +5V rail
  -
    - HELLA_PEDAL: [5, 2]
    - CABLE_PEDAL_TO_MAXXECU: [5, 2]
    - MAXXECU_SUPPLY: [1, 1]
  # APS grounds: Hella pedal → MaxxECU CMC sensor GND bus
  -
    - HELLA_PEDAL: [1, 4]
    - CABLE_PEDAL_TO_MAXXECU: [1, 4]
    - MAXXECU_SUPPLY: [2, 2]
