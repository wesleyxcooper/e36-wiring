metadata:
  project: E36 Restomod -- Hella 6PV010946-141 Accelerator Pedal (DBW) Wiring
  description: >-
    Hella 6PV010946-141 standalone floor-mount accelerator pedal wired to
    MaxxECU RACE via Deutsch Autosport AS-series firewall bulkhead.
    Phase 3 (07K engine). RHD fallback option -- use this harness if the BMW
    E46 pedal bracket (epedal-bmw-e46.wv) does not fit the RHD pedal box.
    Hella pedal is a universal floor-mount module with no OEM bracket dependency;
    mount position is fully custom-fabricated (aluminum plate + 3x M6 studs).
    MaxxECU has a native pre-defined profile for this pedal.
    Cross-reference docs/dbw-pinouts.md for specs and comparison.

# ── TODO list ──────────────────────────────────────────────────────────────────
#
#   [ ] Only use this harness if BMW E46 bracket (epedal-bmw-e46.wv) fails RHD fitment
#   [ ] Fabricate floor-mount bracket -- aluminum plate, 3x M6 studs, position
#       for natural foot travel and return spring clearance
#   [ ] Source Hella 6PV010946-141 connector + terminals
#       (Hella part or pigtail from donor application)
#   [ ] Assign final bulkhead pin numbers (same 6 pins as e46 variant -- bulkhead
#       is pedal-agnostic; only the cabin connector changes)
#   [ ] Confirm MaxxECU AIN pin numbers for APS1 and APS2
#   [ ] Verify bench: APS1 and APS2 idle/WOT voltages before installing in car
#   [ ] Load MaxxECU native Hella profile in MTune before calibration wizard
#   [ ] Run e-throttle calibration wizard after wiring

# ── Connectors ─────────────────────────────────────────────────────────────────

connectors:

  HELLA_PEDAL:
    type: "Hella 6PV010946-141 Standalone Accelerator Pedal Module"
    subtype: "Universal floor-mount -- fabricate bracket, no OEM pedal box needed"
    pincount: 6
    pinlabels:
      - "Pin 1 -- GND 1 (sensor ground, circuit 1)"
      - "Pin 2 -- +5V 2 (sensor supply, circuit 2)"
      - "Pin 3 -- TPS 2 / APS2 signal"
      - "Pin 4 -- GND 2 (sensor ground, circuit 2)"
      - "Pin 5 -- +5V 1 (sensor supply, circuit 1)"
      - "Pin 6 -- TPS 1 / APS1 signal"
    notes: >-
      6-pin dual-track hall-effect sensor (same dual-redundancy principle as E46 pedal).
      MaxxECU has a native pre-defined Hella profile -- select it in MTune before
      running the pedal calibration wizard.
      Universal floor-mount module -- mount position fabricated from aluminum plate.
      Used in Porsche 944/914 swaps and kit cars for exactly this reason.
      Source: Hella OEM supply or from a donor application. ~$80-120 new.
      Pinout source: MaxxECU E-Pedals Wiring Docs (maxxecu.se/webhelp/wirings-e_pedals.html).

  BULKHEAD_CABIN:
    type: "Deutsch Autosport AS-series firewall bulkhead -- CABIN SIDE"
    subtype: "Size 20 contacts -- 6 pins reserved for e-pedal (pins TBD)"
    pincount: 6
    pinlabels:
      - "Bulkhead pin TBD-A -- APS GND 1 (pass-through)"
      - "Bulkhead pin TBD-B -- APS GND 2 (pass-through)"
      - "Bulkhead pin TBD-C -- +5V 1 (pass-through)"
      - "Bulkhead pin TBD-D -- APS1 signal (pass-through)"
      - "Bulkhead pin TBD-E -- +5V 2 (pass-through)"
      - "Bulkhead pin TBD-F -- APS2 signal (pass-through)"
    notes: >-
      Identical bulkhead pin allocation to epedal-bmw-e46.wv.
      The bulkhead is pedal-agnostic -- only the cabin connector and pin mapping
      within the pedal-side cable changes. Engine side and MaxxECU side are identical.
      This lets you swap between E46 and Hella pedals without touching the bulkhead.

  BULKHEAD_ENGINE:
    type: "Deutsch Autosport AS-series firewall bulkhead -- ENGINE SIDE"
    subtype: "Size 20 contacts -- 6 pins reserved for e-pedal (pins TBD)"
    pincount: 6
    pinlabels:
      - "Bulkhead pin TBD-A -- APS GND 1 (pass-through)"
      - "Bulkhead pin TBD-B -- APS GND 2 (pass-through)"
      - "Bulkhead pin TBD-C -- +5V 1 (pass-through)"
      - "Bulkhead pin TBD-D -- APS1 signal (pass-through)"
      - "Bulkhead pin TBD-E -- +5V 2 (pass-through)"
      - "Bulkhead pin TBD-F -- APS2 signal (pass-through)"
    notes: >-
      Mating plug, engine side. Identical to epedal-bmw-e46.wv engine side.
      Pedal choice does not affect this connector or the MaxxECU side -- only the
      cabin-side cable and the Hella connector itself differ from the E46 variant.

  MAXXECU_APS:
    type: "MaxxECU RACE -- Analog Inputs + Sensor Supply + Sensor GND"
    subtype: "CMC connector -- AIN pins TBD, 5V SENS OUT, SGND"
    pincount: 6
    pinlabels:
      - "SGND (sensor GND 1) -- shared sensor ground bus"
      - "+5V SENS OUT (supply 2) -- MaxxECU 5V sensor reference"
      - "AIN x (APS2 signal) -- configure as APS2 in MTune"
      - "SGND (sensor GND 2) -- shared sensor ground bus"
      - "+5V SENS OUT (supply 1) -- MaxxECU 5V sensor reference"
      - "AIN y (APS1 signal) -- configure as APS1 in MTune"
    notes: >-
      Same MaxxECU connector as epedal-bmw-e46.wv -- this side is identical.
      Pin order within the MaxxECU connector is re-mapped from the Hella pin order.
      Load MaxxECU native Hella 6PV010946-141 profile before calibration wizard.
      MTune path: Settings -> E-Throttle -> Pedal position.

# ── Cables ─────────────────────────────────────────────────────────────────────

cables:

  CABLE_PEDAL_TO_BULKHEAD:
    gauge: "24 AWG"
    length: "0.8 m"
    wirecount: 6
    colors: [BK, RD, YE, BK, RD, GN]
    shield: true
    notes: >-
      Cabin-side cable: Hella pedal connector to bulkhead cabin face.
      24 AWG sufficient -- low-current sensor signals only.
      Shielded 6-conductor; drain shield to MaxxECU SGND at MaxxECU end only.
      Wire 1 BK: GND1 (Pin 1). Wire 2 RD: +5V2 (Pin 2).
      Wire 3 YE: TPS2/APS2 signal (Pin 3). Wire 4 BK: GND2 (Pin 4).
      Wire 5 RD: +5V1 (Pin 5). Wire 6 GN: TPS1/APS1 signal (Pin 6).
      Note: wire-color order differs from E46 variant -- label both ends clearly.

  CABLE_BULKHEAD_TO_MAXXECU:
    gauge: "24 AWG"
    length: "0.4 m"
    wirecount: 6
    colors: [BK, RD, YE, BK, RD, GN]
    shield: true
    notes: >-
      Engine-side cable: bulkhead engine face to MaxxECU CMC connector.
      Short run -- MaxxECU is mounted on firewall in engine bay.
      Drain shield here to MaxxECU SGND (single drain point for full signal path).
      Identical to E46 variant engine-side cable -- same bulkhead pin mapping.

# ── Connections ────────────────────────────────────────────────────────────────

connections:
  # Hella pedal → bulkhead cabin side
  -
    - HELLA_PEDAL: [1, 2, 3, 4, 5, 6]
    - CABLE_PEDAL_TO_BULKHEAD: [1, 2, 3, 4, 5, 6]
    - BULKHEAD_CABIN: [1, 2, 3, 4, 5, 6]
  # Bulkhead engine side → MaxxECU
  -
    - BULKHEAD_ENGINE: [1, 2, 3, 4, 5, 6]
    - CABLE_BULKHEAD_TO_MAXXECU: [1, 2, 3, 4, 5, 6]
    - MAXXECU_APS: [1, 2, 3, 4, 5, 6]
