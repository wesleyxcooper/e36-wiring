# dct-shifter.wv
# DCT Shifter Paddle → MaxxECU DIN 1 / DIN 2 (via engine-bay ECU through firewall)
# Source: dctshifter.com/pages/installation
#
# Firewall crossing: with MaxxECU RACE H2O mounted in the engine bay under the
# active architecture, the DCT paddle switches (cabin-mounted) cross the firewall
# to reach the ECU DIN inputs. Three wires (UP, DOWN, GND) traverse the shared
# DT-12 cabin ↔ engine-bay crossing on pins 10, 11, 12. See:
#   - harnesses/firewall-crossing-dt12.wv (DT12_CABIN pins 10-12)
#   - docs/vendor/maxxecu/MaxxECU_RACE_H2O.md (H2O + engine-bay rationale)
#
# NOTE: The DCT shifter is on MaxxECU discrete DIN inputs, NOT on CAN. Passive
# momentary switches close UP/DOWN to GND. Do not confuse with Gauge.S cluster
# which IS CAN-based (see harnesses/body-x20.wv GAUGES_CAN_FEED).
#
# Compatible Phase 1 → Phase 3 (shifter paddle unchanged through engine swap).

connectors:

  DCT_PADDLE:
    type: "DCT Shifter E36 paddle"
    subtype: "Mechanical sequential shifter — 3-wire NO push switches"
    pincount: 3
    pinlabels: ["UP (Black)", "DOWN (Blue)", "GND (Brown)"]
    notes: >
      Source: dctshifter.com/pages/installation
      Passive momentary switches — no +12V supply needed.
      UP: closes UP pin to GND on upshift pull.
      DOWN: closes DOWN pin to GND on downshift pull.
      Hold UP 1+ s activates launch control / transbrake.
      MTune: Transmission, Shifter type, Sequential.

  ECU_16PIN:
    type: "MaxxECU M50 terminated harness — 16-pin aux breakout"
    subtype: "REV2. Source: maxxecu.com/webhelp/wirings-terminated_engine_harness-bmw_m50.html"
    pincount: 16
    pinlabels:
      - "+5V OUT"         # 1
      - "Sensor GND"      # 2
      - "INJ 7 (N/A M52)" # 3
      - "GPO 8 / TACHO"   # 4
      - "GPO 7 / DIN 3"   # 5
      - "GPO 6"           # 6
      - "GPO 3"           # 7
      - "GPO 2"           # 8
      - "CAN L"           # 9
      - "CAN H"           # 10
      - "AIN 4"           # 11
      - "AIN 3"           # 12
      - "AIN 2"           # 13
      - "AIN 1"           # 14
      - "DIN 2"           # 15
      - "DIN 1"           # 16

cables:

  W_SHIFTER:
    wirecount: 3
    colors: [BK, BU, BN]
    wirelabels: ["UP (DIN 2)", "DOWN (DIN 1)", GND]
    length: 1.5 m
    notes: "Unshielded. Route away from ignition wires. Wire colors match DCT Shifter OEM harness."

connections:

  - - DCT_PADDLE: [1, 2, 3]
    - W_SHIFTER: [1, 2, 3]
    - ECU_16PIN: [15, 16, 2]
