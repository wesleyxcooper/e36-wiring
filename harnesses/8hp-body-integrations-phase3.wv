# 8hp-body-integrations-phase3.wv
# ZF 8HP → E36 body harness integration — PHASE 3 (07K + custom engine harness era)
#
# At the Phase 3 swap, the M50 pre-terminated harness is retired. The custom 07K
# harness (see harnesses/maxxecu-07k.wv) does NOT have the M50 harness's spare
# BOOST_SOLENOID Superseal 2-pin connector that Phase 1 used for GPO 1 access.
# Under the new arch we also have PMU16 fully integrated, which can drive the
# reverse light circuit as a direct high-side output — no separate relay needed.
#
# Under the H2O engine-bay-mount architecture (unchanged from Phase 1):
#   - MaxxECU RACE H2O: engine bay (OEM DME E-box cavity, intake side of RHD car)
#   - PMU16: engine bay, alongside the H2O
#   - Custom 07K harness: direct-terminate at MaxxECU CMC
#   - No discrete reverse-light relay in Phase 3 (PMU16 replaces it)
#
# See harnesses/8hp-body-integrations-phase1.wv for the Phase 1 (M50 harness era)
# implementation that this file replaces at the 07K swap.
#
# ─────────────────────────────────────────────────────────────────────────────
# Signal chain — Phase 3 reverse lights:
#
#   1. MaxxECU MTune: "Transmission Reverse" function assigned to a CAN output
#      channel that PMU16 subscribes to (e.g., MaxxECU broadcasts "8HP gear = R"
#      over CAN; PMU16 reads and enables its configured output)
#   2. PMU16 output — configured as high-side switch to +12V for reverse lights.
#      Current draw: ~4-8A total for both E36 reverse light bulbs (~1-2A per bulb,
#      2 bulbs × 2 cars split evenly) — well within a single PMU16 output rating
#      (25A per output per Ecumaster PMU_Manual.pdf p.1)
#   3. PMU16 output wire → X20 engine-side pin 10 (BL/GE)
#   4. X20 pin 10 crosses firewall via the OEM X20 connector (unchanged)
#   5. Cabin-side X20 pin 10 → OEM body harness → both reverse light bulbs
#      in the tail lights
#
# X20 pin 10 is the correct pin for cars that started life as manual gearboxes
# (ZF S5-31 / ZF S5-D — no EGS module). Non-EGS reverse light path.
# X20 pin 22 (EGS path) is left floating. Same as Phase 1 — the difference
# from Phase 1 is upstream of X20 pin 10 (PMU16 direct vs GPO+relay).
#
# ─────────────────────────────────────────────────────────────────────────────
# Starter inhibit — UNCHANGED from Phase 1 (software-only in MTune):
#
#   MTune: Advanced → Starter control → Starter inhibit:
#     - Inhibit crank when gear ≠ P and gear ≠ N.
#   See harnesses/8hp-body-integrations-phase1.wv for full starter-inhibit note —
#   nothing changes between phases for this circuit.
#
# ─────────────────────────────────────────────────────────────────────────────
# Sources:
#   - harnesses/body-x20.wv (X20 pin 10 documentation)
#   - E36 ETM section 0670 (reverse light switch path — jonkensy.com)
#   - Ecumaster PMU_Manual.pdf p.1 (25A per output rating)
#   - MaxxECU output routing: maxxecu.com/webhelp/settings-outputs.html and
#     maxxecu.com/webhelp/advanced-8hp-virtual_clutch.html (8HP gear reporting via CAN)

connectors:

  # ── PMU16 high-side output — reverse light control ────────────────────────
  PMU16_REV_OUT:
    type: "PMU16 high-side output (configured as reverse light switch)"
    subtype: "One PMU16 output channel — spec any free 25A channel per power-distribution.wv"
    pincount: 1
    pinlabels: ["+12V switched (reverse light output)"]
    notes: >
      PMU16 output configured in PMU software as a CAN-triggered high-side switch:
        - Trigger source: MaxxECU CAN broadcast of "gear position = R"
          (MaxxECU MTune: 8HP data → gear index → transmit on CAN)
        - Output mode: high-side switch, +12V from PMU16 BATT+ rail
        - Current limit: set 10A (headroom over ~4-8A actual draw)
        - No PWM, no soft-start — binary on/off
      Replaces the Phase 1 discrete relay entirely — one PMU16 output does the work
      of the previous GPO+relay+fuse combination.
      See harnesses/power-distribution.wv for PMU16 output channel allocation.

  # ── X20 reverse light input (unchanged from Phase 1) ─────────────────────
  X20_REV:
    type: "BMW E36 X20 engine-side — pin 10 only"
    subtype: "Non-EGS reverse light switch input (BL/GE) — OEM cabin body harness"
    pincount: 1
    pinlabels: ["Pin 10 — Reverse Light Switch no-EGS (BL/GE)"]
    notes: >
      Same X20 pin 10 as Phase 1 — cabin side is unmodified OEM. Only the
      engine-side connection changes: Phase 1 wired to discrete relay pin 87;
      Phase 3 wires directly to PMU16 output.
      X20 pin 22 (GN/WS, EGS path) stays floating.
      Source: harnesses/body-x20.wv pin 10; BMW E36 ETM section 0670 (jonkensy.com).


cables:

  W_REV_OUTPUT:
    wirecount: 1
    colors: [BU]
    wirelabels: ["Reverse light switched +12V"]
    length: 0.8 m
    notes: >
      From PMU16 output pin to X20 engine-side pin 10 (BL/GE).
      16 AWG (matches OEM wire gauge and provides margin for ~8A peak).
      Engine-bay-only run — X20 pin 10 cabin side is unmodified OEM.
      No firewall crossing required (X20 IS the firewall crossing, unchanged).


connections:

  # ── PMU16 output → X20 pin 10 → OEM cabin body harness → reverse lights ───
  - - PMU16_REV_OUT: [1]
    - W_REV_OUTPUT: [1]
    - X20_REV: [1]            # X20 pin 10 → OEM body harness → reverse lights
