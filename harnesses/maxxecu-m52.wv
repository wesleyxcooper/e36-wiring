# maxxecu-m52.wv
# MaxxECU Race ↔ BMW M52 Engine Harness (Phase 1)
#
# Source: https://www.maxxecu.com/webhelp/wirings-terminated_engine_harness-bmw_m50.html
# Harness revision: REV 2
# Note: Harness is built for non-VANOS M50 head.
#       M52 VANOS cam sensor requires sensor swap to BMW 12141726590.
#
# ─────────────────────────────────────────────────────────────────────────────
# TODOs — data needed before this diagram is build-ready:
#
# DONE: MaxxECU CMC main connector pin assignments
#       The full 48-pin Molex CMC pinout IS publicly available at:
#       maxxecu.com/webhelp/wirings-maxxecu_pinout.html
#       ECU_CMC connector below is updated with real pin positions (A1-M4 → 1-48).
#       Row layout: A1-A4=1-4, B1-B4=5-8, C1-C4=9-12, D1-D4=13-16, E1-E4=17-20,
#       F1-F4=21-24, G1-G4=25-28, H1-H4=29-32, J1-J4=33-36, K1-K4=37-40,
#       L1-L4=41-44, M1-M4=45-48.
#
# TODO: Injector firing order — which MaxxECU INJ output maps to which cylinder
#       M52 firing order: 1-5-3-6-2-4. Verify INJ 1-6 assignment in MaxxTune
#       :: Engine :: Ignition :: Firing order. Document here.
#
# TODO: Ignition firing order — which MaxxECU IGN output maps to which coil
#       Same firing order as injectors. Confirm IGN 1-6 coil numbering from
#       MaxxTune :: Engine :: Ignition :: Coil assignments.
#
# TODO: Alternator D+ wiring
#       12-pin pin 12 (M) = Alternator +12V (D+ excite terminal).
#       Must be wired in series with a charge bulb (or resistor) to +12V ignition.
#       Without this the alternator will not regulate charging below ~1500 RPM.
#       Confirm wire gauge and bulb spec from MaxxECU install guide.
#
# TODO: EWS2 bypass wiring
#       M52 (OBD2) has EWS2 immobilizer — MaxxECU has no EWS protocol.
#       Without bypass: cranks but will not fire.
#       Option A (preferred): EWS delete emulator module — confirm pinout and
#         which X20 / ECU connector pins are affected.
#       Option B: hard-wire bypass at ECU connector.
#       Research MaxxECU community for current preferred method before install.
#       Ref: https://falkmfg.com/blogs/news/how-to-bypass-ews2-for-e36-bmw
#       Document bypass connections here once method is confirmed.
#
# DONE: Idle air control valve (IDLE_VALVE) GPO 4 + GPO 5 CMC pins
#       GPO 4 = E4 = CMC pin 20 (ICV coil A).
#       GPO 5 = A1 = CMC pin 1  (ICV coil B).
#       Both hardwired within terminated harness to ICV connector (not on 16-pin breakout).
#
# DONE: GPO 1 (M50 harness BOOST_SOL connector stub, Superseal 2-way) = CMC pin B4 = CMC pin 8.
#       Phase 1 (M52 NA): GPO 1 drives the reverse light relay low-side. The BOOST_SOL
#       connector stub is repurposed as the relay coil low-side access point (no boost solenoid
#       in Phase 1). Phase 3 (07K): GPO 1 drives the boost solenoid.
#       +12V for solenoid/relay comes from coil/inj rail (ECU_12PIN[1]).
#
# DONE: Firewall bulkhead connector — 79-way decided (Deutsch AS79 / Souriau 8STA).
#       ~59 pins used/reserved; ~20 true spares for expansion.
#       Cabin side permanent: MaxxECU, relay board, fuse block, 8HP powerhold relay.
#       M52 engine harness terminates at engine-side mating plug (plug-and-play swap to 07K).
#       Full pin assignment: harnesses/firewall-bulkhead.wv
#       Source: RaceSpec Online (racespeconline.com) — AS79 ~$120-180.
#
# TODO: Wire gauges throughout
#       12-pin power wires (12V coils, ECU power, engine GND) require minimum 14 AWG.
#       Injector/ignition wires: 18-20 AWG typical.
#       CAN bus: 22 AWG twisted pair, 120ohm impedance.
#       Confirm all gauges from harness as-received and document.
#
# TODO: PST-F1 mounting confirmation
#       M52 VANOS banjo bolt path (M14x1.5 :: M10x1.0 adapter :: PST-F1) is the plan.
#       Confirm the adapter thread spec matches the PST-F1 body at install.
#       PST-F1 4-pin connector pinout should be confirmed against Gauge.S docs.
#
# TODO: MAP sensor connector and vacuum port
#       MaxxECU M50 harness includes MAP sensor with vacuum hose.
#       Confirm MAP sensor connector type, hose routing to intake manifold.
#       Tee into intake manifold vacuum port before throttle body.
#
# DONE: Wideband O2 harness — LSU 4.2. WIDEBAND connector (line ~299),
#       W_WBO2 cable with shield: true (line ~697), W_WBO2_HTR heater+ stub
#       (line ~703), and connections block (line ~981) are all present.
#       Sensor: Bosch LSU 4.2. MaxxECU M50 terminated harness explicitly specifies
#       LSU 4.2 connector (source: maxxecu.com/webhelp/wirings-terminated_engine_harness-bmw_m50.html).
#       Phase 3 (07K) uses LSU 4.9 — different pinout; do NOT substitute sensors between phases.
# ─────────────────────────────────────────────────────────────────────────────
#
# This build adds to the base harness:
#   - ZF 8HP70 CAN (MaxxECU GEN1 native, via 16-pin CAN H/L)
#   - DCT Shifter paddle (4-wire, DIN 1/2)
#   - Flex fuel sensor (DIN 3 / GPO 7)
#   - Bosch PST-F1 oil sensor (AIN 1 temp, AIN 3 pressure)
#   - Gauge.S cluster CAN (shared CAN bus with 8HP)
#   - SPAL fan PWM (GPO 6 :: relay)
#   - 8HP virtual clutch position sensor (C2 AIN 5 / C2 pin G3)
#       E36 clutch pedal retained, mechanical linkage disconnected.
#       Rotary position sensor at pedal pivot → MaxxECU C2 AIN 5.
#       C1 AIN 1-4 are fully allocated; C2 is REQUIRED for this signal.
#       Requires Binary5 8HP TCU firmware + MTune 1.157+.
#       Source: maxxecu.com/webhelp/advanced-8hp-virtual_clutch.html

connectors:

  # ── MaxxECU Race auxiliary connectors ──────────────────────────────────────

  ECU_16PIN:
    type: "Cinch 16-pin auxiliary"
    pincount: 16
    pinlabels:
      - "+5V OUT"
      - "Sensor GND"
      - "INJ 7 (N/A M52)"
      - "GPO 8 / TACHO"
      - "GPO 7 / DIN 3"
      - "GPO 6"
      - "GPO 3"
      - "GPO 2"
      - "CAN L"
      - "CAN H"
      - "AIN 4"
      - "AIN 3"
      - "AIN 2"
      - "AIN 1"
      - "DIN 2"
      - "DIN 1"
    notes: "REV 2 pinout. See maxxecu.com/webhelp/wirings-terminated_engine_harness-bmw_m50.html"

  ECU_12PIN:
    type: "Cinch 12-pin power/chassis"
    pincount: 12
    pinlabels:
      - "+12V Coils+Inj Power"
      - "Engine GND"
      - "GPO 2 (Fuel Pump)"
      - "GPO 6 (FAN)"
      - "(spare)"
      - "Starter Trigger"
      - "+12V ECU Power"
      - "(spare)"
      - "(spare)"
      - "(spare)"
      - "(spare)"
      - "Alternator +12V (D+)"
    notes: "REV 2. Pin 1 fuse 20A, pin 7 fuse 20A (separate relays)."

  # ── Engine sensors ──────────────────────────────────────────────────────────

  CRANK_VR:
    type: "Bosch JPT 3-way"
    subtype: "M52 60-2 VR crank trigger"
    pincount: 3
    pinlabels: [Signal+, Signal-, Shield]
    notes: "OEM M52 crank sensor — 60-2 missing tooth. MaxxECU trigger type: N-1."

  CAM_HALL:
    type: "BMW 12141726590"
    subtype: "M52 cam Hall sensor — non-VANOS connector type, no +12V supply needed"
    pincount: 3
    pinlabels: [Signal, "Sensor GND", Shield]
    notes: >
      BMW PN 12141726590 is the non-VANOS type used by the MaxxECU M50 terminated harness.
      Swap from the OEM VANOS sensor to this part for plug-and-play fit. No +12V wire needed.
      Connector: Signal=pin1, Sensor GND=pin2, Shield=pin3.

  CLT:
    type: "Bosch JPT 2-way"
    subtype: "M52 coolant temp (NTC)"
    pincount: 2
    pinlabels: [Signal, "Sensor GND"]

  IAT:
    type: "OEM M52"
    subtype: "Intake air temp (NTC)"
    pincount: 2
    pinlabels: [Signal, "Sensor GND"]
    notes: "Mounted in intake boot upstream of throttle body."

  TPS:
    type: "OEM M52"
    subtype: "Throttle position sensor (0-5V)"
    pincount: 3
    pinlabels: ["+5V", Signal, GND]
    notes: "OEM M52 TPS. 3-wire potentiometer."

  VANOS_SOL:
    type: "Bosch JPT 2-way"
    subtype: "M52 VANOS intake solenoid"
    pincount: 2
    pinlabels: ["+12V", GND]
    notes: >-
      PWM via GPO 3. Disable in tune at 07K swap.
      Flyback diode: 1N4007 at connector, cathode (banded end) to +12V pin, anode to GND pin.

  IDLE_VALVE:
    type: "Bosch JPT 3-way"
    subtype: "M52 idle air control valve"
    pincount: 3
    pinlabels: [GND, "Coil A", "Coil B"]
    notes: >-
      Dual-coil stepper-style ICV. GPO 4 and GPO 5.
      Flyback diodes: 1N4007 across each coil at connector, cathode toward +12V supply, anode toward GPO pin.

  # ── Fueling ─────────────────────────────────────────────────────────────────

  INJ_1:
    type: "Bosch JPT 2-way"
    subtype: "Injector 1 (Bosch 440cc EV1)"
    pincount: 2
    pinlabels: ["+12V", "INJ 1"]

  INJ_2:
    type: "Bosch JPT 2-way"
    subtype: "Injector 2"
    pincount: 2
    pinlabels: ["+12V", "INJ 2"]

  INJ_3:
    type: "Bosch JPT 2-way"
    subtype: "Injector 3"
    pincount: 2
    pinlabels: ["+12V", "INJ 3"]

  INJ_4:
    type: "Bosch JPT 2-way"
    subtype: "Injector 4"
    pincount: 2
    pinlabels: ["+12V", "INJ 4"]

  INJ_5:
    type: "Bosch JPT 2-way"
    subtype: "Injector 5"
    pincount: 2
    pinlabels: ["+12V", "INJ 5"]

  INJ_6:
    type: "Bosch JPT 2-way"
    subtype: "Injector 6"
    pincount: 2
    pinlabels: ["+12V", "INJ 6"]

  FUEL_PUMP_RELAY:
    type: "SPDT relay"
    subtype: "Walbro 255LPH pump relay"
    pincount: 4
    pinlabels:
      - "85 Coil - (GPO 2 low-side)"   # 1 — ECU_12PIN[3] sinks to GND when active
      - "86 Coil + (+12V OEM IGN)"     # 2 — +12V from OEM IGN relay; not via ECU connector
      - "87 Pump +12V (contact out)"   # 3
      - "30 Battery+ (fused)"          # 4
    notes: >
      GPO 2 (ECU_12PIN[3]) drives pin 85 as a low-side switch (sinks to GND to energize relay).
      Pin 86 (+12V) supplied by OEM ignition relay via body harness — pre-existing wiring, unchanged.
      Pump draws ~8A; relay contact rated ≥10A. Use ISO mini relay or Bosch 0 332 209 150.
      Flyback diode: 1N4007 across relay coil (cathode to pin 86 / +12V, anode to pin 85 / GPO 2).

  # ── Ignition ─────────────────────────────────────────────────────────────────

  IGN_1:
    type: "VAG 4-way COP"
    subtype: "Coil 1 (BMW S54 COP)"
    pincount: 4
    pinlabels: ["+12V", GND, Signal, Shield]
    notes: "S54 COP uses VAG 4-pin connector. IGN 1 firing order cyl 1."

  IGN_2:
    type: "VAG 4-way COP"
    subtype: "Coil 2"
    pincount: 4
    pinlabels: ["+12V", GND, Signal, Shield]

  IGN_3:
    type: "VAG 4-way COP"
    subtype: "Coil 3"
    pincount: 4
    pinlabels: ["+12V", GND, Signal, Shield]

  IGN_4:
    type: "VAG 4-way COP"
    subtype: "Coil 4"
    pincount: 4
    pinlabels: ["+12V", GND, Signal, Shield]

  IGN_5:
    type: "VAG 4-way COP"
    subtype: "Coil 5"
    pincount: 4
    pinlabels: ["+12V", GND, Signal, Shield]

  IGN_6:
    type: "VAG 4-way COP"
    subtype: "Coil 6"
    pincount: 4
    pinlabels: ["+12V", GND, Signal, Shield]

  # ── Wideband O2 ─────────────────────────────────────────────────────────────

  WIDEBAND:
    type: "Bosch LSU 4.2 6-way"
    subtype: "Wideband lambda sensor"
    pincount: 6
    pinlabels: ["IP", "VS", "APE", "Trim", "Hs+", "Hs-"]
    notes: >
      MaxxECU M50 terminated harness includes built-in wideband controller and LSU 4.2 connector.
      Sensor: Bosch LSU 4.2 (e.g. 0 258 007 057 universal pigtail version).
      Source: maxxecu.com/webhelp/wirings-terminated_engine_harness-bmw_m50.html — "Wideband LSU connector: LSU 4.2".
      Bung: 18mm×1.5 welded in exhaust.
      ⚠️ Phase 3 (07K) uses LSU 4.9 — different pinout. Do NOT substitute sensors between phases.
      At Phase 3, install new LSU 4.9 bung in 07K exhaust header.

  # ── Boost ────────────────────────────────────────────────────────────────────

  BOOST_SOL:
    type: "Superseal 2-way"
    subtype: "GPO 1 access — Rev light relay (Ph1) / Boost solenoid (Ph3)"
    pincount: 2
    pinlabels: ["+12V", "GPO 1 signal"]
    notes: >-
      Phase 1 (M52 NA): connector stub is repurposed as the reverse light relay low-side access point.
      Pin 1 (+12V) to relay coil +12V; Pin 2 (GPO 1) to relay coil GND/signal side.
      No boost solenoid installed in Phase 1 — NA engine. GPO 1 = reverse light trigger.
      Phase 3 (07K turbo): GPO 1 drives boost solenoid. MaxxECU GPO 1 :: PWM duty control.
      Boost solenoid budget alt: Bosch N75 0280142431.
      Flyback diode: 1N4007 at connector, cathode (banded end) to +12V pin, anode to GPO signal pin.

  # ── Cooling ─────────────────────────────────────────────────────────────────

  FAN_RELAY:
    type: "SPDT relay"
    subtype: "SPAL fan relay"
    pincount: 4
    pinlabels:
      - "85 Coil - (GPO 6 low-side)"   # 1 — ECU_16PIN[6] sinks to GND when active
      - "86 Coil + (+12V OEM IGN)"     # 2 — +12V from OEM IGN relay; not via ECU connector
      - "87 Fan +12V (contact out)"    # 3
      - "30 Battery+ (fused)"          # 4
    notes: >
      GPO 6 (ECU_16PIN[6]) drives pin 85 as a low-side switch (sinks to GND to energize relay).
      Pin 86 (+12V) supplied by OEM ignition relay via body harness — pre-existing wiring, unchanged.
      Stage 1: OEM thermostat switch wired to pin 85 in parallel with GPO 6.
      Stage 2 (MaxxECU): GPO 6 triggers relay coil in parallel with thermostat switch.
      Flyback diode: 1N4007 across relay coil (cathode to pin 86 / +12V, anode to pin 85 / GPO 6).
      SPAL upgrade: SPAL 30102049 (16-inch puller, ~2070 CFM, single-speed brushed) wired
      to relay output. Direct GPO PWM of brushed fans needs ~20kHz; use SPAL FAN-PWM-V3
      module or source a SPAL VA-series 3-wire PWM fan for true variable speed via GPO.
      PMU16 build: fan relay replaced by PMU16 O3 direct -- see power-distribution.wv.

  # ── This-build additions ─────────────────────────────────────────────────────

  DCT_SHIFTER:
    type: "DCT Shifter mechanical sequential"
    subtype: "DCT Shifter E36 (3-wire, no +12V supply needed)"
    pincount: 3
    pinlabels: ["UP (Black)", "DOWN (Blue)", "GND (Brown)"]
    notes: >
      Source: dctshifter.com/pages/installation — 3-wire only (no +12V).
      UP (Black) :: MaxxECU DIN 2 (Transmission UP shift).
      DOWN (Blue) :: MaxxECU DIN 1 (Transmission DOWN shift).
      GND (Brown) :: Sensor GND or chassis GND.
      MTune: Advanced :: 8HP :: Shifter type :: 8HP SEQ shifter.
      Hold UP = launch control. Cabin-to-cabin connection; does NOT cross firewall bulkhead.

  FLEX_FUEL:
    type: "Continental 3-pin (GM 13577429)"
    subtype: "Ethanol content / flex fuel sensor — inline on fuel feed"
    pincount: 3
    pinlabels: ["+12V", GND, "Signal (PWM out)"]
    notes: >
      GM 13577429 / Continental SE1004S. Pin A=+12V (system voltage — NOT 5V), Pin B=GND, Pin C=signal.
      Signal is open-collector; ECU provides internal 5V pull-up on DIN input.
      Single wire encodes TWO channels: frequency (50–150 Hz) = ethanol content %; pulse width = fuel temperature.
      MaxxECU reads both natively on DIN 3. MTune: Inputs → Digital inputs → DIN 3 → Function: Flex fuel sensor.
      Enable flex fuel map in MTune: Advanced → Flex fuel — set base (0% E) and E85 (85% E) maps.
      +12V must come from switched 12V relay rail — not ECU 5V supply rail.

  PST_F1:
    type: "Bosch PST-F1 4-pin"
    subtype: "Dual oil temp+pressure sensor"
    pincount: 4
    pinlabels: ["+5V", "GND", "Pressure (0-5V)", "Temp (NTC)"]
    notes: >
      Mount: M52 VANOS banjo bolt (M14x1.5 :: M10x1.0 adapter :: PST-F1).
      Pressure :: AIN 3 (0-5V, 0-10 bar / 0-145 psi).
      Temp :: AIN 1 (NTC, -40 to +140°C).
      Moves to iABED 07K oil housing M10x1.0 port at Phase 3 with no wiring changes.

  CAN_BUS_JUNCTION:
    type: "Splice / junction"
    subtype: "CAN H/L shared bus junction"
    pincount: 4
    pinlabels: ["CAN H in (ECU)", "CAN L in (ECU)", "CAN H out (8HP+GaugeS)", "CAN L out (8HP+GaugeS)"]
    notes: >
      MaxxECU CAN 1 (16-pin pins 9-10) feeds both the 8HP CAN harness and Gauge.S cluster.
      Bus speed: 500kbps. MaxxECU CAN 1 has built-in 120ohm terminator.
      Add 120ohm terminator at far end of bus if bus run over 1 meter total.

  HP8_CAN:
    type: "MaxxECU 8HP GEN1 CAN harness"
    subtype: "ZF 8HP70 transmission CAN connector"
    pincount: 2
    pinlabels: ["CAN H", "CAN L"]
    notes: >
      MaxxECU GEN1 8HP CAN harness ~$368.61.
      See maxxecu.com/store/gearbox/8hp/maxxecu-8hp-gen1-cable-harness.
      Verify hardware ID before purchase: maxxecu.com/webhelp/advanced-8hp-hardware_identifier.html

  GAUGES_CAN:
    type: "Gauge.S cluster CAN"
    subtype: "Gauge.S E36 PNP cluster CAN input"
    pincount: 2
    pinlabels: ["CAN H", "CAN L"]
    notes: >
      Gauge.S receives MaxxECU Default 1.3 CAN output (500kbps).
      Config file: maxxecu.json (see gauge-s-maxxecu repo).
      Enable in MTune: CAN :: Default CAN output :: MaxxECU Default 1.3.

  CHASSIS_GND:
    type: "Ring terminal"
    subtype: "Chassis/battery ground"
    pincount: 1
    pinlabels: [GND]

  BATT_12V:
    type: "Ring terminal"
    subtype: "Battery +12V (fused)"
    pincount: 1
    pinlabels: ["+12V"]

  IGN_12V:
    type: "Ring terminal"
    subtype: "Ignition-switched +12V"
    pincount: 1
    pinlabels: ["+12V IGN"]

  # ── MaxxECU CMC main connector (48-pin Molex CMC) ────────────────────────────
  # Source: maxxecu.com/webhelp/wirings-maxxecu_pinout.html (publicly available)
  # Sequential numbering: A1=1, A2=2, A3=3, A4=4, B1=5 ... M4=48
  ECU_CMC:
    type: "Molex CMC 48-pin (MaxxECU Race / V1 / PRO)"
    subtype: "Source: maxxecu.com/webhelp/wirings-maxxecu_pinout.html"
    pincount: 48
    pinlabels:
      - "A1: GPO 5 (ICV coil B)"          # 1
      - "A2: IGN 1"                        # 2
      - "A3: IGN 2"                        # 3
      - "A4: GPO 8 / TACHO"               # 4
      - "B1: GPO 6 (FAN)"                 # 5
      - "B2: IGN 3"                        # 6
      - "B3: IGN 4"                        # 7
      - "B4: GPO 1 (Rev light relay Ph1 / Boost solenoid Ph3)"  # 8
      - "C1: GPO 7 / DIN3 (Flex fuel)"    # 9
      - "C2: IGN 5"                        # 10
      - "C3: IGN 6"                        # 11
      - "C4: GPO 2 (Fuel pump)"           # 12
      - "D1: WBO2 Heater-"                # 13
      - "D2: IGN 7 (N/A 6-cyl)"          # 14
      - "D3: IGN 8 (N/A 6-cyl)"          # 15
      - "D4: GPO 3 (VANOS)"               # 16
      - "E1: CAN H"                        # 17
      - "E2: CAN L"                        # 18
      - "E3: GND Shield"                  # 19
      - "E4: GPO 4 (ICV coil A)"          # 20
      - "F1: CLT"                          # 21
      - "F2: IAT"                          # 22
      - "F3: WBO2 VREF"                   # 23
      - "F4: WBO2 VS"                     # 24
      - "G1: +5V sensor supply"           # 25
      - "G2: TPS / AIN"                   # 26
      - "G3: WBO2 IP"                     # 27
      - "G4: WBO2 RCAL"                   # 28
      - "H1: Sensor GND"                  # 29
      - "H2: Trigger GND (VR-)"          # 30
      - "H3: TRIGGER (crank VR+)"        # 31
      - "H4: HOME (cam Hall)"             # 32
      - "J1: AIN 1 (temp - PST-F1 temp)" # 33
      - "J2: AIN 2 (temp - spare)"       # 34
      - "J3: AIN 3 (0-5V - PST-F1 pres)" # 35
      - "J4: AIN 4 (0-5V - MAP)"         # 36
      - "K1: INJ 1"                        # 37
      - "K2: INJ 2"                        # 38
      - "K3: DIN / VR 1"                  # 39
      - "K4: DIN / VR 2"                  # 40
      - "L1: INJ 8 (N/A 6-cyl)"          # 41
      - "L2: INJ 7 (N/A 6-cyl)"          # 42
      - "L3: INJ 6"                        # 43
      - "L4: Engine GND"                  # 44
      - "M1: INJ 3"                        # 45
      - "M2: INJ 4"                        # 46
      - "M3: INJ 5"                        # 47
      - "M4: +12V ECU power"              # 48
    notes: >-
      Full 48-pin pinout from maxxecu.com/webhelp/wirings-maxxecu_pinout.html.
      The terminated M50 harness exposes a 12-pin power breakout (ECU_12PIN) and
      16-pin aux breakout (ECU_16PIN) for field connections. Most CMC pins are
      hardwired within the terminated harness; only the breakout connectors are
      accessible in the engine bay.

  # ── MaxxECU C2 (32-pin Molex CMC) — stub for virtual clutch AIN 5 ─────────────
  # Full C2 pinout: maxxecu.com/webhelp/wirings-maxxecu_pinout.html
  # Per MaxxECU RACE REV9+ wiring diagram: AIN 5 = C2 pin G3 (labeled
  # "Extra analog sensor / pedal main position 0-5V").
  # C2 also carries: EGT 1-8, AIN 6-8, DIN 4-5, GPO 15-16, motor H-bridge 1-2.
  # Only AIN 5 (+ its sensor supply / GND) is used in this harness.
  # Purchase: MaxxECU store ID 1982, $32.25. C2 is REQUIRED (not optional).
  ECU_C2:
    type: "Molex CMC 32-pin (MaxxECU Race C2)"
    subtype: "Stub — only AIN 5 (G3) used for virtual clutch position"
    pincount: 3
    pinlabels:
      - "G3: AIN 5 — clutch position signal (0-5V)"
      - "+5V sensor supply (C2 shared rail)"
      - "Sensor GND (C2 shared rail)"
    notes: >
      Confirm pin G3 = AIN 5 from MaxxECU RACE REV9+ wiring diagram before crimping.
      MTune: Analog Inputs → AIN 5 → type = 0-5V, assign function = Clutch Position.
      Calibrate: 0% = pedal fully up, 100% = pedal fully depressed.
      +5V / GND are shared with C1 sensor rail internally — C2 provides its own
      supply breakout pins. Can alternatively tap ECU_16PIN pins 1/2 for +5V/GND
      if C2 harness is not fully assembled (splice to signal wire only).

  # ── Virtual clutch pedal position sensor ─────────────────────────────────────
  CLUTCH_POS_SENSOR:
    type: "Rotary position sensor 0-5V — E36 clutch pedal pivot"
    subtype: "Hall effect or potentiometer; mechanical linkage disconnected at Phase 1"
    pincount: 3
    pinlabels: ["+5V", Signal, GND]
    notes: >
      Mount at clutch pedal pivot. E36 clutch pedal retained in cabin; hydraulic
      pushrod or cable disconnected — pedal freewheels. Add a return spring to
      hold pedal at top of travel when not pressed.
      Sensor options: any 0-5V rotary position sensor matching pedal arc travel
      (e.g., Bosch 0 280 122 001 TPS body repurposed, or dedicated pedal sensor).
      All wiring is cabin-side — no bulkhead crossing required.
      Signal → C2 AIN 5 (C2 pin G3). +5V and GND → C2 sensor supply / GND.


cables:

  # Power feeds
  W_COIL_PWR:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V coils/inj"]
    notes: "Fused 20A. From relay :: 12-pin pin 1."

  W_ECU_PWR:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V ECU"]
    notes: "Fused 20A. From relay :: 12-pin pin 7."

  W_ENGINE_GND:
    wirecount: 1
    colors: [BK]
    wirelabels: ["Engine GND"]
    notes: "Brown wire :: cylinder head ground stud. Do not omit."

  # Sensors
  W_CRANK:
    wirecount: 3
    colors: [WH, BK, GY]
    wirelabels: [Signal+, Signal-, Shield]
    length: 1.2 m

  W_CAM:
    wirecount: 3
    colors: [WH, BK, GY]
    wirelabels: [Signal, "Sensor GND", Shield]
    length: 0.8 m
    notes: "BMW 12141726590 (non-VANOS type) — 3-wire: signal, GND, shield. No +12V supply."

  W_CLT:
    wirecount: 2
    colors: [WH, BK]
    wirelabels: [Signal, GND]
    length: 0.5 m

  W_IAT:
    wirecount: 2
    colors: [WH, BK]
    wirelabels: [Signal, GND]
    length: 0.6 m

  W_TPS:
    wirecount: 3
    colors: [RD, WH, BK]
    wirelabels: ["+5V", Signal, GND]
    length: 0.5 m

  W_VANOS:
    wirecount: 2
    colors: [RD, BK]
    wirelabels: ["+12V", "GPO 3"]
    length: 0.6 m

  # CAN bus
  W_CAN:
    wirecount: 2
    colors: [WH, BU]
    wirelabels: ["CAN H", "CAN L"]
    length: 2.0 m
    notes: "Twisted pair. 120ohm at far end if bus run over 1 m."

  # DCT Shifter — 3-wire only, no +12V (source: dctshifter.com/pages/installation)
  W_SHIFTER:
    wirecount: 3
    colors: [BK, BU, BN]
    wirelabels: ["UP (DIN 2)", "DOWN (DIN 1)", GND]
    length: 1.5 m

  # Flex fuel
  W_FLEXFUEL:
    wirecount: 3
    colors: [RD, BK, WH]
    wirelabels: ["+12V", GND, "Signal (DIN 3)"]
    length: 0.8 m

  # PST-F1
  W_PST_F1:
    wirecount: 4
    colors: [RD, BK, GN, YE]
    wirelabels: ["+5V", GND, "Pressure (AIN 3)", "Temp (AIN 1)"]
    length: 0.6 m

  # M52 Idle air control valve (ICV / stepper)
  # Hardwired inside M50 terminated harness; modeled here for completeness.
  # GPO 4 (E4/CMC 20) = Coil A, GPO 5 (A1/CMC 1) = Coil B.
  W_ICV:
    wirecount: 3
    colors: [BK, WH, GN]
    wirelabels: [GND, "Coil A (GPO 4)", "Coil B (GPO 5)"]
    length: 0.4 m
    notes: "Flyback diode 1N4007 across each coil at ICV connector, cathode toward +12V rail."

  # Injectors (6×2-wire; +12V rail + ECU driver). Inside M50 terminated harness.
  W_INJ_1:
    wirecount: 2
    colors: [RD, GN]
    wirelabels: ["+12V", "INJ 1"]
    length: 0.4 m
  W_INJ_2:
    wirecount: 2
    colors: [RD, GN]
    wirelabels: ["+12V", "INJ 2"]
    length: 0.4 m
  W_INJ_3:
    wirecount: 2
    colors: [RD, GN]
    wirelabels: ["+12V", "INJ 3"]
    length: 0.4 m
  W_INJ_4:
    wirecount: 2
    colors: [RD, GN]
    wirelabels: ["+12V", "INJ 4"]
    length: 0.4 m
  W_INJ_5:
    wirecount: 2
    colors: [RD, GN]
    wirelabels: ["+12V", "INJ 5"]
    length: 0.4 m
  W_INJ_6:
    wirecount: 2
    colors: [RD, GN]
    wirelabels: ["+12V", "INJ 6"]
    length: 0.4 m

  # Ignition coils — S54 COP, VAG 4-pin. Inside M50 terminated harness.
  # +12V from coil/inj relay (ECU_12PIN[1]), GND = L4/CMC44, Signal per cyl, Shield = E3/CMC19.
  W_IGN_1:
    wirecount: 4
    colors: [RD, BK, WH, GY]
    wirelabels: ["+12V", GND, "IGN 1", Shield]
    length: 0.5 m
  W_IGN_2:
    wirecount: 4
    colors: [RD, BK, WH, GY]
    wirelabels: ["+12V", GND, "IGN 2", Shield]
    length: 0.5 m
  W_IGN_3:
    wirecount: 4
    colors: [RD, BK, WH, GY]
    wirelabels: ["+12V", GND, "IGN 3", Shield]
    length: 0.5 m
  W_IGN_4:
    wirecount: 4
    colors: [RD, BK, WH, GY]
    wirelabels: ["+12V", GND, "IGN 4", Shield]
    length: 0.5 m
  W_IGN_5:
    wirecount: 4
    colors: [RD, BK, WH, GY]
    wirelabels: ["+12V", GND, "IGN 5", Shield]
    length: 0.5 m
  W_IGN_6:
    wirecount: 4
    colors: [RD, BK, WH, GY]
    wirelabels: ["+12V", GND, "IGN 6", Shield]
    length: 0.5 m

  # Wideband O2 — LSU 4.2. M50 terminated harness includes built-in WBO2 circuit.
  W_WBO2:
    wirecount: 5
    colors: [WH, WH, WH, WH, BK]
    wirelabels: ["WBO2 VS", "WBO2 VREF", "WBO2 IP", "WBO2 RCAL", "WBO2 Htr-"]
    length: 1.0 m
    shield: true

  W_WBO2_HTR:
    wirecount: 1
    colors: [RD]
    wirelabels: ["WBO2 Hs+ (heater+)"]
    length: 0.3 m
    notes: "Splices to +12V coil/inj rail (ECU_12PIN[1]). Short stub — splice at rail, no ECU termination. Required: without Hs+ the heater circuit is open and the LSU 4.2 throws a heater fault."

  # Boost solenoid
  W_BOOST:
    wirecount: 2
    colors: [RD, BK]
    wirelabels: ["+12V", "GPO 1"]
    length: 0.8 m

  # Fan relay — GPO 6 to coil pin 85 (low-side). Pin 86 +12V comes from OEM body harness.
  W_FAN:
    wirecount: 1
    colors: [GN]
    wirelabels: ["GPO 6 (coil - low-side)"]
    length: 1.0 m

  # Fuel pump relay — GPO 2 to coil pin 85 (low-side). Pin 86 +12V comes from OEM body harness.
  W_FUELPUMP:
    wirecount: 1
    colors: [GN]
    wirelabels: ["GPO 2 (coil - low-side)"]
    length: 0.8 m

  # Virtual clutch position sensor — cabin-side, no bulkhead crossing
  W_CLUTCH_POS:
    wirecount: 3
    colors: [RD, WH, BK]
    wirelabels: ["+5V", "AIN 5 signal", GND]
    length: 0.8 m
    notes: >
      All cabin-side. 22 AWG, no shield required (short run, low-frequency signal).
      +5V and GND route to C2 sensor supply pins (or tap ECU_16PIN pins 1/2).
      Signal routes to C2 pin G3 (AIN 5). Confirm pin ref at crimp time.

  # CAN to 8HP
  W_CAN_8HP:
    wirecount: 2
    colors: [WH, BU]
    wirelabels: ["CAN H", "CAN L"]
    length: 0.3 m

  # CAN to Gauge.S
  W_CAN_GAUGES:
    wirecount: 2
    colors: [WH, BU]
    wirelabels: ["CAN H", "CAN L"]
    length: 0.3 m


connections:

  # ── Power rails ──────────────────────────────────────────────────────────────
  - - BATT_12V: [1]
    - W_COIL_PWR: [1]
    - ECU_12PIN: [1]

  - - IGN_12V: [1]
    - W_ECU_PWR: [1]
    - ECU_12PIN: [7]

  - - CHASSIS_GND: [1]
    - W_ENGINE_GND: [1]
    - ECU_12PIN: [2]

  # ── Crank trigger ────────────────────────────────────────────────────────────
  # CRANK_VR: Signal+=H3(31), VR-=H2(30), Shield=E3(19)
  - - CRANK_VR: [1, 2, 3]
    - W_CRANK: [1, 2, 3]
    - ECU_CMC: [31, 30, 19]

  # ── Cam / HOME trigger ───────────────────────────────────────────────────────
  # CAM_HALL (BMW 12141726590): Signal=H4(32), GND=H1(29), Shield=E3(19)
  # Shield shares E3 drain with crank shield — both terminate at CMC pin 19.
  - - CAM_HALL: [1, 2, 3]
    - W_CAM: [1, 2, 3]
    - ECU_CMC: [32, 29, 19]

  # ── CLT ─────────────────────────────────────────────────────────────────────
  # CLT: Signal=F1(21), GND=H1(29 shared sensor GND)
  - - CLT: [1, 2]
    - W_CLT: [1, 2]
    - ECU_CMC: [21, 29]

  # ── IAT ─────────────────────────────────────────────────────────────────────
  # IAT: Signal=F2(22), GND=H1(29 shared sensor GND)
  - - IAT: [1, 2]
    - W_IAT: [1, 2]
    - ECU_CMC: [22, 29]

  # ── TPS ─────────────────────────────────────────────────────────────────────
  # TPS: +5V=G1(25), Signal=G2(26), GND=H1(29 shared sensor GND)
  - - TPS: [1, 2, 3]
    - W_TPS: [1, 2, 3]
    - ECU_CMC: [25, 26, 29]

  # ── VANOS solenoid ───────────────────────────────────────────────────────────
  # +12V from coil/inj relay (ECU_12PIN[1]) — NOT ECU_16PIN[1] (+5V OUT).
  - - VANOS_SOL: [1]
    - W_VANOS: [1]
    - ECU_12PIN: [1]

  - - VANOS_SOL: [2]
    - W_VANOS: [2]
    - ECU_16PIN: [7]

  # ── CAN bus (shared: 8HP + Gauge.S) ─────────────────────────────────────────
  - - ECU_16PIN: [10, 9]
    - W_CAN: [1, 2]
    - CAN_BUS_JUNCTION: [1, 2]

  - - CAN_BUS_JUNCTION: [3, 4]
    - W_CAN_8HP: [1, 2]
    - HP8_CAN: [1, 2]

  - - CAN_BUS_JUNCTION: [3, 4]
    - W_CAN_GAUGES: [1, 2]
    - GAUGES_CAN: [1, 2]

  # ── DCT Shifter — 3-wire (UP/DOWN/GND), cabin-to-cabin, no bulkhead crossing ──
  # UP(BK)=DIN2=ECU_16PIN[15], DOWN(BU)=DIN1=ECU_16PIN[16], GND=ECU_16PIN[2]
  - - DCT_SHIFTER: [1, 2, 3]
    - W_SHIFTER: [1, 2, 3]
    - ECU_16PIN: [15, 16, 2]

  # ── Flex fuel sensor ─────────────────────────────────────────────────────────
  # Pin A (+12V) → coil/inj switched 12V rail (ECU_12PIN[1], 20A fused).
  # ⚠️ NOT ECU_16PIN[1] — that is +5V OUT; Continental 13577429 needs system 12V.
  # Pin B (GND) → Sensor GND (ECU_16PIN[2]).
  # Pin C (Signal) → DIN 3 / GPO 7 (ECU_16PIN[5]). ECU provides internal 5V pull-up.
  - - FLEX_FUEL: [1]
    - W_FLEXFUEL: [1]
    - ECU_12PIN: [1]

  - - FLEX_FUEL: [2, 3]
    - W_FLEXFUEL: [2, 3]
    - ECU_16PIN: [2, 5]

  # ── PST-F1 oil sensor ────────────────────────────────────────────────────────
  - - PST_F1: [1, 2, 3, 4]
    - W_PST_F1: [1, 2, 3, 4]
    - ECU_16PIN: [1, 2, 12, 14]

  # ── Boost solenoid ───────────────────────────────────────────────────────────
  # +12V comes from engine harness coil/inj rail (ECU_12PIN[1]), not ECU_CMC.
  # GPO1=B4=CMC pin 8.
  - - ECU_12PIN: [1]
    - W_BOOST: [1]
    - BOOST_SOL: [1]
  - - BOOST_SOL: [2]
    - W_BOOST: [2]
    - ECU_CMC: [8]

  # ── Fan relay trigger ─────────────────────────────────────────────────────────
  # GPO 6 drives coil pin 85 (low-side switch to GND). Pin 86 (+12V) from OEM body harness.
  - - FAN_RELAY: [1]
    - W_FAN: [1]
    - ECU_16PIN: [6]

  # ── Fuel pump relay trigger ───────────────────────────────────────────────────
  # GPO 2 drives coil pin 85 (low-side switch to GND). Pin 86 (+12V) from OEM body harness.
  - - FUEL_PUMP_RELAY: [1]
    - W_FUELPUMP: [1]
    - ECU_12PIN: [3]

  # ── Virtual clutch position sensor (cabin-side, no bulkhead crossing) ─────────
  # +5V=ECU_C2[2], Signal=ECU_C2[1] (AIN 5 / C2 pin G3), GND=ECU_C2[3]
  - - CLUTCH_POS_SENSOR: [1, 2, 3]
    - W_CLUTCH_POS: [1, 2, 3]
    - ECU_C2: [2, 1, 3]

  # ── M52 Idle air control valve (ICV) ─────────────────────────────────────────
  # GND=H1/CMC29, Coil A=E4 GPO4/CMC20, Coil B=A1 GPO5/CMC1
  - - IDLE_VALVE: [1, 2, 3]
    - W_ICV: [1, 2, 3]
    - ECU_CMC: [29, 20, 1]

  # ── Injectors (M52 inline-6, EV1 Bosch JPT) ──────────────────────────────────
  # +12V from coil/inj relay (ECU_12PIN[1]) — NOT ECU_CMC[48] (ECU logic power).
  # INJ1=K1/CMC37, INJ2=K2/CMC38, INJ3=M1/CMC45, INJ4=M2/CMC46, INJ5=M3/CMC47, INJ6=L3/CMC43
  - - INJ_1: [1]
    - W_INJ_1: [1]
    - ECU_12PIN: [1]

  - - INJ_1: [2]
    - W_INJ_1: [2]
    - ECU_CMC: [37]

  - - INJ_2: [1]
    - W_INJ_2: [1]
    - ECU_12PIN: [1]

  - - INJ_2: [2]
    - W_INJ_2: [2]
    - ECU_CMC: [38]

  - - INJ_3: [1]
    - W_INJ_3: [1]
    - ECU_12PIN: [1]

  - - INJ_3: [2]
    - W_INJ_3: [2]
    - ECU_CMC: [45]

  - - INJ_4: [1]
    - W_INJ_4: [1]
    - ECU_12PIN: [1]

  - - INJ_4: [2]
    - W_INJ_4: [2]
    - ECU_CMC: [46]

  - - INJ_5: [1]
    - W_INJ_5: [1]
    - ECU_12PIN: [1]

  - - INJ_5: [2]
    - W_INJ_5: [2]
    - ECU_CMC: [47]

  - - INJ_6: [1]
    - W_INJ_6: [1]
    - ECU_12PIN: [1]

  - - INJ_6: [2]
    - W_INJ_6: [2]
    - ECU_CMC: [43]

  # ── Ignition coils (S54 COP, VAG 4-pin) ──────────────────────────────────────
  # +12V from coil/inj relay (ECU_12PIN[1]) — NOT ECU_CMC[48] (ECU logic power).
  # GND=L4/CMC44, Shield=E3/CMC19
  # IGN1=A2/CMC2, IGN2=A3/CMC3, IGN3=B2/CMC6, IGN4=B3/CMC7, IGN5=C2/CMC10, IGN6=C3/CMC11
  - - IGN_1: [1]
    - W_IGN_1: [1]
    - ECU_12PIN: [1]

  - - IGN_1: [2, 3, 4]
    - W_IGN_1: [2, 3, 4]
    - ECU_CMC: [44, 2, 19]

  - - IGN_2: [1]
    - W_IGN_2: [1]
    - ECU_12PIN: [1]

  - - IGN_2: [2, 3, 4]
    - W_IGN_2: [2, 3, 4]
    - ECU_CMC: [44, 3, 19]

  - - IGN_3: [1]
    - W_IGN_3: [1]
    - ECU_12PIN: [1]

  - - IGN_3: [2, 3, 4]
    - W_IGN_3: [2, 3, 4]
    - ECU_CMC: [44, 6, 19]

  - - IGN_4: [1]
    - W_IGN_4: [1]
    - ECU_12PIN: [1]

  - - IGN_4: [2, 3, 4]
    - W_IGN_4: [2, 3, 4]
    - ECU_CMC: [44, 7, 19]

  - - IGN_5: [1]
    - W_IGN_5: [1]
    - ECU_12PIN: [1]

  - - IGN_5: [2, 3, 4]
    - W_IGN_5: [2, 3, 4]
    - ECU_CMC: [44, 10, 19]

  - - IGN_6: [1]
    - W_IGN_6: [1]
    - ECU_12PIN: [1]

  - - IGN_6: [2, 3, 4]
    - W_IGN_6: [2, 3, 4]
    - ECU_CMC: [44, 11, 19]

  # ── Wideband O2 (LSU 4.2) ────────────────────────────────────────────────────
  # VS=F4/CMC24, VREF=F3/CMC23, IP=G3/CMC27, RCAL=G4/CMC28, Htr-=D1/CMC13
  # Pin mapping (matches maxxecu-07k.wv — "same wiring as M52"):
  #   W_WBO2[1]=VS   → WIDEBAND[2](VS)    → ECU_CMC[24](F4)
  #   W_WBO2[2]=VREF → WIDEBAND[3](APE)   → ECU_CMC[23](F3)
  #   W_WBO2[3]=IP   → WIDEBAND[1](IP)    → ECU_CMC[27](G3)
  #   W_WBO2[4]=RCAL → WIDEBAND[4](Trim)  → ECU_CMC[28](G4)
  #   W_WBO2[5]=Htr- → WIDEBAND[6](Hs-)   → ECU_CMC[13](D1)
  #   W_WBO2_HTR[1]=Hs+ → WIDEBAND[5](Hs+) → ECU_12PIN[1] (+12V splice)
  - - WIDEBAND: [2, 3, 1, 4, 6]
    - W_WBO2: [1, 2, 3, 4, 5]
    - ECU_CMC: [24, 23, 27, 28, 13]

  # WBO2 heater positive: WIDEBAND pin 5 (Hs+) → splice to +12V coil/inj rail
  - - WIDEBAND: [5]
    - W_WBO2_HTR: [1]
    - ECU_12PIN: [1]
