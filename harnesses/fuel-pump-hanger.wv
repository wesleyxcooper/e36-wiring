metadata:
  project: E36 Restomod -- Radium 20-1170 Fuel Pump Hanger Wiring
  description: >-
    Radium Engineering 20-1170 fuel pump hanger + Walbro F90000267 (465 LPH E85)
    powered directly by Ecumaster PMU16 output O4 (25A, PWM-capable).
    O4 runs 12 AWG from PMU16 engine bay location through tunnel to hanger pump(+) stud.
    MaxxECU commands pump speed via CAN to PMU16 -- no external SSR needed.
    PWM: MTune Outputs → PWM fuel pump control, duty table by MAP/RPM.
    Phase 1 install -- carries through 07K Phase 3 with no re-work.
    Cross-reference power-distribution.wv (RADIUM_HANGER_STUB / W_PMU16_O4_PUMP) and
    fuel-pump-hanger-reference.md for full specs and MTune config.
    Install PDF: radiumauto.com/pages/instructions (20-1170).

# ── TODO list ──────────────────────────────────────────────────────────────────
#
#   [ ] Verify F90000267 fits chosen Radium hanger slot -- 39mm/50mm DCSS body confirmed
#   [ ] Confirm PMU16 O4 physical run length (engine bay → fuel tank hanger, est. 3.5-4m)
#       Add 20% slack per BOM conventions; pre-terminate before routing through tunnel
#   [ ] Confirm MaxxECU MTune PWM fuel pump output function mapped to O4 via CAN
#       MTune: Outputs -> Output config -> Function: PWM fuel pump control
#       PMU16 O4 frequency: set in PMU software (4-400 Hz). Recommend 100 Hz start.
#       Duty table by MAP/RPM: 65% idle / 80% cruise / 100% WOT/boost
#   [ ] Thread 20-1000-1010 swivel fitting (10AN ORB) into pump-out port HAND-TIGHT
#       then attach -10AN braided line before final torque -- allows rotation to route
#   [ ] Return port: use included 8.5mm barb adapter (OEM return line)
#       OR add 20-1000-0606 (6AN ORB swivel) if converting to full AN return
#   [ ] Dedicate chassis GND stud for pump(-) -- do not share with ECU sensor grounds

# ── Connectors ─────────────────────────────────────────────────────────────────

connectors:

  PMU16_O4_STUB:
    type: "PMU16 O4 output stub (engine bay)"
    subtype: "25A PWM-capable high-side MOSFET output"
    pincount: 1
    pinlabels: ["O4 PWM +12V (pin 13, 25A)"]
    notes: >-
      Stub connector in engine bay where PMU16 O4 wire begins its run to the
      fuel pump hanger in the rear. PMU16 O4 (PHYS pin 13) is 25A with PWM
      capability (4-400 Hz). MaxxECU commands speed via CAN -- O4 sources current
      directly from PMU16 BATT+ stud (ANL fused). No separate BATT+ fuse needed
      on this harness -- PMU16 output has integrated overcurrent protection.
      Cross-reference: power-distribution.wv RADIUM_HANGER_STUB / W_PMU16_O4_PUMP.

  RADIUM_HANGER:
    type: "Radium Engineering 20-1170 -- stainless stud electrical terminals"
    subtype: "Top-plate external studs -- anti-rotation, hermetically sealed"
    pincount: 2
    pinlabels:
      - "Pump(+) -- PMU16 O4 PWM +12V"
      - "Pump(-) -- chassis GND"
    notes: >-
      Radium 20-1170 uses custom stainless steel studs through the top plate (not a
      multi-pin connector). External connection via ring terminals + anodized acorn nuts.
      Anti-rotation feature prevents stud from spinning during install.
      Hermetically sealed and impervious to E85, gasoline, methanol.
      Ring terminals: 12 AWG crimp ring, M4 or M5 stud diameter (confirm at install).
      In-tank wiring insulated with ETFE -- chemically resistant to all fuel types.
      Single pump install (F90000267): run 12 AWG directly from PMU16 O4 to pump(+) stud.
      Hanger: https://www.radiumauto.com/products/bmw-e36-fuel-pump-hanger
      Pump: https://www.walbrofuelpumps.com/product/f90000267/

  CHASSIS_GND:
    type: "Chassis ground stud (body metal)"
    pincount: 1
    pinlabels: ["GND"]
    notes: >-
      Dedicated ground for pump(-) terminal on Radium hanger.
      Do not share with ECU sensor grounds or other high-current grounds.
      12 AWG minimum. Ring terminal, solid bolt to body metal.
      Separate stud from any signal ground star-point.

# ── Cables ─────────────────────────────────────────────────────────────────────

cables:

  CABLE_PWR:
    gauge: "12 AWG"
    length: "4.0 m"
    colors: [RD]
    wirecount: 1
    notes: >-
      PMU16 O4 output (engine bay) to Radium hanger pump(+) stud (fuel tank).
      12 AWG minimum (14.1A max pump draw; PMU16 O4 25A overcurrent protection).
      Route through transmission tunnel. Keep clear of exhaust where tunnel-side
      routing is close to heat. Loom in expandable braid for this full run.
      Estimated run: 3.5-4m -- measure on car, add 20% slack before cutting.

  CABLE_GND:
    gauge: "12 AWG"
    length: "0.5 m"
    colors: [BK]
    wirecount: 1
    notes: >-
      Radium hanger pump(-) stud to chassis ground stud.
      12 AWG minimum. Dedicated ground -- do not share with ECU sensor ground bus.
      Ring terminal at both ends.

# ── Connections ────────────────────────────────────────────────────────────────

connections:
  # PMU16 O4 (engine bay) -> pump(+) stud on Radium hanger (rear)
  -
    - PMU16_O4_STUB: [1]
    - CABLE_PWR: [1]
    - RADIUM_HANGER: [1]
  # pump(-) stud -> chassis GND
  -
    - RADIUM_HANGER: [2]
    - CABLE_GND: [1]
    - CHASSIS_GND: [1]
