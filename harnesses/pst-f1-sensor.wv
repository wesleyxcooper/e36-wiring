# pst-f1-sensor.wv
# Bosch PST-F1 dual oil temp+pressure sensor → MaxxECU AIN
#
# Scope: This file documents the PST-F1 sensor pigtail (the 4-wire cable between the
# sensor body and its terminus at MaxxECU). The pigtail IS built by the user (Bosch
# F02U.B00.751-01 mating kit + 4 wires). The ECU-side terminus differs by phase:
#
#   Phase 1 (M52 + M50 pre-terminated harness):
#     Pigtail terminates at the M50 harness 16-pin AUX BREAKOUT pins 1/2/12/14
#     (+5V/SGND/AIN3/AIN1). The breakout comes pre-terminated with the purchased
#     harness — no build work on that end, just plug in.
#     Ref: docs/vendor/maxxecu/MaxxECU_M50_Terminated_Harness.md § 16-pin extra connector.
#     ECU_16PIN block below documents the breakout for reference (it's a purchase, not a build).
#
#   Phase 3 (07K custom harness):
#     Pigtail integrates into the custom 07K engine-side harness and terminates
#     directly at MaxxECU CMC pins G1 (+5V, pin 25) / H1 (SGND, pin 29) / J3 (AIN 3
#     pressure, pin 37) / J1 (AIN 1 temp, pin 33). See harnesses/maxxecu-07k.wv.
#
# Under the H2O engine-bay-mount architecture the sensor and the MaxxECU are BOTH
# in the engine bay in either phase — no firewall crossing for these 4 wires.
# See docs/vendor/maxxecu/MaxxECU_RACE_H2O.md.
#
# Mount: M52 VANOS banjo bolt path (M14x1.5 → M10x1.0 adapter → PST-F1).
# Phase 3: moves to iABED 07K oil housing M10x1.0 port — no wiring changes needed.
#
# MaxxECU channels:
#   Pressure: AIN 3 (0-5V, calibrate 0-10 bar / 0-145 psi)
#   Temp:     AIN 1 (NTC, calibrate -40 to +140 C)

connectors:

  PST_F1:
    type: "Bosch PST-F1 5-pin Bosch Trapezoid"
    subtype: "Dual oil temp + pressure sensor"
    pincount: 5
    pinlabels: ["—", "Pressure Signal", "+5V", GND, "Temp Signal (NTC)"]
    notes: >
      Bosch PST-F1 (order# 0261.544.01F / OEM equiv 0281006414). 5-pin Bosch Trapezoid connector.
      Pin 1 = NC (empty in housing). Active pins: 2=Pressure, 3=+5V, 4=GND, 5=Temp.
      Mating connector kit: Bosch F02U.B00.751-01 (housing 1928405159, 5-pin Trapez).
      ⚠️ NOT a 4-pin connector — ordering a 4-pin body will mismatch the sensor physically.
      Source: Bosch Motorsport datasheet bosch-motorsport.com PST-F 1 (Pin 2=Pressure Signal,
      Pin 3=Power Supply, Pin 4=Ground, Pin 5=Temperature Signal). Confirmed xtramotorsport.com.
      Pressure output: 0.5V = 0 bar, 4.5V = 10 bar (ratiometric, 5V supply).
      Temp output: NTC — calibrate in MTune against resistance table.
      Mount adapter: M14x1.5 female → M10x1.0 male.
      Phase 3: moves to 07K iABED oil housing (M10x1.0 port) unchanged.

  ECU_16PIN:
    type: "MaxxECU M50 terminated harness — 16-pin aux breakout"
    subtype: "REV2. Source: maxxecu.com/webhelp/wirings-terminated_engine_harness-bmw_m50.html"
    pincount: 16
    pinlabels:
      - "+5V OUT"         # 1
      - "Sensor GND"      # 2
      - "INJ 7 (N/A M52)" # 3
      - "GPO 8 / TACHO"   # 4
      - "GPO 7 / DIN 3"   # 5
      - "GPO 6"           # 6
      - "GPO 3"           # 7
      - "GPO 2"           # 8
      - "CAN L"           # 9
      - "CAN H"           # 10
      - "AIN 4"           # 11
      - "AIN 3"           # 12
      - "AIN 2"           # 13
      - "AIN 1"           # 14
      - "DIN 2"           # 15
      - "DIN 1"           # 16

cables:

  W_PST_F1:
    wirecount: 4
    colors: [BN, RD, WH, WH]
    wirelabels: ["Sensor GND", "+5V", "Pressure (AIN 3)", "Temp (AIN 1)"]
    length: 1.0 m
    notes: >-
      Engine-bay run from PST-F1 sensor to M50 harness 16-pin aux breakout (both engine-bay
      side under the H2O arch — no firewall crossing). Keep away from ignition/coil wires.

connections:

  # PST-F1 sensor → M50 harness 16-pin aux breakout (both engine-bay, direct run)
  # PST_F1 pin 1 = NC (skip). Active: pin3=+5V, pin4=GND, pin2=Pressure, pin5=Temp.
  # ECU_16PIN: pin 1=+5V, pin 2=SensorGND, pin 12=AIN3 (Pressure), pin 14=AIN1 (Temp).
  - - PST_F1: [3, 4, 2, 5]
    - W_PST_F1: [2, 1, 3, 4]
    - ECU_16PIN: [1, 2, 12, 14]
