# 8hp-body-integrations-phase1.wv
# ZF 8HP → E36 body harness integration — PHASE 1 (M52 + M50 pre-terminated harness era)
#
# Under the H2O engine-bay-mount architecture:
#   - MaxxECU RACE H2O: engine bay (OEM DME E-box cavity, intake side of RHD car)
#   - MaxxECU M50 pre-terminated engine harness: plugs into H2O CMC. Available
#     cabin-side breakouts include BOOST_SOLENOID Superseal 2-pin (unpopulated in
#     Phase 1 NA — hosts a spare GPO 1 signal)
#   - PMU16: engine bay, alongside the H2O
#   - Discrete reverse-light relay: engine bay (Bosch mini relay, near the OEM
#     Front Power Distribution Box or in an added relay panel next to the PMU16)
#
# Phase-transition note: at Phase 3 (07K swap), the M50 pre-terminated harness is
# retired and replaced with a custom 07K harness. The Phase 1 approach here (GPO
# via BOOST_SOLENOID Superseal stub) no longer applies — see the Phase 3 file
# harnesses/8hp-body-integrations-phase3.wv for the PMU16-direct-drive design.
#
# See harnesses/body-x20.wv (X20 pin 10 documentation) and
#     docs/vendor/maxxecu/MaxxECU_RACE_H2O.md (ECU mounting).
#
# Covers two 8HP-specific signals that would previously have been handled
# by the Getrag ZF S5-31 or ZF S5-D manual gearbox:
#
#   1. Reverse lights  — Getrag had a mechanical switch on the gearbox.
#                        8HP has no mechanical switch.
#                        MaxxECU GPO 1 ("Transmission Reverse", low-side) → engine-bay
#                        discrete relay coil → relay contact → X20 pin 10 → OEM cabin
#                        body harness → reverse lights.
#
#   2. Starter inhibit — Getrag had no neutral safety switch (clutch switch
#                        handled start inhibit for OEM cars).
#                        8HP: configure MTune → Starter control → inhibit crank
#                        in all gears except P and N. No relay or hardware needed
#                        if MaxxECU is in the starter circuit. UNCHANGED between phases.
#
# PMU16 note (Phase 1): the reverse-light relay coil is driven by the MaxxECU GPO 1
# signal directly — NOT by a PMU16 output. The M50 pre-terminated harness exposes
# GPO 1 at the BOOST_SOLENOID Superseal 2-pin connector, which is unused on an NA
# M52. We tap that connector for the GPO wire. This is Phase 1's constraint —
# under Phase 3's custom harness (see phase 3 file) PMU16 direct-drive replaces
# this whole scheme.
#
# Source (X20 pinout): harnesses/body-x20.wv + 1998 BMW E36 ETM jonkensy.com
# Source (reverse light switch path): BMW E36 ETM wiring diagram, section 0670
# Source (MaxxECU GPO Transmission Reverse function): maxxecu.com/webhelp/settings-outputs.html
#
# ─────────────────────────────────────────────────────────────────────────────
# GPO assignment — Phase 1 (M52 + 8HP):
#
#   ⚠️ All 8 C1 GPOs are allocated in the M52 terminated harness.
#   GPO 1 (CMC B4 / boost solenoid connector) is the recommended choice:
#     - The boost solenoid connector is NOT populated on NA M52 (no turbo in Phase 1).
#     - GPO 1 is physically accessible at the BOOST_SOLENOID Superseal 2-pin connector
#       (signal is pin 2 of that connector).
#     - Splice a new wire from BOOST_SOLENOID pin 2 (GPO 1 signal) to REV_RELAY pin 85.
#     - Configure MTune: Outputs → GPO 1 → Function: "Transmission Reverse".
#
# ─────────────────────────────────────────────────────────────────────────────
# Starter inhibit — software-only, no diagram needed:
#
#   MTune: Advanced → Starter control → Starter inhibit:
#     - Inhibit crank when gear ≠ P and gear ≠ N.
#   Requires MaxxECU to be in the starter crank circuit (i.e., starter relay coil
#   triggered through MaxxECU GPO or through a relay MaxxECU controls).
#   If the stock E36 start circuit bypasses MaxxECU (starter relay coil wired
#   directly to X20 pin 18 without MaxxECU in the path), add a MaxxECU-controlled
#   relay in series with the starter relay coil. No PMU16 change needed.
#
# ─────────────────────────────────────────────────────────────────────────────

connectors:

  # ── MaxxECU GPO output ───────────────────────────────────────────────────────
  MAXXECU_GPO_REV:
    type: "MaxxECU M50 terminated harness — BOOST_SOLENOID connector"
    subtype: "GPO 1 (CMC B4) — Phase 1 approach only. Phase 3 uses PMU16 direct."
    pincount: 1
    pinlabels: ["GPO 1 signal (low-side switch to GND)"]
    notes: >
      MaxxECU GPO sinks to GND when active (low-side switch). Does NOT supply +12V.
      MTune config: Outputs → GPO 1 → Function: "Transmission Reverse".
      Access: pin 2 of the Superseal 2-pin BOOST_SOLENOID breakout connector in the
      MaxxECU M50 terminated harness. Boost solenoid connector is unpopulated in
      M52 NA Phase 1. Leave connector unpopulated and splice from this wire.
      Phase 3: this connector no longer exists (custom 07K harness). See
      harnesses/8hp-body-integrations-phase3.wv for the PMU16-direct-drive replacement.

  # ── Reverse light relay ──────────────────────────────────────────────────────
  REV_RELAY:
    type: "ISO mini relay (SPDT)"
    subtype: "Bosch 0 332 209 150 or equivalent — 12V coil, ≥10A contact"
    pincount: 4
    pinlabels:
      - "85 Coil - (GPO low-side)"   # 1 — GPO sinks to GND when in reverse
      - "86 Coil + (+12V OEM IGN)"   # 2 — +12V from OEM IGN relay; body harness
      - "87 Contact out → X20"       # 3 — switched +12V to reverse light circuit
      - "30 Battery+ (fused 15A)"    # 4 — fused +12V in, relay contact supply
    notes: >
      Flyback diode required: 1N4007 across relay coil.
        Cathode (banded end) → pin 86 / +12V.
        Anode → pin 85 / GPO.
      Prevents GPO output damage from coil back-EMF at relay de-energization.
      Mount relay in engine bay near the OEM Front Power Distribution Box or
      alongside the PMU16 (either physical location works). Engine-bay-side only.
      Coil draws ~150 mA — well within MaxxECU GPO output spec.

  # ── X20 reverse light input ──────────────────────────────────────────────────
  X20_REV:
    type: "BMW E36 X20 engine-side — pin 10 only"
    subtype: "Non-EGS reverse light switch input (BL/GE)"
    pincount: 1
    pinlabels: ["Pin 10 — Reverse Light Switch no-EGS (BL/GE)"]
    notes: >
      This is the correct pin for an E36 that started life as a MANUAL gearbox
      (ZF S5-31 / ZF S5-D). Manual cars have no EGS module — the reverse light
      circuit runs through X20 pin 10, not pin 22 (EGS path).
      X20 pin 22 (GN/WS) is the EGS automatic-gearbox path — leave floating.
      OEM wiring: X20 pin 10 → body harness → both reverse light bulbs (in tail lights).
      No body harness modification needed — relay output replaces the OEM mechanical switch.
      Source: harnesses/body-x20.wv pin 10; BMW E36 ETM section 0670 (jonkensy.com).

  # ── Power supply references ──────────────────────────────────────────────────
  FUSED_12V:
    type: "Fused +12V — 15A mini blade fuse"
    subtype: "Relay contact supply (pin 30) — battery or main fuse block"
    pincount: 1
    pinlabels: ["+12V fused (15A)"]
    notes: >
      Supply for relay contact pin 30 — independent of the coil supply.
      Source from main fuse block battery rail (PMU16 is not yet installed in Phase 1;
      Phase 3 uses PMU16 direct so no separate fuse needed there).
      15A fuse is sufficient — reverse light bulbs draw ~4–8A total on E36.

  IGN_12V_BODY:
    type: "OEM ignition relay — body harness switched +12V"
    subtype: "Relay coil supply (pin 86)"
    pincount: 1
    pinlabels: ["+12V IGN (body harness)"]
    notes: >
      Same OEM IGN relay rail used by fan relay and fuel pump relay coils.
      No additional relay or PMU16 output needed for the coil supply.
      Coil draws ~150 mA at 12V — negligible load on OEM ignition relay.


cables:

  W_GPO_REV:
    wirecount: 1
    colors: [GN]
    wirelabels: ["GPO 1 (coil - low-side)"]
    length: 0.8 m
    notes: >
      From BOOST_SOLENOID connector pin 2 (GPO 1) to relay pin 85.
      18 AWG sufficient — carries only coil current (~150 mA).
      Engine-bay-only run.

  W_REV_COIL_PWR:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V IGN (coil +)"]
    length: 0.3 m
    notes: "OEM IGN relay +12V to relay pin 86. 18 AWG. Engine-bay-only run."

  W_REV_CONTACT_PWR:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V fused (contact supply)"]
    length: 0.3 m
    notes: "Fused +12V to relay pin 30 (contact input). 16 AWG. Engine-bay-only run."

  W_REV_OUTPUT:
    wirecount: 1
    colors: [BU]
    wirelabels: ["Reverse light switched +12V"]
    length: 0.8 m
    notes: >
      From relay pin 87 to X20 engine-side pin 10 (BL/GE).
      Replace the OEM connection at X20 pin 10 that previously received
      the mechanical gearbox reverse switch +12V.
      16 AWG (matches OEM wire gauge). Engine-bay-only run — X20 pin 10
      cabin side is unmodified OEM.


connections:

  # ── Relay coil circuit ───────────────────────────────────────────────────────
  # MaxxECU GPO sinks pin 85 to GND when "Transmission Reverse" is active.
  # Pin 86 (+12V) is the fixed coil supply from OEM IGN relay.
  - - MAXXECU_GPO_REV: [1]
    - W_GPO_REV: [1]
    - REV_RELAY: [1]          # pin 85 — low-side

  - - IGN_12V_BODY: [1]
    - W_REV_COIL_PWR: [1]
    - REV_RELAY: [2]          # pin 86 — coil +

  # ── Relay contact circuit ────────────────────────────────────────────────────
  # Fused +12V → relay contact in (pin 30) → relay contact out (pin 87) → X20.
  - - FUSED_12V: [1]
    - W_REV_CONTACT_PWR: [1]
    - REV_RELAY: [4]          # pin 30 — contact in

  - - REV_RELAY: [3]          # pin 87 — contact out
    - W_REV_OUTPUT: [1]
    - X20_REV: [1]            # X20 pin 10 → body harness → reverse lights
