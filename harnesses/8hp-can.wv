# 8hp-can.wv
# MaxxECU RACE H2O <-> ZF 8HP70 TCU CAN + power wiring
# Source: maxxecu.com/webhelp/advanced-8hp-wiring_information.html
#
# ⚠️ SCOPE: REFERENCE ONLY — NOT A BUILD FILE
# The MaxxECU 8HP GEN1 CAN harness is a pre-made plug-and-play kit
# (SKU: maxxecu.com/store/gearbox/8hp/maxxecu-8hp-gen1-cable-harness, ~$368 USD).
# This file documents how the kit's terminated ends connect to the surrounding
# components for troubleshooting / MTune configuration / phase-transition planning.
# The user does NOT build these wires. Order the harness kit, plug it in.
#
# Under the H2O engine-bay-mount architecture:
#   - MaxxECU RACE H2O: engine bay (OEM DME E-box cavity, intake side)
#   - 8HP TCU: engine bay (mounted on/near the transmission)
#   - PMU16: engine bay (intake side, alongside the H2O — see power-distribution.wv)
# ALL 8HP wiring is engine-bay-to-engine-bay — no firewall crossing.
#
# Phase 1B (8HP swap) install; unchanged through all subsequent phases.
#
# CRITICAL POWER SEQUENCING (MaxxECU docs):
#   KL30 main power (TCU pin 13) MUST be live >= 10-15 s before KL15 wakeup
#   (TCU pin 9) is asserted. Powerhold via PMU16 output ensures constant KL30
#   from first key-on; separate PMU16 output for KL15 IGN-switched.
#   Failure to observe sequencing prevents TCU initialization.
#
# CAN bus: 500 kbps. MaxxECU CAN 1 provides built-in 120Ω terminator (at ECU).
# Add 120Ω at 8HP TCU CAN pins (transmission end) — included in the MaxxECU
# 8HP GEN1 harness kit.
#
# MaxxECU 8HP GEN1 CAN harness (pre-made): maxxecu.com/store/gearbox/8hp/maxxecu-8hp-gen1-cable-harness
# Verify hardware ID before purchase: maxxecu.com/webhelp/advanced-8hp-hardware_identifier.html

connectors:

  ECU_16PIN:
    type: "MaxxECU M50 terminated harness — 16-pin aux breakout"
    subtype: "REV2. Source: maxxecu.com/webhelp/wirings-terminated_engine_harness-bmw_m50.html"
    pincount: 16
    pinlabels:
      - "+5V OUT"         # 1
      - "Sensor GND"      # 2
      - "INJ 7 (N/A M52)" # 3
      - "GPO 8 / TACHO"   # 4
      - "GPO 7 / DIN 3"   # 5
      - "GPO 6"           # 6
      - "GPO 3"           # 7
      - "GPO 2"           # 8
      - "CAN L"           # 9
      - "CAN H"           # 10
      - "AIN 4"           # 11
      - "AIN 3"           # 12
      - "AIN 2"           # 13
      - "AIN 1"           # 14
      - "DIN 2"           # 15
      - "DIN 1"           # 16
    notes: "CAN H/L (pins 10/9) shared with Gauge.S — see CAN_BUS_JUNCTION in maxxecu-m52.wv."

  PMU16_MAIN:
    type: "PMU16 high-side output — KL30 (constant +12V)"
    subtype: "Engine-bay PMU16 output configured for constant +12V. See power-distribution.wv."
    pincount: 1
    pinlabels: ["+12V CONST (KL30)"]
    notes: "Must remain live from first key-on. Do NOT wire through any cut-off switch."

  PMU16_IGN:
    type: "PMU16 high-side output — KL15 (IGN-switched +12V)"
    subtype: "Engine-bay PMU16 output configured for IGN-switched +12V."
    pincount: 1
    pinlabels: ["+12V IGN (KL15)"]

  ENG_GND:
    type: "Ring terminal"
    subtype: "Engine-bay chassis GND star point (near ECU mount)"
    pincount: 1
    pinlabels: [GND]

  HP8_TCU:
    type: "ZF 8HP70 TCU connector — relevant pins"
    subtype: "Full connector is multi-pin ZF proprietary. MaxxECU 8HP GEN1 harness required."
    pincount: 5
    pinlabels:
      - "TCU pin 13: KL30 (main +12V, CONSTANT)"  # 1
      - "TCU pin 9: KL15 (wakeup, IGN switched)"  # 2
      - "TCU GND"                                  # 3
      - "TCU pin 5: CAN H"                         # 4
      - "TCU pin 6: CAN L"                         # 5
    notes: >
      Full harness assembly: MaxxECU 8HP GEN1 CAN harness kit ~$368.
      Source: maxxecu.com/store/gearbox/8hp/maxxecu-8hp-gen1-cable-harness
      MTune: Advanced :: 8HP :: enable. Set ratio table from ZF 8HP70 spec.
      120Ω CAN terminator fitted at TCU end (included in MaxxECU harness kit).

cables:

  W_8HP_CAN:
    wirecount: 2
    colors: [WH, BU]
    wirelabels: ["CAN H", "CAN L"]
    length: 1.5 m
    notes: >-
      Twisted pair, 22 AWG. Engine-bay run from MaxxECU 16-pin aux breakout to 8HP TCU
      (via MaxxECU 8HP GEN1 harness). No firewall crossing under the H2O arch.

  W_8HP_MAIN:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V CONST (14 AWG)"]
    length: 1.5 m
    notes: "PMU16 KL30 output to 8HP TCU pin 13. Engine-bay direct run."

  W_8HP_WAKE:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V IGN (18 AWG)"]
    length: 1.5 m
    notes: "PMU16 KL15 output to 8HP TCU pin 9. Engine-bay direct run."

  W_8HP_GND:
    wirecount: 1
    colors: [BK]
    wirelabels: ["GND (14 AWG)"]
    length: 0.5 m
    notes: "8HP TCU GND to engine-bay chassis GND star point (near ECU mount)."

connections:

  # CAN: ECU 16-pin aux → 8HP TCU (engine-bay direct)
  - - ECU_16PIN: [10, 9]
    - W_8HP_CAN: [1, 2]
    - HP8_TCU: [4, 5]

  # KL30 main power: PMU16 → 8HP TCU pin 13
  - - PMU16_MAIN: [1]
    - W_8HP_MAIN: [1]
    - HP8_TCU: [1]

  # KL15 wakeup: PMU16 → 8HP TCU pin 9
  - - PMU16_IGN: [1]
    - W_8HP_WAKE: [1]
    - HP8_TCU: [2]

  # GND: TCU → engine-bay chassis GND
  - - HP8_TCU: [3]
    - W_8HP_GND: [1]
    - ENG_GND: [1]
