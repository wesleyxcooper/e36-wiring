metadata:
  project: E36 Restomod -- BMW E46 Accelerator Pedal (DBW) Wiring
  description: >-
    BMW E46 accelerator pedal module (35426786282 manual / 35426786281 auto)
    wired to MaxxECU RACE via Deutsch Autosport AS-series firewall bulkhead.
    Phase 3 (07K engine). Six wires cross the firewall: dual APS signals,
    dual 5V supplies, dual sensor grounds. Pedal is in cabin; MaxxECU is in
    engine bay on firewall. All six cross through reserved bulkhead pins.
    Cross-reference docs/dbw-pinouts.md for full specs and TB pinouts.
    Pedal PN is manual vs auto -- NOT LHD vs RHD. Same part in any market.

# ── TODO list ──────────────────────────────────────────────────────────────────
#
#   [ ] Confirm RHD E36 pedal box bracket fitment (Strom / Garagistic / Drift HQ)
#       -- LHD brackets may need carpet trim at transmission tunnel edge in RHD
#       -- If bracket won't fit, switch to harnesses/epedal-hella-6pv.wv instead
#   [x] Assign bulkhead pin numbers for APS1/APS2/VCC1/VCC2/GND1/GND2
#       Assigned: pins 72 (GND1), 73 (GND2), 74 (VCC2), 75 (APS1), 76 (VCC1), 77 (APS2)
#   [ ] Confirm MaxxECU AIN pin numbers for APS1 and APS2
#   [ ] Source and crimp BMW E46 pedal OEM connector + terminals
#       (54-way Molex MX150L series or pigtail from donor harness)
#   [ ] Source and crimp Deutsch AS-series contacts for bulkhead (Size 20)
#   [ ] Verify bench: APS1 idle ~0.70V, WOT ~4.50V; APS2 idle ~0.36V, WOT ~2.20V
#   [ ] Activate MTune E-Throttle, run pedal calibration wizard, verify dual-track ratio
#   [ ] Confirm shielded wire routed away from ignition coil/injector wiring

# ── Connectors ─────────────────────────────────────────────────────────────────

connectors:

  E46_PEDAL:
    type: "BMW E46 Accelerator Pedal Module"
    subtype: "PN 35426786282 (manual) / 35426786281 (auto) -- same in RHD"
    pincount: 6
    pinlabels:
      - "Pin 1 (GND 1 / APS1 sensor GND)"
      - "Pin 2 (GND 2 / APS2 sensor GND)"
      - "Pin 3 (VCC 2 / +5V circuit 2)"
      - "Pin 4 (Output 1 / APS1 signal)"
      - "Pin 5 (VCC 1 / +5V circuit 1)"
      - "Pin 6 (Output 2 / APS2 signal)"
    notes: >-
      6-pin dual-track hall-effect sensor. Two fully independent circuits.
      Total current draw: ~20 mA. 24 AWG wire sufficient on all pins.
      APS2 voltage is intentionally ~half APS1 at every pedal position.
      MaxxECU cross-checks ratio -- disagrement triggers e-throttle shutdown.
      Bench-verified pinout: HP Academy forum + openinverter.org BMW pedal wiki.
      Source used E46 pedal: eBay $30-80. New OEM: ~$130-140.
      Adapter bracket: Strom Motorsports / Garagistic / Boost Monkey / Drift HQ
      (~$40-60 each). RHD fitment unconfirmed -- contact vendor before ordering.

  BULKHEAD_CABIN:
    type: "Deutsch Autosport AS-series firewall bulkhead -- CABIN SIDE"
    subtype: "Size 20 contacts -- pins 72-77 assigned to e-pedal APS signals"
    pincount: 6
    pinlabels:
      - "Pin 72 (APS GND 1 pass-through)"
      - "Pin 73 (APS GND 2 pass-through)"
      - "Pin 74 (VCC 2 pass-through)"
      - "Pin 75 (APS1 signal pass-through)"
      - "Pin 76 (VCC 1 pass-through)"
      - "Pin 77 (APS2 signal pass-through)"
    notes: >-
      Panel-mount receptacle, cabin side. Pins 72-77 are cavity-plugged in Phase 1
      (M52 has no DBW pedal) and wired at Phase 3 (07K swap). The cabin-side cable
      run (E46 pedal :: bulkhead face) is the ONE cabin-side harness addition at swap.
      Size 20 contacts rated 7.5A continuous -- more than sufficient for 20mA.
      Use Size 20 sockets (cable side) with 22-24 AWG range crimp tooling.
      Bulkhead backshell: Raychem DR-25 over strain relief on cabin side.

  BULKHEAD_ENGINE:
    type: "Deutsch Autosport AS-series firewall bulkhead -- ENGINE SIDE"
    subtype: "Size 20 contacts -- pins 72-77 assigned to e-pedal APS signals"
    pincount: 6
    pinlabels:
      - "Pin 72 (APS GND 1 :: MaxxECU SGND)"
      - "Pin 73 (APS GND 2 :: MaxxECU SGND)"
      - "Pin 74 (VCC 2 :: MaxxECU +5V sensor supply)"
      - "Pin 75 (APS1 signal :: MaxxECU APS1 AIN)"
      - "Pin 76 (VCC 1 :: MaxxECU +5V sensor supply)"
      - "Pin 77 (APS2 signal :: MaxxECU APS2 AIN)"
    notes: >-
      Part of the 07K engine harness plug (maxxecu-07k.wv BULKHEAD_ENGINE_07K).
      Cavity-plugged on M52 engine-side plug -- M52 swap does not require
      touching these pins. Engine side of 72-77 wires to MaxxECU CMC APS inputs.
      AIN channel numbers for APS1/APS2 TBD -- assign in MTune and document
      in maxxecu-07k.wv once confirmed.

  MAXXECU_APS:
    type: "MaxxECU RACE -- Analog Inputs + Sensor Supply + Sensor GND"
    subtype: "CMC connector -- AIN pins TBD, 5V SENS OUT, SGND"
    pincount: 6
    pinlabels:
      - "SGND 1 (sensor ground bus)"
      - "SGND 2 (sensor ground bus)"
      - "+5V SENS OUT 2 (sensor reference)"
      - "AIN x (APS1 signal input)"
      - "+5V SENS OUT 1 (sensor reference)"
      - "AIN y (APS2 signal input)"
    notes: >-
      Assign lowest available AIN numbers for APS1 and APS2 (e.g. AIN 5 / AIN 6).
      MaxxECU has two independent +5V sensor supply outputs -- use separate ones
      for each pedal circuit if available; tie to same output only if MaxxECU
      current budget allows (check MaxxECU Race +5V sensor supply max load).
      MTune path: Settings, E-Throttle, Pedal position.
      Run e-throttle calibration wizard after wiring -- captures min/max automatically.

# ── Cables ─────────────────────────────────────────────────────────────────────

cables:

  CABLE_PEDAL_TO_BULKHEAD:
    gauge: "24 AWG"
    length: "0.8 m"
    wirecount: 6
    colors: [BK, BK, RD, GN, RD, YE]
    shield: true
    notes: >-
      Cabin-side cable: E46 pedal connector to bulkhead cabin face.
      24 AWG sufficient -- total circuit draw ~20 mA.
      Shielded 6-conductor; drain shield to chassis GND at MaxxECU end only
      (single-end drain prevents ground loops).
      Wire 1 BK: APS1 GND (Pin 1). Wire 2 BK: APS2 GND (Pin 2).
      Wire 3 RD: VCC2 (Pin 3). Wire 4 GN: APS1 signal (Pin 4).
      Wire 5 RD: VCC1 (Pin 5). Wire 6 YE: APS2 signal (Pin 6).
      Route through cabin, away from audio wiring. No high-current sharing.

  CABLE_BULKHEAD_TO_MAXXECU:
    gauge: "24 AWG"
    length: "0.4 m"
    wirecount: 6
    colors: [BK, BK, RD, GN, RD, YE]
    shield: true
    notes: >-
      Engine-side cable: bulkhead engine face to MaxxECU CMC connector.
      Short run -- MaxxECU is mounted on firewall in engine bay.
      Same color coding as cabin side for traceability.
      Drain shield here (to MaxxECU SGND or chassis GND) -- this is the
      single shield drain point for the entire pedal signal path.

# ── Connections ────────────────────────────────────────────────────────────────

connections:
  # E46 pedal → bulkhead cabin side
  -
    - E46_PEDAL: [1, 2, 3, 4, 5, 6]
    - CABLE_PEDAL_TO_BULKHEAD: [1, 2, 3, 4, 5, 6]
    - BULKHEAD_CABIN: [1, 2, 3, 4, 5, 6]
  # Bulkhead engine side → MaxxECU
  -
    - BULKHEAD_ENGINE: [1, 2, 3, 4, 5, 6]
    - CABLE_BULKHEAD_TO_MAXXECU: [1, 2, 3, 4, 5, 6]
    - MAXXECU_APS: [1, 2, 3, 4, 5, 6]
