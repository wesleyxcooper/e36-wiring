metadata:
  project: E36 Restomod -- BMW E46 Accelerator Pedal (DBW) Wiring
  description: >-
    BMW E46 accelerator pedal module (35426786282 manual / 35426786281 auto)
    wired to MaxxECU RACE. Phase 3 (07K engine). MaxxECU is cabin-mounted on the
    interior firewall face. APS wiring is CABIN-TO-CABIN ONLY -- no firewall
    bulkhead crossing required. Six wires run from pedal (footwell) to MaxxECU
    C2 connector and the main CMC sensor supply rail. AS79 bulkhead pins 72-77
    are NOT used for APS; they remain spare.
    Confirmed C2 pin assignments: APS1 → C2 E4 (AIN 6), APS2 → C2 F1 (AIN 7).
    Source: MaxxECU RACE GEN1 C2 pinout (maxxecu.com/webhelp/wirings-maxxecu_pinout.html).
    Cross-reference docs/dbw-pinouts.md for full specs and TB pinouts.
    Pedal PN is manual vs auto -- NOT LHD vs RHD. Same part in any market.

# ─────────────────────────────────────────────────────────────────────────────
# CRIMP TOOLS — which tool for which contact in this harness:
#
#   Maven HD30 size-20 contacts (A14–A19, cabin face) → Deutsch HDT-48-00 (or JRready NEW-DT2)
#   MaxxECU C2 Molex contacts (APS1 · APS2 · +5V · GND) → Molex 63811-9200 (small)
#   BMW E46 pedal connector contacts                   → Engineer PA-09
#
#   Wire stripper                   → Ideal Stripmaster 45-097 + L4994 blades, 16–26 AWG fixed-notch (do not use auto-adjusting strippers on 22 AWG TXL)
#
# Full tool-to-connector reference: e36-wiring/docs/harness-build.md § Tools
# ─────────────────────────────────────────────────────────────────────────────
#
# ── TODO list ──────────────────────────────────────────────────────────────────
#
#   [ ] Confirm RHD E36 pedal box bracket fitment (Strom / Garagistic / Drift HQ)
#       -- LHD brackets may need carpet trim at transmission tunnel edge in RHD
#       -- If bracket won't fit, switch to harnesses/epedal-hella-6pv.wv instead
#   [x] Confirm MaxxECU AIN pin numbers for APS1 and APS2
#       CONFIRMED: APS1 → C2 E4 (AIN 6), APS2 → C2 F1 (AIN 7)
#       Source: MaxxECU RACE GEN1 C2 pinout — maxxecu.com/webhelp/wirings-maxxecu_pinout.html
#   [x] APS routing confirmed cabin-to-cabin; AS79 bulkhead NOT used for APS
#   [ ] Source and crimp BMW E46 pedal OEM connector + terminals
#       (54-way Molex MX150L series or pigtail from donor harness)
#   [ ] Verify bench: APS1 idle ~0.70V, WOT ~4.50V; APS2 idle ~0.36V, WOT ~2.20V
#   [ ] Activate MTune E-Throttle, run pedal calibration wizard, verify dual-track ratio
#   [ ] Confirm shielded wire routed away from ignition coil/injector wiring

# ── Connectors ─────────────────────────────────────────────────────────────────

connectors:

  E46_PEDAL:
    type: "BMW E46 Accelerator Pedal Module"
    subtype: "PN 35426786282 (manual) / 35426786281 (auto) -- same in RHD"
    pincount: 6
    pinlabels:
      - "Pin 1 (GND 1 / APS1 sensor GND)"
      - "Pin 2 (GND 2 / APS2 sensor GND)"
      - "Pin 3 (VCC 2 / +5V circuit 2)"
      - "Pin 4 (Output 1 / APS1 signal)"
      - "Pin 5 (VCC 1 / +5V circuit 1)"
      - "Pin 6 (Output 2 / APS2 signal)"
    notes: >-
      6-pin dual-track hall-effect sensor. Two fully independent circuits.
      Total current draw: ~20 mA. 24 AWG wire sufficient on all pins.
      APS2 voltage is intentionally ~half APS1 at every pedal position.
      MaxxECU cross-checks ratio -- disagreement triggers e-throttle shutdown.
      Bench-verified pinout: HP Academy forum + openinverter.org BMW pedal wiki.
      Source used E46 pedal: eBay $30-80. New OEM: ~$130-140.
      Adapter bracket: Strom Motorsports / Garagistic / Boost Monkey / Drift HQ
      (~$40-60 each). RHD fitment unconfirmed -- contact vendor before ordering.

  MAXXECU_C2:
    type: "MaxxECU RACE GEN1 C2 connector (32-pin Molex CMC)"
    subtype: "Cabin-mounted ECU -- APS signal inputs at C2 E4 (AIN 6) and C2 F1 (AIN 7)"
    pincount: 2
    pinlabels:
      - "C2 E4 (AIN 6) — APS1 signal input"
      - "C2 F1 (AIN 7) — APS2 signal input"
    notes: >-
      Confirmed from MaxxECU RACE GEN1 C2 pinout:
        C2 E4 = AIN 6 (0-5V analog input)
        C2 F1 = AIN 7 (0-5V analog input)
      Source: maxxecu.com/webhelp/wirings-maxxecu_pinout.html
      AIN 5 (C2 G3) is already occupied by the virtual clutch position sensor
      (see maxxecu-m52.wv ECU_C2). AIN 6 and AIN 7 are the next available inputs.
      MTune path: Settings → E-Throttle → Pedal position → assign AIN 6 (APS1) and
      AIN 7 (APS2). Run e-throttle calibration wizard after wiring.

  MAXXECU_SUPPLY:
    type: "MaxxECU RACE main CMC supply rails"
    subtype: "+5V sensor supply (CMC G1) and Sensor GND (CMC H1) -- shared bus"
    pincount: 2
    pinlabels:
      - "CMC G1 (+5V sensor supply) — shared with TPS/MAP/CLT/CAM"
      - "CMC H1 (Sensor GND) — shared sensor ground bus"
    notes: >-
      Both APS circuits (VCC1 and VCC2) tap the same MaxxECU +5V sensor supply rail (CMC G1).
      Both APS sensor grounds (GND1 and GND2) return to the sensor GND bus (CMC H1).
      The ECU_16PIN aux breakout (pin 1 = +5V, pin 2 = Sensor GND) is an equivalent tap point
      if routing from the breakout connector is more convenient.
      MaxxECU +5V rail is rated 150 mA continuous (from ECU_16PIN note). APS draws ~20 mA total
      -- well within budget shared with other sensors.
      Do NOT connect APS GND to chassis GND or engine GND (C2 G4). Must go to sensor GND bus.

# ── Cables ─────────────────────────────────────────────────────────────────────

cables:

  CABLE_PEDAL_TO_MAXXECU:
    gauge: "24 AWG"
    length: "1.5 m"
    wirecount: 6
    colors: [BK, BK, RD, GN, RD, YE]
    shield: true
    notes: >-
      Cabin-only run: E46 pedal connector (footwell) → MaxxECU connector area (firewall).
      No firewall crossing. Route along the tunnel/sill, away from audio wiring.
      24 AWG sufficient -- total circuit draw ~20 mA.
      Shielded 6-conductor; drain shield at MaxxECU end only (single-end drain prevents
      ground loops). Tie drain wire to CMC H1 (Sensor GND).
      Wire 1 BK: APS1 GND (pedal pin 1) → MAXXECU_SUPPLY GND bus (CMC H1).
      Wire 2 BK: APS2 GND (pedal pin 2) → MAXXECU_SUPPLY GND bus (CMC H1).
      Wire 3 RD: VCC2 (pedal pin 3) → MAXXECU_SUPPLY +5V rail (CMC G1).
      Wire 4 GN: APS1 signal (pedal pin 4) → MAXXECU_C2 E4 (AIN 6).
      Wire 5 RD: VCC1 (pedal pin 5) → MAXXECU_SUPPLY +5V rail (CMC G1).
      Wire 6 YE: APS2 signal (pedal pin 6) → MAXXECU_C2 F1 (AIN 7).

# ── Connections ────────────────────────────────────────────────────────────────

connections:
  # APS signals: E46 pedal → MaxxECU C2 (AIN 6 / AIN 7)
  -
    - E46_PEDAL: [4, 6]
    - CABLE_PEDAL_TO_MAXXECU: [4, 6]
    - MAXXECU_C2: [1, 2]
  # APS supplies: E46 pedal → MaxxECU CMC +5V rail (VCC1 and VCC2 share same bus)
  -
    - E46_PEDAL: [3, 5]
    - CABLE_PEDAL_TO_MAXXECU: [3, 5]
    - MAXXECU_SUPPLY: [1, 1]
  # APS grounds: E46 pedal → MaxxECU CMC sensor GND bus (GND1 and GND2 share same bus)
  -
    - E46_PEDAL: [1, 2]
    - CABLE_PEDAL_TO_MAXXECU: [1, 2]
    - MAXXECU_SUPPLY: [2, 2]
