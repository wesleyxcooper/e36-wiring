# firewall-bulkhead-dual.wv
# E36 Firewall Bulkhead — EXPERIMENTAL: Dual Maven HD30 (29-pin + 47-pin)
#
# Sources:
#   MaxxECU GEN1 pinout:     maxxecu.com/webhelp/wirings-maxxecu_pinout.html
#   M50 terminated harness:  maxxecu.com/webhelp/wirings-terminated_engine_harness-bmw_m50.html
#   8HP wiring:              maxxecu.com/webhelp/advanced-8hp-wiring_information.html
#   DCTShifter:              dctshifter.com/pages/installation
#   Connector supplier:      mavenspeed.com/products/dual-connector-bulkhead
#
# Architecture:
#   See firewall-bulkhead.wv for the baseline AS79 single-connector design.
#
#   This variant replaces the AS79 with two Deutsch HD30 shell-size-24 connectors
#   on a single Maven dual bulkhead plate (47+29 configuration, $290).
#
#   CONNECTOR A (29-pin — "STAYS") — never disconnected at M52→07K engine swap:
#     Fixed-destination signals: 8HP CAN/power, fans, EWP, AC, chassis GND
#     Engine-agnostic signals:   WBO2 (bung is welded in exhaust, same sensor any engine)
#     Cabin-originated signals:  APS e-pedal (Phase 3 addition — pedal + ECU both stay)
#
#   CONNECTOR B (47-pin — "ENGINE") — unplugged at engine swap:
#     Engine power and GND (coils/inj rail, engine head stud GND)
#     Ignition outputs (IGN 1–5 common; IGN 6 M52-only)
#     Injector outputs (INJ 1–5 common; INJ 6 M52-only)
#     Crank/cam triggers (M52 uses B pins 15–18; 07K uses B pins 39–40 — different CMC)
#     All engine sensors (CLT, IAT, TPS, MAP, PST-F1, flex fuel)
#     GPO actuators (boost solenoid common; VANOS + ICV M52-only)
#     Starter trigger, alternator D+
#     07K-phase essentials: 5th-cyl INJ/IGN, 07K cam/crank, DBW throttle body, knock sensors
#
# Pin count summary:
#   Connector A: 17 active (M52 phase) → 23 active (07K phase) / 29 cavities = 6 spare at 07K
#   Connector B: 36 active (M52 phase) → 46 active (07K phase) / 47 cavities = 1 spare at 07K
#
# ⚠️  DEFERRED — the following optional expansion stubs from the AS79 design do not fit:
#     56 (DIN 4/VR 1), 57 (DIN 5/VR 2), 58 (AIN 6 spare), 59 (GPO 8/TACHO),
#     60 (+5V supply 2), 61 (Sensor GND 2), 62 (+12V switched spare), 68 (MAP 2 spare)
#     → Route TACHO through OEM X20 pin 5 instead of bulkhead
#     → Consolidate 07K sensor +5V/GND onto existing Connector B pins 23/20
#       (verify 07K cam Hall sensor is compatible with MaxxECU CMC G1 5V ref; if not,
#        pins 25 and 26 in Connector A can absorb +5V-2 and Sensor GND 2 — see note below)
#
# ⚠️  ONE-SPARE RISK: Connector B has 1 spare cavity at full 07K build. Any
#     unanticipated signal (shield drain, additional sensor, split 5V ref) overflows.
#     Keep this in mind before committing to the plate cutout.
#
# Tooling:
#   Crimper:     Deutsch HDT-48-00 (~$65–120) — covers all HD30 solid contacts
#   Depin:       Standard Deutsch round-shoulder removal tool (HD30 rear-release)
#   Plate kit:   Maven dual bulkhead 47+29 — includes both connector bodies (plug + receptacle)
#                + all contact terminals both sides. Boots sold separately.
#
# ──────────────────────────────────────────────────────────────────────────

connectors:

  # ══════════════════════════════════════════════════════════════════════
  #  CONNECTOR A  —  29-pin  —  "STAYS"
  #  Maven HD30 shell-size-24, 29-way
  #  Cabin side: permanent. Engine side: also permanent (never swapped).
  # ══════════════════════════════════════════════════════════════════════

  BULKHEAD_A_CABIN:
    type: "Maven / Deutsch HD30 shell-size-24 29-way flange receptacle"
    subtype: "Connector A cabin side — permanent. 8HP + accessories + WBO2 + APS."
    pincount: 29
    pinlabels:
      # ── 8HP power + CAN ──────────────────────────────────────────────
      - "+12V 8HP Main (powerhold relay)"   # A1  Size 12  14 AWG  MUST BE CONSTANT
      - "+12V 8HP Wakeup (IGN switched)"    # A2  Size 20  18 AWG
      - "8HP TCU GND"                       # A3  Size 12  14 AWG
      - "CAN H (CMC E1)"                    # A4  Size 20  22 AWG twisted pair
      - "CAN L (CMC E2)"                    # A5  Size 20  22 AWG twisted pair
      # ── Fixed accessories (fans, EWP, AC) ────────────────────────────
      - "+12V Fan relay out"                # A6  Size 12  12 AWG
      - "+12V Condenser fan relay out"      # A7  Size 12  12 AWG
      - "+12V EWP relay out"                # A8  Size 8   10 AWG  CWA400 36.3A max
      - "+12V AC relay out"                 # A9  Size 12  8 AWG
      - "EWP PWM (GPO → CWA400 pin 1)"     # A10 Size 20  20 AWG  680 Hz
      - "AC enable signal (GPO → AC relay)" # A11 Size 20  18 AWG
      - "Chassis GND engine bay"            # A12 Size 12  14 AWG
      # ── WBO2 (engine-agnostic — bung welded in exhaust) ──────────────
      - "WBO2 VS (CMC F4)"                  # A13 Size 20  22 AWG
      - "WBO2 VREF (CMC F3)"                # A14 Size 20  22 AWG
      - "WBO2 IP (CMC G3)"                  # A15 Size 20  22 AWG
      - "WBO2 RCAL (CMC G4)"                # A16 Size 20  22 AWG
      - "WBO2 Heater- (CMC D1)"             # A17 Size 20  20 AWG
      # ── APS e-pedal (Phase 3 addition — both pedal and ECU stay) ─────
      - "APS GND 1 (pedal pin 1 → MaxxECU SGND)"   # A18  Phase 3  Size 20  24 AWG
      - "APS GND 2 (pedal pin 2 → MaxxECU SGND)"   # A19  Phase 3  Size 20  24 AWG
      - "APS VCC2 (+5V circ 2, pedal pin 3)"        # A20  Phase 3  Size 20  24 AWG
      - "APS1 signal (pedal pin 4 → MaxxECU APS1)"  # A21  Phase 3  Size 20  24 AWG
      - "APS VCC1 (+5V circ 1, pedal pin 5)"        # A22  Phase 3  Size 20  24 AWG
      - "APS2 signal (pedal pin 6 → MaxxECU APS2)"  # A23  Phase 3  Size 20  24 AWG
      # ── Spare — overflow / future ────────────────────────────────────
      # A24–A29 reserved. Candidates if needed:
      #   +5V supply 2 (if 07K cam Hall can't share Connector B pin B23)
      #   Sensor GND 2  (if 07K cam Hall can't share Connector B pin B20)
      #   Knock GND overflow (if three-pin knock topology needs dedicated return here)
      - "SPARE"   # A24
      - "SPARE"   # A25
      - "SPARE"   # A26
      - "SPARE"   # A27
      - "SPARE"   # A28
      - "SPARE"   # A29
    notes: >-
      Connector A is permanent — never disconnected at M52→07K swap.
      Engine-side of this connector also stays connected; the 8HP TCU, fans, EWP,
      AC compressor, and WBO2 sensor do not move at engine swap time.
      APS pins A18–A23 are cavity-plugged in Phase 1 (M52); the cabin-side cable run
      (E46 pedal → A cabin face) is the one cabin-side harness addition at Phase 3.
      A8 (+12V EWP): use HD30 size-8 contact (60A rating) — CWA400 draws 36.3A max,
      which exceeds size-12 (25A). HD30 natively supports size-8; no Souriau substitution needed.
      CAN H/L (A4/A5) must be twisted pair. 120Ω termination at MaxxECU end (cabin)
      and at 8HP TCU end (engine bay). DCTShifter and Gauge.S tap cabin-side CAN bus
      before the bulkhead — no extra pins needed.

  BULKHEAD_A_ENGINE:
    type: "Maven / Deutsch HD30 shell-size-24 29-way jam nut plug"
    subtype: "Connector A engine side — permanent (never swapped)."
    pincount: 29
    pinlabels:
      - "+12V 8HP Main → TCU pin 13 (constant)"       # A1
      - "+12V 8HP Wakeup → TCU pin 9 (IGN)"           # A2
      - "8HP TCU GND → chassis GND"                    # A3
      - "CAN H → 8HP TCU pin 5"                        # A4
      - "CAN L → 8HP TCU pin 6"                        # A5
      - "+12V Fan → RELAY_FAN motor"                    # A6
      - "+12V Condenser fan → CONDENSER_FAN motor"     # A7
      - "+12V EWP → CWA400 pin 3"                      # A8
      - "+12V AC → AC inverter +12V"                   # A9
      - "EWP PWM → CWA400 pin 1 (680 Hz)"              # A10
      - "AC enable → RELAY_AC coil 86"                 # A11
      - "Chassis GND engine bay (solenoids/actuators)" # A12
      - "WBO2 VS → LSU 4.9 pin 2"                      # A13
      - "WBO2 VREF → LSU 4.9 pin 1"                    # A14
      - "WBO2 IP → LSU 4.9 pin 6"                      # A15
      - "WBO2 RCAL → LSU 4.9 pin 5"                    # A16
      - "WBO2 Heater- → LSU 4.9 pin 3"                 # A17
      - "APS GND 1 → MaxxECU SGND"                     # A18  Phase 3
      - "APS GND 2 → MaxxECU SGND"                     # A19  Phase 3
      - "APS VCC2 → MaxxECU +5V SENS OUT"              # A20  Phase 3
      - "APS1 signal → MaxxECU APS1 AIN"               # A21  Phase 3
      - "APS VCC1 → MaxxECU +5V SENS OUT"              # A22  Phase 3
      - "APS2 signal → MaxxECU APS2 AIN"               # A23  Phase 3
      - "SPARE — cavity plug"   # A24
      - "SPARE — cavity plug"   # A25
      - "SPARE — cavity plug"   # A26
      - "SPARE — cavity plug"   # A27
      - "SPARE — cavity plug"   # A28
      - "SPARE — cavity plug"   # A29
    notes: >-
      Connector A engine side is permanent — never replaced. The WBO2 Heater+ (LSU 4.9 pin 4)
      connects to engine-bay +12V coil/inj rail (Connector B engine side, pin B1) via
      local splice — no extra bulkhead pin needed (same arrangement as AS79 baseline).


  # ══════════════════════════════════════════════════════════════════════
  #  CONNECTOR B  —  47-pin  —  "ENGINE"
  #  Maven HD30 shell-size-24, 47-way
  #  Cabin side: permanent. Engine side: mating plug swapped M52↔07K.
  # ══════════════════════════════════════════════════════════════════════

  BULKHEAD_B_CABIN:
    type: "Maven / Deutsch HD30 shell-size-24 47-way flange receptacle"
    subtype: "Connector B cabin side — permanent. Engine control signals."
    pincount: 47
    pinlabels:
      # ── Power + engine GND ───────────────────────────────────────────
      - "+12V Coils/Inj (20A relay)"        # B1  Size 12  12 AWG
      - "Engine GND (cyl head stud)"        # B2  Size 12  14 AWG  DO NOT OMIT
      # ── Ignition outputs ─────────────────────────────────────────────
      - "IGN 1 (CMC A2)"                    # B3  Size 20  18 AWG
      - "IGN 2 (CMC A3)"                    # B4  Size 20  18 AWG
      - "IGN 3 (CMC B2)"                    # B5  Size 20  18 AWG
      - "IGN 4 (CMC B3)"                    # B6  Size 20  18 AWG
      - "IGN 5 (CMC C2)"                    # B7  Size 20  18 AWG
      - "IGN 6 (CMC C3) [M52; stub 07K]"   # B8  Size 20  18 AWG
      # ── Injector outputs ─────────────────────────────────────────────
      - "INJ 1 (CMC K1)"                    # B9  Size 20  20 AWG
      - "INJ 2 (CMC K2)"                    # B10 Size 20  20 AWG
      - "INJ 3 (CMC M1)"                    # B11 Size 20  20 AWG
      - "INJ 4 (CMC M2)"                    # B12 Size 20  20 AWG
      - "INJ 5 (CMC M3)"                    # B13 Size 20  20 AWG
      - "INJ 6 (CMC L3) [M52; stub 07K]"   # B14 Size 20  20 AWG
      # ── Crank / cam triggers (M52) ───────────────────────────────────
      # 07K uses different CMC inputs; see B39–B40 below.
      - "TRIGGER / Crank VR+ (CMC H3) [M52]"   # B15 Size 20  22 AWG shielded
      - "Trigger GND / Crank VR- (CMC H2) [M52]" # B16 Size 20  22 AWG  DEDICATED GND
      - "Crank shield (drain) [M52]"             # B17 Size 20  22 AWG
      - "HOME / Cam Hall signal (CMC H4) [M52]" # B18 Size 20  22 AWG
      - "SPARE (cam +12V not needed — BMW 12141726590)"  # B19
      # ── Engine sensors ───────────────────────────────────────────────
      - "Sensor GND shared (CLT/IAT/TPS/MAP/PST-F1/Cam)" # B20 Size 20  22 AWG
      - "CLT signal (CMC F1)"               # B21 Size 20  22 AWG
      - "IAT signal (CMC F2)"               # B22 Size 20  22 AWG
      - "+5V sensor supply (CMC G1)"        # B23 Size 20  22 AWG  TPS/MAP/PST-F1
      - "TPS signal (CMC G2)"               # B24 Size 20  22 AWG
      - "MAP signal → AIN 4"               # B25 Size 20  22 AWG
      - "PST-F1 pressure → AIN 3 (CMC J3)" # B26 Size 20  22 AWG
      - "PST-F1 temp → AIN 1 (CMC J1)"     # B27 Size 20  22 AWG
      - "Flex fuel signal → DIN3 (CMC C1)"  # B28 Size 20  22 AWG
      - "Flex fuel +12V"                    # B29 Size 20  22 AWG
      # ── GPO actuators ────────────────────────────────────────────────
      - "GPO 1 → Boost solenoid (CMC B4)"   # B30 Size 20  20 AWG
      - "GPO 3 → VANOS (CMC D4) [M52 only]" # B31 Size 20  20 AWG
      - "GPO 4 → ICV coil A (CMC E4) [M52]" # B32 Size 20  20 AWG
      - "GPO 5 → ICV coil B (CMC A1) [M52]" # B33 Size 20  20 AWG
      # ── Misc engine bay ──────────────────────────────────────────────
      - "Starter trigger (12-pin pin 6)"    # B34 Size 20  18 AWG
      - "Alternator D+ excitation (12-pin M)" # B35 Size 20  18 AWG
      - "AIN 2 (CMC J2) — spare temp"       # B36 Size 20  22 AWG
      # ── 07K phase expansions (cavity-plugged on M52 engine-side plug) ──
      - "EXP: INJ 7 (07K 5th cyl) → CMC L2"     # B37  Phase 3
      - "EXP: IGN 7 (07K 5th cyl) → CMC D2"     # B38  Phase 3
      - "EXP: 07K cam signal (different type)"   # B39  Phase 3
      - "EXP: 07K crank signal"                  # B40  Phase 3
      - "EXP: DBW throttle body signal (07K)"    # B41  Phase 3
      - "EXP: DBW throttle body +5V (07K)"       # B42  Phase 3
      - "EXP: DBW throttle body GND (07K)"       # B43  Phase 3
      - "EXP: Knock sensor 1"                    # B44  Phase 3
      - "EXP: Knock sensor 2"                    # B45  Phase 3
      - "EXP: Knock GND"                         # B46  Phase 3
      # ── ONE spare cavity ─────────────────────────────────────────────
      - "SPARE"                                   # B47
    notes: >-
      Connector B cabin side is permanent (never disconnected). Engine-side mating plug
      swaps at M52→07K: M52 plug populates B1–B36 (B8/B14/B31–B33 on M52 mating plug;
      B37–B46 cavity-plugged). 07K plug populates B1–B7, B9–B13, B15–B19 cavity-plugged
      (07K uses B39–B40 for its own cam/crank CMC inputs), B20–B30, B34–B36, B37–B46.
      WBO2 Heater+ (LSU 4.9 pin 4) splices locally to +12V coil/inj rail (B1) on the
      engine side — no dedicated bulkhead pin needed.
      Crank VR+/−/shield (B15–B17) must be shielded twisted pair; shield terminates at
      cabin-side sensor GND (CMC H1), floating at engine side.
      07K cam signal type (B39): verify at install whether the 07K Hall sensor is +5V
      or +12V type. If +5V and it cannot share B23 (CMC G1), migrate to Connector A
      spare A25 and pair with Sensor GND 2 on A26. Update mating plug accordingly.
      B47 is the only true spare cavity. Any additional signal discovered mid-build
      must either share an existing GND/5V rail (check load budgets) or overflow to
      Connector A spares A24–A29.

  BULKHEAD_B_ENGINE_M52:
    type: "Maven / Deutsch HD30 shell-size-24 47-way jam nut plug"
    subtype: "Connector B engine side — M52 Phase 1. Unplugs at 07K swap."
    pincount: 47
    pinlabels:
      - "+12V Coils/Inj → engine harness common rail"   # B1
      - "Engine GND → cylinder head stud"               # B2
      - "IGN 1 → coil 1"                                # B3
      - "IGN 2 → coil 2"                                # B4
      - "IGN 3 → coil 3"                                # B5
      - "IGN 4 → coil 4"                                # B6
      - "IGN 5 → coil 5"                                # B7
      - "IGN 6 → coil 6"                                # B8  M52 only
      - "INJ 1 → injector 1"                            # B9
      - "INJ 2 → injector 2"                            # B10
      - "INJ 3 → injector 3"                            # B11
      - "INJ 4 → injector 4"                            # B12
      - "INJ 5 → injector 5"                            # B13
      - "INJ 6 → injector 6"                            # B14  M52 only
      - "Crank VR+ → M52 crank sensor pin 1"            # B15
      - "Crank VR- → M52 crank sensor pin 2"            # B16
      - "Crank shield → sensor shell"                    # B17
      - "Cam Hall signal → BMW 12141726590 pin 2"        # B18
      - "SPARE — cavity plug"                            # B19
      - "Sensor GND → CLT/IAT/TPS/MAP/PST-F1 GND"      # B20
      - "CLT → Bosch JPT 2-way pin 1"                   # B21
      - "IAT → OEM M52 pin 1"                           # B22
      - "+5V → TPS pin 1 / MAP / PST-F1"               # B23
      - "TPS signal → OEM TPS pin 2"                    # B24
      - "MAP signal → MAP sensor"                       # B25
      - "PST-F1 pressure → sensor pin 3"                # B26
      - "PST-F1 temp → sensor pin 4"                    # B27
      - "Flex fuel → Continental sensor signal"          # B28
      - "Flex fuel +12V → Continental sensor +12V"      # B29
      - "GPO 1 → boost solenoid Superseal pin 2"        # B30
      - "GPO 3 → VANOS solenoid pin 2"                  # B31  M52 only
      - "GPO 4 → ICV coil A (JPT 3-way pin 2)"          # B32  M52 only
      - "GPO 5 → ICV coil B (JPT 3-way pin 3)"          # B33  M52 only
      - "Starter trigger → starter solenoid"             # B34
      - "Alt D+ → alternator excitation terminal"       # B35
      - "AIN 2 — STUB (sealed)"                         # B36
      - "STUB — cavity plug"   # B37  (07K INJ 7)
      - "STUB — cavity plug"   # B38  (07K IGN 7)
      - "STUB — cavity plug"   # B39  (07K cam)
      - "STUB — cavity plug"   # B40  (07K crank)
      - "STUB — cavity plug"   # B41  (07K DBW signal)
      - "STUB — cavity plug"   # B42  (07K DBW +5V)
      - "STUB — cavity plug"   # B43  (07K DBW GND)
      - "STUB — cavity plug"   # B44  (knock 1)
      - "STUB — cavity plug"   # B45  (knock 2)
      - "STUB — cavity plug"   # B46  (knock GND)
      - "SPARE — cavity plug"  # B47
    notes: >-
      M52 Phase 1 engine-side plug. 36 active wires (B1–B36, minus B19 spare).
      B37–B47 cavity-plugged. At 07K swap: unplug this, build and install 07K Phase 3 plug.
      Connector A engine side stays connected throughout — do not unplug.
      07K PHASE 3 PLUG PINOUT (not modelled as WireViz connector — describe at build time):
        B1–B7: same (IGN 1-5 active; IGN 6 cavity-plug).
        B8: cavity-plug (07K 5-cyl, no IGN 6).
        B9–B13: same (INJ 1-5 active; INJ 6 cavity-plug).
        B14: cavity-plug (07K 5-cyl, no INJ 6).
        B15–B18: cavity-plug (M52 crank/cam; 07K uses B39–B40).
        B19: spare cavity-plug.
        B20–B23: same (sensor GND, CLT, IAT, +5V — verify 07K cam Hall shares G1 5V ref).
        B24: cavity-plug (M52 TPS; 07K TB TPS → B41 DBW set).
        B25–B30: same (MAP, PST pres, PST temp, flex sig, flex +12V, boost solenoid).
        B31–B33: cavity-plug (VANOS, ICV A/B — 07K has none).
        B34–B36: same (starter, alt D+, AIN2 stub).
        B37: INJ 7 → 07K injector 5 (CMC L2).
        B38: IGN 7 → 07K coil 5 (CMC D2).
        B39: 07K cam signal (confirm CMC pin — different type from M52 Hall).
        B40: 07K crank VR signal.
        B41: DBW TB signal → TB TPS output.
        B42: DBW TB +5V → TB sensor supply.
        B43: DBW TB GND → TB sensor GND.
        B44: Knock sensor 1.
        B45: Knock sensor 2.
        B46: Knock GND.
        B47: SPARE.
      Cam sensor note: if 07K cam Hall is +5V type and cannot share B23 (CMC G1),
      migrate to Connector A A25 (+5V-2) / A26 (SGND-2).
      DBW TB motor +/− stay on engine side (H-bridge engine-bay mounted) — do not cross bulkhead.
      WBO2 Heater+ (LSU 4.9 pin 4): splice to +12V coil/inj rail at B1 on engine side.


cables:

  # ── Connector A cable bundle ──────────────────────────────────────────

  W_BULKHEAD_A:
    wirecount: 17
    colors:
      - RD   # A1  +12V 8HP Main
      - RD   # A2  +12V 8HP Wakeup
      - BK   # A3  8HP TCU GND
      - WH   # A4  CAN H
      - BU   # A5  CAN L
      - RD   # A6  +12V Fan
      - RD   # A7  +12V Condenser fan
      - RD   # A8  +12V EWP
      - RD   # A9  +12V AC relay
      - GN   # A10 EWP PWM
      - GN   # A11 AC enable
      - BK   # A12 Chassis GND
      - WH   # A13 WBO2 VS
      - WH   # A14 WBO2 VREF
      - WH   # A15 WBO2 IP
      - WH   # A16 WBO2 RCAL
      - BK   # A17 WBO2 Heater-
    wirelabels:
      - "+12V 8HP Main (14 AWG CONST)"
      - "+12V 8HP Wake (18 AWG IGN)"
      - "8HP GND (14 AWG)"
      - "CAN H (22 AWG TP)"
      - "CAN L (22 AWG TP)"
      - "+12V Fan (12 AWG)"
      - "+12V Cond Fan (12 AWG)"
      - "+12V EWP (10 AWG)"
      - "+12V AC (8 AWG)"
      - "EWP PWM (20 AWG)"
      - "AC enable (18 AWG)"
      - "Chas GND (14 AWG)"
      - "WBO2 VS (22 AWG)"
      - "WBO2 VREF"
      - "WBO2 IP"
      - "WBO2 RCAL"
      - "WBO2 Htr- (20 AWG)"
    notes: >-
      CAN H/L (A4/A5) must be twisted pair. 120Ω at MaxxECU end and 8HP TCU end.
      APS wires (A18–A23) are added at Phase 3 as a separate cabin cable run
      (pedal → Connector A cabin face, 0.8m, 24 AWG shielded 6-conductor).
      WBO2 bundle: shielded 5-conductor preferred. Drain at MaxxECU end only.

  # ── Connector B cable bundle ──────────────────────────────────────────

  W_BULKHEAD_B:
    wirecount: 36
    colors:
      - RD   # B1  +12V Coils/Inj
      - BK   # B2  Engine GND
      - GY   # B3  IGN 1
      - GY   # B4  IGN 2
      - GY   # B5  IGN 3
      - GY   # B6  IGN 4
      - GY   # B7  IGN 5
      - GY   # B8  IGN 6 [M52]
      - GN   # B9  INJ 1
      - GN   # B10 INJ 2
      - GN   # B11 INJ 3
      - GN   # B12 INJ 4
      - GN   # B13 INJ 5
      - GN   # B14 INJ 6 [M52]
      - WH   # B15 Crank VR+
      - BK   # B16 Crank VR-
      - GY   # B17 Crank shield
      - WH   # B18 Cam Hall signal
      - GY   # B19 (spare)
      - BK   # B20 Sensor GND shared
      - WH   # B21 CLT
      - WH   # B22 IAT
      - RD   # B23 +5V sensor
      - WH   # B24 TPS signal
      - WH   # B25 MAP
      - WH   # B26 PST pres
      - WH   # B27 PST temp
      - WH   # B28 Flex sig
      - RD   # B29 Flex +12V
      - GN   # B30 GPO1 Boost
      - GN   # B31 GPO3 VANOS
      - GN   # B32 GPO4 ICV-A
      - GN   # B33 GPO5 ICV-B
      - YE   # B34 Starter
      - YE   # B35 Alt D+
      - WH   # B36 AIN2 spare
    wirelabels:
      - "+12V Coils/Inj (12 AWG)"
      - "Eng GND (14 AWG)"
      - "IGN 1 (18 AWG)"
      - "IGN 2"
      - "IGN 3"
      - "IGN 4"
      - "IGN 5"
      - "IGN 6 [M52]"
      - "INJ 1 (20 AWG)"
