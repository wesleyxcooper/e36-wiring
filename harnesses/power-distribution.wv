metadata:
  project: E36 Restomod -- Power Distribution
  description: >-
    Relay board and fuse block wiring for MaxxECU Race installation.
    Phase 1 (M52 engine). All values are stubs -- confirm fuse sizes,
    wire gauges, relay part numbers, and physical layout before building.
    Cross-reference harnesses/maxxecu-m52.wv for ECU pin assignments.

# ── TODO list ──────────────────────────────────────────────────────────────────
#
#   RELAY BOARD:
#   [ ] Confirm relay board physical location (firewall? fender well?)
#   [ ] Confirm whether to use a pre-made relay/fuse block combo (e.g.
#       Mictuning, Bussmann, or custom) or individual relays on a DIN rail
#   [ ] Size wire gauges for each run -- use a wire gauge calculator:
#       12 AWG :: up to 20A for engine bay runs (3-5ft)
#       10 AWG :: up to 30A
#        8 AWG :: up to 40A (fan, fuel pump on long runs)
#        4 AWG :: main battery cable to fuse block
#   [ ] Confirm fuse sizes after confirming all load current draws
#
#   BATTERY / CUTOFF SWITCH:
#   [ ] Confirm battery location (stock E36 = driver footwell OR engine bay)
#   [ ] If trunk or footwell: run 4 AWG battery cable + separate ground
#   [ ] Add fusible link or ANL fuse within 18 inches of battery positive
#   [ ] **CUTOFF SWITCH MUST BE 4-POST (e.g. Moroso 74108)** -- NOT a 2-post switch.
#       A standard 2-post switch only disconnects the battery; with an alternator present
#       the car will not actually shut off because the alternator keeps producing current.
#       The Moroso 74108 4-post loops the alternator through the switch:
#         Posts 1/2 (bottom) = Battery IN + Alternator IN
#         Posts 3/4 (top)    = Output to loads + Alternator charge loop back to battery
#       When switch is OFF: both battery AND alternator are disconnected simultaneously.
#       Source: StreetCarJoe Race Car Wiring Series Pt.2 (youtube.com/watch?v=PNyScqftGQw)
#
#   GROUND STRATEGY -- TWO SEPARATE LEADS OFF BATTERY NEGATIVE:
#   [x] Lead 1: Battery negative → chassis stud (engine bay) -- 4 AWG welding cable
#   [x] Lead 2: Battery negative → engine block directly -- 4 AWG welding cable (DEDICATED)
#       *** Do NOT rely on engine→chassis→battery chain. Run a direct cable from battery
#           negative terminal all the way up to the engine block. This eliminates the
#           vast majority of race-car electrical issues. Keep the chassis lead as well --
#           you want both, not one or the other. ***
#       Source: StreetCarJoe Race Car Wiring Series Pt.2 (youtube.com/watch?v=PNyScqftGQw)
#   [ ] Separate cylinder head ground strap (head → chassis or head → battery) -- for
#       coil packs: each bank of coils needs a secondary ground to the cylinder head
#       (in addition to the main coil power/GND running directly to the battery).
#   [ ] E36 has known ground issues -- run all new straps, do not rely on OEM
#
#   ECU AND COIL POWER/GROUND -- MUST GO DIRECTLY TO BATTERY TERMINALS:
#   [ ] MaxxECU main power (relay output) and ECU GND must connect to battery
#       terminals (or ANL fuse stud close to battery), NOT to a distribution block
#       or chassis star point. Using a shared distro block causes ground offsets
#       that manifest as sensor drift and ignition noise.
#       Source: StreetCarJoe Race Car Wiring Series Pt.2 (youtube.com/watch?v=PNyScqftGQw)
#   [ ] Coil pack power and GND: same rule -- run directly to battery. Do not share
#       with body electrical distribution. Coil secondary grounds go to cylinder head.
#
#   FUEL PUMP:
#   [ ] Confirm pump model (OEM Bosch vs Walbro 255 vs AEM 320)
#   [ ] Walbro 255 draws ~8A max :: 15A fuse is correct
#   [ ] AEM 340 draws up to 12A :: use 20A fuse
#
#   FAN:
#   [ ] Confirm SPAL fan model -- single speed vs PWM
#   [ ] Single-speed SPAL 30102049 (12-inch puller): 15A draw :: 20A fuse
#   [ ] Phase 2: swap to PWM SPAL, wire GPO 6 direct for variable speed
#
#   ECU MAIN RELAY:
#   [ ] MaxxECU Race has its own power relay -- confirm if external relay
#       is also needed or if ECU handles this internally
#   [ ] See maxxecu.com/webhelp/wirings-power_supply.html

# ── Connectors ─────────────────────────────────────────────────────────────────

connectors:

  # ── Battery ────────────────────────────────────────────────────────────────
  BATT_POS:
    type: "Battery positive terminal"
    subtype: "12V lead-acid or AGM"
    pincount: 1
    pinlabels: ["+12V BATT"]
    notes: >-
      TODO: confirm battery location and cable run length.
      E36 stock location is driver-side footwell -- long cable run.
      Many builds relocate battery to engine bay or trunk for weight.
      Positive goes to CUTOFF_4POST battery-in post first.

  BATT_NEG:
    type: "Battery negative terminal"
    subtype: "12V lead-acid or AGM"
    pincount: 2
    pinlabels: ["BATT GND → chassis stud", "BATT GND → engine block (direct)"]
    notes: >-
      TWO separate leads from battery negative terminal:
      Pin 1: 4 AWG welding cable → chassis stud (engine bay) -- W_BATT_NEG_CHASSIS
      Pin 2: 4 AWG welding cable → engine block directly -- W_BATT_NEG_ENGINE (dedicated run)
      Do NOT rely on engine-block-to-chassis strap to complete the battery ground path.
      Run both leads. Ring lug both ends. Welding cable preferred (EWCS 4 AWG or equiv).

  # ── 4-post battery cutoff switch ────────────────────────────────────────────
  CUTOFF_4POST:
    type: "4-post battery cutoff switch -- Moroso 74108 or equiv"
    subtype: "Required for alternator-equipped builds -- 2-post switch insufficient"
    pincount: 4
    pinlabels:
      - "Batt IN (from BATT_POS)"
      - "Alt IN (from alternator B+)"
      - "Output (to main ANL fuse → loads)"
      - "Alt charge loop (charges battery via alt when switch ON)"
    notes: >-
      MUST be a 4-post switch, NOT a 2-post. On an alternator-equipped car a 2-post
      cutoff only disconnects the battery; the alternator continues to power the car
      and the engine will not shut off. The Moroso 74108 4-post simultaneously
      disconnects battery AND alternator when switched OFF -- the only safe approach.
      How it works (Moroso 74108):
        ON:  Battery IN + Alt IN both connected to Output. Alt charge loop closes =
             alternator charges battery normally. Car runs from battery + alternator.
        OFF: All four posts open. Battery and alternator both disconnected.
             Car dies immediately. Safe for use as kill switch.
      Mount in accessible location (driver reach or HPDE-required external pull).
      Reference: StreetCarJoe Race Car Wiring Series Pt.3 (youtube.com/watch?v=l59_-01VgEc)
      and Pt.2 (youtube.com/watch?v=PNyScqftGQw)
      Part: Moroso 74108 (standard), or Longacre or equivalent 4-post racing cutoff.

  # ── Engine block ground (direct from battery negative) ──────────────────────
  ENGINE_BLOCK_GND:
    type: "Engine block ground stud"
    subtype: "M8 bolt -- existing block boss or welded stud"
    pincount: 1
    pinlabels: ["ENGINE BLOCK GND"]
    notes: >-
      Direct 4 AWG welding cable from battery negative terminal to engine block.
      This is a SEPARATE lead from the chassis ground -- do NOT merge these.
      Run both: battery→chassis AND battery→engine block (two cables, both 4 AWG).
      Ring lug both ends. Clean ground contact (no paint under lug).
      This eliminates the majority of race-car electrical noise/ground-offset issues.
      Separate from the M52 head-to-chassis strap (which stays in place for EMC).
      Reference: StreetCarJoe Race Car Wiring Series Pt.2 (youtube.com/watch?v=PNyScqftGQw)

  # ── Main fuse (close to battery) ───────────────────────────────────────────
  MAIN_FUSE:
    type: "Inline ANL or MAXI fuse holder"
    subtype: "TODO: size -- likely 60-80A"
    pincount: 2
    pinlabels: ["In (from CUTOFF_4POST output)", "Out (to fuse block)"]
    notes: >-
      Must be mounted within 18 inches of battery positive terminal / cutoff switch output.
      Power path: BATT_POS → CUTOFF_4POST → MAIN_FUSE → FUSE_BLOCK.
      Protects entire power distribution loom from dead short.
      TODO: size after summing all fused circuit loads with 20% headroom.
      Blue Sea 5191 (MRBF) or equivalent.
      Product: https://www.bluesea.com/products/5191/MRBF_Terminal_Fuse_Block_-_30_to_300A

  # ── Chassis ground stud ────────────────────────────────────────────────────
  CHASSIS_GND:
    type: "Chassis ground stud"
    subtype: "M8 engine bay stud"
    pincount: 1
    pinlabels: ["GND"]
    notes: >-
      Primary battery negative lead terminates here. Relay board GND, body electrics,
      and fan/pump returns terminate here.
      E36 engine bay ground stud is on the strut tower or firewall.
      TODO: confirm exact stud location for this car.
      Keep M52 factory engine block-to-chassis bonding strap -- it provides the
      starter/alternator current return path from engine back to battery via chassis.
      Verify it is clean (no paint under lug, star washer, tight nut).

  # ── Ignition-switched +12V source ─────────────────────────────────────────
  IGN_12V_SOURCE:
    type: "Ignition-switched +12V"
    subtype: "From ignition switch or X20 -- TODO confirm pin"
    pincount: 1
    pinlabels: ["+12V IGN"]
    notes: >-
      TODO: confirm which ignition switch terminal or X20 pin carries
      key-on switched +12V for this RHD car.
      On E36, the ignition switch (pin 15) provides switched +12V.
      May be accessible at the fuse box or tapped from X20.
      Wire gauge: 12 AWG to relay coil fuses.

  # ── Fuse block ─────────────────────────────────────────────────────────────
  FUSE_BLOCK:
    type: "Mini blade fuse block"
    subtype: "10-position -- TODO: source block"
    pincount: 10
    pinlabels:
      - "F1: ECU logic (10A)"
      - "F2: Coil+Inj relay coil (5A)"
      - "F3: Radiator fan relay coil (5A)"
      - "F4: Fuel pump SSR ctrl (5A)"
      - "F5: Coil+Inj load feed (20A)"
      - "F6: Radiator fan load feed (20A)"
      - "F7: Fuel pump load feed (25A)"
      - "F8: Spare / accessories (10A)"
      - "F9: EWP relay coil (5A)"
      - "F10: AC relay coil (5A)"
    notes: >-
      Pins 1-4, 10 powered by IGN-switched +12V (relay coil circuits).
      Pins 5-7 powered by battery +12V via main fuse (relay load circuits).
      Pin 9 powered by battery +12V (EWP coil -- must be BATT+ for post-shutdown cooling).
      Relays switch the load circuits -- the fuses here protect the wires.
      F9 (EWP coil): 18 AWG to ewp-controller.wv MAIN_RELAY pin 86. BATT+ so MaxxECU
      power-hold relay can keep pump running after key-off until CLT below 70 deg C.
      F10 (AC coil): 18 AWG to ac-compressor.wv AC_RELAY pin 86.
      F4 (Fuel pump SSR ctrl): 18 AWG to fuel-pump-hanger.wv SSR Ctrl(+).
      TODO: confirm fuse block part. Options: Blue Sea ST Blade (5025),
      Bussmann 15600, or a pre-made relay+fuse combo block (10-pos).

  # ── Relay board ────────────────────────────────────────────────────────────
  # Standard Bosch ISO mini relay (5-pin):
  #   85 -- coil negative (pulled to GND to activate)
  #   86 -- coil positive (+12V IGN to energize)
  #   30 -- common / power input (from fused battery +12V)
  #   87 -- normally open (NO) contact -- load output when relay is ON
  #   87a -- normally closed (NC) contact -- load output when relay is OFF
  #
  # MaxxECU GPOs are low-side switches (they pull to GND).
  # So: 86 = +12V IGN (constant), 85 = ECU GPO (switches to GND).
  #
  # Flyback suppression: mount 1N4007 diode across each relay coil at the relay socket.
  #   Cathode (banded end) → pin 86 (+12V side)
  #   Anode → pin 85 (GND/GPO side)
  # Bosch 0 332 002 150 has no built-in suppression (type 1). External diode required.

  RELAY_ECU_MAIN:
    type: "Bosch ISO mini relay"
    subtype: "12V coil / 30A contacts"
    pincount: 5
    pinlabels:
      - "85 (coil-)"
      - "86 (coil+)"
      - "30 (batt+)"
      - "87 (NO load out)"
      - "87a (NC -- unused)"
    notes: >-
      ECU logic power relay.
      Coil: 86 from IGN +12V (F1), 85 to chassis GND.
      Load: 30 from fused batt+, 87 to MaxxECU 12-pin pin 7 (+12V ECU logic).
      Keeps ECU unpowered when ignition is off.
      TODO: MaxxECU Race may handle main relay internally -- verify
      whether this external relay is required. See maxxecu.com/webhelp
      section on power supply wiring.
      Part: Bosch 0332019150 or Tyco V23134 or equivalent.
      Flyback: 1N4007 across coil at relay socket (cathode to pin 86, anode to pin 85).

  RELAY_COIL_INJ:
    type: "Bosch ISO mini relay"
    subtype: "12V coil / 30A contacts"
    pincount: 5
    pinlabels:
      - "85 (coil-)"
      - "86 (coil+)"
      - "30 (batt+)"
      - "87 (NO load out)"
      - "87a (NC -- unused)"
    notes: >-
      Coil pack and injector supply relay.
      Coil: 86 from IGN +12V (F2), 85 to chassis GND.
      Load: 30 from fused batt+ (F5 20A), 87 to coil+inj +12V rail.
      Output feeds MaxxECU 12-pin pin 1 (+12V coil/injector supply).
      TODO: confirm whether this relay is triggered by IGN directly
      or by a dedicated ECU relay output. MaxxECU Race has a relay
      drive output -- check wiring PDF.
      Wire gauge: 12 AWG on load side.
      Flyback: 1N4007 across coil at relay socket (cathode to pin 86, anode to pin 85).

  RELAY_FAN:
    type: "Bosch ISO mini relay"
    subtype: "12V coil / 30A contacts"
    pincount: 5
    pinlabels:
      - "85 (coil-)"
      - "86 (coil+)"
      - "30 (batt+)"
      - "87 (NO load out)"
      - "87a (NC -- unused)"
    notes: >-
      Radiator fan relay.
      Coil: 86 from IGN +12V (F3), 85 from MaxxECU GPO 6 (12-pin pin 6).
      Load: 30 from fused batt+ (F6), 87 to SPAL fan motor positive.
      Fan motor negative to chassis GND.
      MaxxECU pulls 85 to GND to energize relay and spin fan.
      TODO: confirm SPAL fan model and current draw.
      TODO: Phase 2 upgrade -- SPAL PWM fan wired direct from GPO 6,
      relay no longer needed. Check SPAL PWM wiring instructions.
      Flyback: 1N4007 across coil at relay socket (cathode to pin 86, anode to pin 85).

  FUEL_PUMP_SSR:
    type: "Crydom D1D40 DC solid-state relay (SSR)"
    subtype: "3-32V ctrl / 40A load -- replaces mechanical relay for PWM control"
    pincount: 4
    pinlabels:
      - "Ctrl+ (from fuse F4 IGN +12V)"
      - "Ctrl- (MaxxECU GPO 2 -- low-side sink)"
      - "Load+ (from fused BATT+ to pump positive)"
      - "Load- (to pump positive -- switched output)"
    notes: >-
      DC SSR replaces mechanical relay -- enables PWM speed control of Walbro
      F90000267 via MaxxECU GPO. See harnesses/fuel-pump-hanger.wv for full
      Radium 20-1170 hanger pinout and hanger connector details.
      Ctrl+ from fuse F4 (IGN-switched). Ctrl- from MaxxECU GPO 2 (pin 3).
      Load side: 8 AWG from fused BATT+, output to pump positive stud.
      Do NOT use with a mechanical relay -- SSR only. Fuse F7 updated to 25A
      (Walbro F90000267 max draw is ~20A at 13.5V under max load).
      Mount SSR to metal bracket for heat sinking -- dissipates ~1W/A at load.

  # ── Condenser fan relay (AC system) ────────────────────────────────────────
  RELAY_CONDENSER_FAN:
    type: "Bosch ISO mini relay"
    subtype: "12V coil / 30A contacts"
    pincount: 4
    pinlabels:
      - "85 (coil- :: chassis GND)"
      - "86 (coil+ :: AC relay coil tap)"
      - "30 (batt+ :: fused from BATT_POS)"
      - "87 (NO load out :: condenser fan motor +)"
    notes: >-
      Condenser fan relay for AC system. Required -- AC compressor inverter
      controller will not enable without condenser fan present.
      Coil pin 86: tapped from AC relay coil wire (after AC switch) so
      condenser fan turns on simultaneously with compressor.
      Coil pin 85: chassis GND.
      Load: dedicated fused BATT+ run (inline 20A fuse, 12 AWG).
      Output to condenser fan motor +. Fan motor GND to chassis.
      Flyback: 1N4007 across coil at relay socket (cathode to pin 86, anode to pin 85).
      If radiator and condenser share one dual-purpose fan: wire this relay
      output in parallel with RELAY_FAN output -- verify fan can handle
      combined thermal load before doing so.
      TODO: confirm condenser fan model (SPAL or equivalent slimline).
      TODO: confirm whether radiator fan and condenser fan are the same unit.

  # ── Load stubs ─────────────────────────────────────────────────────────────
  ECU_POWER_STUBS:
    type: "MaxxECU Race 12-pin power stub"
    subtype: "Cross-reference maxxecu-m52.wv ECU_12PIN"
    pincount: 2
    pinlabels: ["Pin 1 (+12V coil/inj)", "Pin 7 (+12V ECU logic)"]
    notes: >-
      Both power pins must be supplied.
      Pin 1: coil and injector supply -- from RELAY_COIL_INJ output.
      Pin 7: ECU logic supply -- from RELAY_ECU_MAIN output.
      See maxxecu-m52.wv for full 12-pin connector wiring.
      *** GROUND CRITICAL: MaxxECU GND pins (power GND and sensor GND) must run
          directly to battery negative terminal -- not to chassis star point.
          Using a chassis intermediate ground causes ground offsets that manifest
          as sensor drift and ignition noise at high RPM.
          Reference: StreetCarJoe Race Car Wiring Series Pt.2 (youtu.be/PNyScqftGQw) ***
      *** COIL SECONDARY GROUND: Ignition coil packs need a secondary GND to the
          cylinder head (one per coil bank) in addition to the main coil power/GND
          running to the battery. Do not skip or merge with sensor ground path. ***

  FAN_MOTOR:
    type: "Radiator fan motor"
    subtype: "TODO: SPAL model -- 2-pin"
    pincount: 2
    pinlabels: ["+12V", "GND"]
    notes: >-
      TODO: confirm SPAL fan model and connector.
      Puller vs pusher depends on radiator position.
      Common choice: SPAL 30102049 (12-inch puller, 15A).
      For PWM: SPAL 30102057 + wire GPO 6 direct (no relay needed).

  CONDENSER_FAN:
    type: "Condenser fan motor"
    subtype: "TODO: SPAL slimline or equivalent -- 2-pin"
    pincount: 2
    pinlabels: ["+12V (from relay 87)", "GND"]
    notes: >-
      AC condenser fan. Mounts in front of or behind AC condenser.
      Must run whenever AC compressor is active.
      TODO: confirm model. SPAL 30102049 (12-inch) or slimline equivalent.
      GND to chassis ground stud. +12V from RELAY_CONDENSER_FAN pin 87.

  # ── ECU GPO cross-references (from maxxecu-m52.wv) ────────────────────────
  # These are not physical connectors on the power board -- they represent
  # the wire coming from the ECU 12-pin connector to the relay coil.
  ECU_GPO_FAN:
    type: "MaxxECU GPO 6 trigger"
    subtype: "12-pin pin 6 -- see maxxecu-m52.wv"
    pincount: 1
    pinlabels: ["GPO 6 (fan trigger)"]
    notes: >-
      Low-side switch output. Pulls relay pin 85 to GND when fan is commanded.
      Defined in maxxecu-m52.wv W_FAN cable.

  ECU_GPO_PUMP:
    type: "MaxxECU GPO 2 trigger (PWM)"
    subtype: "12-pin pin 3 -- see maxxecu-m52.wv"
    pincount: 1
    pinlabels: ["GPO 2 PWM (SSR Ctrl-"]
    notes: >-
      PWM low-side switch output. Controls Crydom D1D40 SSR Ctrl- for
      variable-speed fuel pump (Walbro F90000267 via Radium 20-1170 hanger).
      65% idle / 100% WOT+boost. Defined in maxxecu-m52.wv W_FUELPUMP cable.
      See harnesses/fuel-pump-hanger.wv for full SSR and hanger wiring.

  # ── External harness stubs (cross-reference only) ────────────────────────────
  EWP_RELAY_COIL_STUB:
    type: "Stub: EWP relay coil pin 86"
    subtype: "See harnesses/ewp-controller.wv MAIN_RELAY -- this is the far end of W_EWP_RELAY_86"
    pincount: 1
    pinlabels: ["86 (coil+ in ewp-controller.wv)"]
    notes: >-
      Physical wire terminates at MAIN_RELAY pin 86 in ewp-controller.wv.
      18 AWG, red. Fuse F9 (5A, BATT+) protects this coil feed.
      BATT+ source (not IGN) required -- MaxxECU power-hold keeps ECU alive post key-off
      and commands EWP via GPO until CLT below 70 deg C. IGN-switched would cut pump immediately.

  AC_RELAY_COIL_STUB:
    type: "Stub: AC relay coil pin 86"
    subtype: "See harnesses/ac-compressor.wv AC_RELAY -- this is the far end of W_AC_RELAY_86"
    pincount: 1
    pinlabels: ["86 (coil+ in ac-compressor.wv)"]
    notes: >-
      Physical wire terminates at AC_RELAY pin 86 in ac-compressor.wv.
      18 AWG, red. Fuse F10 (5A) protects this coil feed.

  RADIUM_HANGER_STUB:
    type: "Stub: Radium 20-1170 hanger pump stud"
    subtype: "See harnesses/fuel-pump-hanger.wv -- SSR Load- output"
    pincount: 1
    pinlabels: ["Pump+ stud (Radium hanger)"]
    notes: >-
      SSR Load- (switched output) connects to pump positive stud on
      Radium 20-1170 hanger. See fuel-pump-hanger.wv for full hanger
      connector wiring, sender, and return.

  # ── AC system cross-reference (from ac-compressor.wv) ──────────────────────
  AC_SWITCH_TAP:
    type: "AC enable signal tap -- from ac-compressor.wv AC_SWITCH pin 2"
    subtype: "Junction at AC switch output -- see ac-compressor.wv"
    pincount: 1
    pinlabels: ["AC switch output (+12V IGN when AC on)"]
    notes: >-
      This wire runs from the AC cabin switch output (after the switch,
      before relay coil) to RELAY_CONDENSER_FAN coil pin 86.
      When AC switch is on: energizes both the AC main relay coil (in
      ac-compressor.wv) AND the condenser fan relay coil here.
      Ensures condenser fan runs whenever compressor runs.
      Cross-reference ac-compressor.wv AC_SWITCH and AC_RELAY.


# ── Cables ─────────────────────────────────────────────────────────────────────

cables:

  # ── Main power path ─────────────────────────────────────────────────────────
  W_BATT_POS_TO_CUTOFF:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V batt → cutoff"]
    notes: "4 AWG welding cable (EWCS). Red. Battery positive terminal → CUTOFF_4POST batt-in post. Ring lug both ends. Keep run short -- cutoff should be near battery."

  W_CUTOFF_TO_ANL:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V cutoff out → ANL"]
    notes: "4 AWG welding cable. Red. CUTOFF_4POST output post → MAIN_FUSE input. ANL fuse within 18 in of cutoff switch output. Ring lug both ends."

  W_BATT_POS_MAIN:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V fused batt"]
    notes: "Superseded -- was direct BATT_POS → MAIN_FUSE. Now routed through CUTOFF_4POST. See W_BATT_POS_TO_CUTOFF + W_CUTOFF_TO_ANL."

  W_BATT_NEG_CHASSIS:
    wirecount: 1
    colors: [BK]
    wirelabels: ["batt GND → chassis"]
    notes: "4 AWG welding cable (EWCS). Black. Battery negative terminal → chassis stud (engine bay). Ring lug both ends. One of TWO ground leads from battery negative."

  W_BATT_NEG_ENGINE:
    wirecount: 1
    colors: [BK]
    wirelabels: ["batt GND → engine block (direct)"]
    notes: >-
      4 AWG welding cable (EWCS). Black. Battery negative terminal → engine block
      ground stud directly. Ring lug both ends. SEPARATE from chassis lead.
      This is the critical direct-to-battery ground that eliminates ground offset
      and electrical noise. Do NOT merge with W_BATT_NEG_CHASSIS at either end.
      Route through cabin or alongside fuel pump run. P-clamp every 12 inches.
      Reference: StreetCarJoe Race Car Wiring Series Pt.2 (youtu.be/PNyScqftGQw)

  W_MAIN_TO_FUSE_BLOCK:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V fused batt"]
    notes: "TODO: 8-10 AWG from ANL fuse output to fuse block batt+ rail."

  # ── IGN switched feed to fuse block ────────────────────────────────────────
  W_IGN_FEED:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V IGN"]
    notes: "12 AWG. IGN-switched +12V from ignition switch to fuse block IGN rail."

  # ── Relay coil pin 86 feeds (+12V IGN from fuse block) ──────────────────────
  # Each relay gets its own wire. 18 AWG is sufficient for coil current (~150-200mA).
  W_ECU_RELAY_86:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V IGN (86)"]
    notes: "Fuse F1 :: RELAY_ECU_MAIN pin 86. 18 AWG."

  W_COIL_INJ_RELAY_86:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V IGN (86)"]
    notes: "Fuse F2 :: RELAY_COIL_INJ pin 86. 18 AWG."

  W_FAN_RELAY_86:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V IGN (86)"]
    notes: "Fuse F3 :: RELAY_FAN pin 86. 18 AWG."

  W_PUMP_SSR_CTRL_POS:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V IGN (SSR Ctrl+)"]
    notes: "Fuse F4 :: FUEL_PUMP_SSR Ctrl+. 18 AWG. IGN-switched supply for SSR control circuit."

  W_EWP_RELAY_86:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V BATT (86)"]
    notes: "Fuse F9 (BATT+) :: EWP relay coil pin 86 (in ewp-controller.wv MAIN_RELAY). 18 AWG. BATT+ enables post-shutdown cooling via MaxxECU power-hold."

  W_AC_RELAY_86:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V IGN (86)"]
    notes: "Fuse F10 :: AC relay coil pin 86 (in ac-compressor.wv AC_RELAY). 18 AWG."

  W_CONDENSER_FAN_RELAY_86:
    wirecount: 1
    colors: [RD]
    wirelabels: ["AC switch tap (86)"]
    notes: "AC_SWITCH_TAP :: RELAY_CONDENSER_FAN pin 86. 18 AWG. Same signal as AC main relay coil."

  W_CONDENSER_FAN_LOAD:
    wirecount: 1
    colors: [RD]
    wirelabels: ["fan +12V (87)"]
    notes: "Inline 20A fuse from BATT+ :: RELAY_CONDENSER_FAN pin 30. 12 AWG."

  W_CONDENSER_FAN_OUT:
    wirecount: 1
    colors: [RD]
    wirelabels: ["condenser fan +12V"]
    notes: "RELAY_CONDENSER_FAN pin 87 :: CONDENSER_FAN pin 1. 12 AWG."

  W_CONDENSER_FAN_GND:
    wirecount: 1
    colors: [BK]
    wirelabels: ["condenser fan GND"]
    notes: "CONDENSER_FAN pin 2 :: chassis GND. 12 AWG."

  W_CONDENSER_FAN_RELAY_85:
    wirecount: 1
    colors: [BK]
    wirelabels: ["coil GND (85)"]
    notes: "RELAY_CONDENSER_FAN pin 85 :: chassis GND. 18 AWG."

  # ── Relay coil pin 85 GND (for ECU main and coil/inj -- straight to chassis GND)
  # Fan and pump relay pin 85 comes from ECU GPO (defined below).
  W_ECU_RELAY_85_GND:
    wirecount: 1
    colors: [BK]
    wirelabels: ["coil GND (85)"]
    notes: "RELAY_ECU_MAIN pin 85 :: chassis GND. 18 AWG."

  W_COIL_INJ_RELAY_85_GND:
    wirecount: 1
    colors: [BK]
    wirelabels: ["coil GND (85)"]
    notes: "RELAY_COIL_INJ pin 85 :: chassis GND. 18 AWG."

  # ── ECU GPO trigger wires (cross-reference to maxxecu-m52.wv) ───────────────
  W_GPO6_FAN_TRIGGER:
    wirecount: 1
    colors: [GN]
    wirelabels: ["GPO 6 (85)"]
    notes: "MaxxECU 12-pin pin 6 :: RELAY_FAN pin 85. 18 AWG. Low-side switch (pulls to GND)."

  W_GPO2_PUMP_TRIGGER:
    wirecount: 1
    colors: [GN]
    wirelabels: ["GPO 2 (85)"]
    notes: "MaxxECU 12-pin pin 3 :: FUEL_PUMP_SSR Ctrl-. 18 AWG. Low-side PWM switch."

  # ── Relay load feeds (fused batt+ to relay pin 30) ──────────────────────────
  W_COIL_INJ_LOAD_FEED:
    wirecount: 1
    colors: [RD]
    wirelabels: ["batt+ (30)"]
    notes: "Fuse F5 (20A) :: RELAY_COIL_INJ pin 30. 12 AWG."

  W_FAN_LOAD_FEED:
    wirecount: 1
    colors: [RD]
    wirelabels: ["batt+ (30)"]
    notes: "Fuse F6 (20A) :: RELAY_FAN pin 30. 12 AWG."

  W_PUMP_LOAD_FEED:
    wirecount: 1
    colors: [RD]
    wirelabels: ["batt+ (30)"]
    notes: "Fuse F7 (25A) :: FUEL_PUMP_SSR Load+. 12 AWG. (F90000267 draws 14.1A max -- 8 AWG oversized from old pump spec)"

  # ── Relay outputs to loads (relay pin 87 :: load positive) ─────────────────
  W_ECU_MAIN_RELAY_OUT:
    wirecount: 1
    colors: [RD]
    wirelabels: ["ECU logic +12V (87)"]
    notes: "RELAY_ECU_MAIN pin 87 :: ECU 12-pin pin 7. 16 AWG."

  W_COIL_INJ_RELAY_OUT:
    wirecount: 1
    colors: [RD]
    wirelabels: ["coil+inj +12V (87)"]
    notes: "RELAY_COIL_INJ pin 87 :: ECU 12-pin pin 1. 12 AWG."

  W_FAN_POS:
    wirecount: 1
    colors: [RD]
    wirelabels: ["fan +12V (87)"]
    notes: "RELAY_FAN pin 87 :: FAN_MOTOR pin 1. 12 AWG."

  W_FAN_GND:
    wirecount: 1
    colors: [BK]
    wirelabels: ["fan GND"]
    notes: "FAN_MOTOR pin 2 :: chassis GND. 12 AWG. Return current path."

  W_PUMP_POS:
    wirecount: 1
    colors: [RD]
    wirelabels: ["pump +12V (SSR out)"]
    notes: "FUEL_PUMP_SSR Load- (switched output) :: RADIUM_HANGER_STUB (pump+). 12 AWG. (F90000267 14.1A max)"

  # W_PUMP_GND removed -- pump GND is handled within fuel-pump-hanger.wv


# ── Connections ─────────────────────────────────────────────────────────────────
# Format: connector -- cable -- connector (must strictly alternate)
# Every connection must have the same pin count on both connector ends.

connections:

  # ── Main power path: BATT+ → 4-post cutoff → ANL fuse → fuse block ──────────
  - - BATT_POS: [1]
    - W_BATT_POS_TO_CUTOFF: [1]
    - CUTOFF_4POST: [1]

  - - CUTOFF_4POST: [3]
    - W_CUTOFF_TO_ANL: [1]
    - MAIN_FUSE: [1]

  - - MAIN_FUSE: [2]
    - W_MAIN_TO_FUSE_BLOCK: [1]
    - FUSE_BLOCK: [5]

  # ── Battery negative: two separate leads ─────────────────────────────────────
  # Lead 1: battery → chassis stud (relay board GND, body returns, fan/pump GND)
  - - BATT_NEG: [1]
    - W_BATT_NEG_CHASSIS: [1]
    - CHASSIS_GND: [1]

  # Lead 2: battery → engine block directly (ECU GND, coil GND reference, sensor GND)
  - - BATT_NEG: [2]
    - W_BATT_NEG_ENGINE: [1]
    - ENGINE_BLOCK_GND: [1]

  # ── IGN feed to fuse block ───────────────────────────────────────────────────
  - - IGN_12V_SOURCE: [1]
    - W_IGN_FEED: [1]
    - FUSE_BLOCK: [1]

  # ── Relay coil pin 86 (+12V IGN from fuse block) ─────────────────────────────
  - - FUSE_BLOCK: [1]
    - W_ECU_RELAY_86: [1]
    - RELAY_ECU_MAIN: [2]

  - - FUSE_BLOCK: [2]
    - W_COIL_INJ_RELAY_86: [1]
    - RELAY_COIL_INJ: [2]

  - - FUSE_BLOCK: [3]
    - W_FAN_RELAY_86: [1]
    - RELAY_FAN: [2]

  - - FUSE_BLOCK: [4]
    - W_PUMP_SSR_CTRL_POS: [1]
    - FUEL_PUMP_SSR: [1]

  - - FUSE_BLOCK: [9]
    - W_EWP_RELAY_86: [1]
    - EWP_RELAY_COIL_STUB: [1]

  - - FUSE_BLOCK: [10]
    - W_AC_RELAY_86: [1]
    - AC_RELAY_COIL_STUB: [1]

  # ── Relay coil pin 85 GND (ECU main and coil/inj go straight to GND) ─────────
  - - CHASSIS_GND: [1]
    - W_ECU_RELAY_85_GND: [1]
    - RELAY_ECU_MAIN: [1]

  - - CHASSIS_GND: [1]
    - W_COIL_INJ_RELAY_85_GND: [1]
    - RELAY_COIL_INJ: [1]

  # ── Fan and pump relay coil pin 85 from ECU GPO ──────────────────────────────
  - - ECU_GPO_FAN: [1]
    - W_GPO6_FAN_TRIGGER: [1]
    - RELAY_FAN: [1]

  - - ECU_GPO_PUMP: [1]
    - W_GPO2_PUMP_TRIGGER: [1]
    - FUEL_PUMP_SSR: [2]

  # ── Relay load inputs (fused batt+ to relay pin 30) ──────────────────────────
  - - FUSE_BLOCK: [5]
    - W_COIL_INJ_LOAD_FEED: [1]
    - RELAY_COIL_INJ: [3]

  - - FUSE_BLOCK: [6]
    - W_FAN_LOAD_FEED: [1]
    - RELAY_FAN: [3]

  - - FUSE_BLOCK: [7]
    - W_PUMP_LOAD_FEED: [1]
    - FUEL_PUMP_SSR: [3]

  # ── Relay outputs to loads ────────────────────────────────────────────────────
  - - RELAY_ECU_MAIN: [4]
    - W_ECU_MAIN_RELAY_OUT: [1]
    - ECU_POWER_STUBS: [2]

  - - RELAY_COIL_INJ: [4]
    - W_COIL_INJ_RELAY_OUT: [1]
    - ECU_POWER_STUBS: [1]

  - - RELAY_FAN: [4]
    - W_FAN_POS: [1]
    - FAN_MOTOR: [1]

  - - CHASSIS_GND: [1]
    - W_FAN_GND: [1]
    - FAN_MOTOR: [2]

  - - FUEL_PUMP_SSR: [4]
    - W_PUMP_POS: [1]
    - RADIUM_HANGER_STUB: [1]

  # ── Condenser fan relay connections ──────────────────────────────────────────────────
  - - BATT_POS: [1]
    - W_CONDENSER_FAN_LOAD: [1]
    - RELAY_CONDENSER_FAN: [3]

  - - AC_SWITCH_TAP: [1]
    - W_CONDENSER_FAN_RELAY_86: [1]
    - RELAY_CONDENSER_FAN: [2]

  - - CHASSIS_GND: [1]
    - W_CONDENSER_FAN_RELAY_85: [1]
    - RELAY_CONDENSER_FAN: [1]

  - - RELAY_CONDENSER_FAN: [4]
    - W_CONDENSER_FAN_OUT: [1]
    - CONDENSER_FAN: [1]

  - - CHASSIS_GND: [1]
    - W_CONDENSER_FAN_GND: [1]
    - CONDENSER_FAN: [2]
