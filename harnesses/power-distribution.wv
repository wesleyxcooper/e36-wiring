metadata:
  project: E36 Restomod -- Power Distribution
  description: >-
    Ecumaster PMU16 power management unit replaces relay board, fuse block,
    and DC SSR from earlier design. PMU16 provides 16 programmable MOSFET
    high-side outputs with per-channel digital fusing, current monitoring,
    PWM capability, and CAN control from MaxxECU RACE.
    Phase 1 (M52 engine). All wire lengths are stubs -- confirm before building.
    Cross-reference harnesses/maxxecu-m52.wv for ECU CAN pin assignments.

# ── TODO list ──────────────────────────────────────────────────────────────────
#
#   PMU16 SETUP:
#   [ ] Load MaxxECU.canx template in PMU software (Ecumaster USB-CAN required)
#   [ ] Configure MaxxECU MTune: Configuration -> CAN settings -> Data transmission -> Enable
#   [ ] Set MaxxECU CAN1 speed to match PMU16 CAN2 speed (1Mbit or 500kbps)
#   [ ] Enable CAN2 software termination on PMU16 (120 ohm -- in PMU config)
#   [ ] Verify MaxxECU CAN1 has its own 120 ohm termination at ECU end
#   [ ] Confirm output channel assignments in PMU software before first run
#   [ ] Program post-shutdown EWP logic: keep O5 active after key-off until
#       CLT CAN value from MaxxECU drops below 70 deg C OR 3-min fallback timer
#
#   EWP CURRENT NOTE:
#   [ ] !! Pierburg CWA400 draws up to 35.5A nominal. Single PMU16 output is 25A max.
#       Options: (a) parallel O5 + O14 for EWP (50A combined -- PMU software supports this)
#       OR (b) keep a dedicated 40A relay with PMU16 O5 as coil driver (O5 carries
#       only the relay coil current ~200mA, relay contacts carry 35.5A pump load).
#       Confirm with ewp-controller.wv actual steady-state draw before choosing.
#       If paralleling outputs: update connections section to add second output wire.
#
#   BATTERY / CUTOFF SWITCH:
#   [ ] Confirm battery location (stock E36 = driver footwell OR engine bay)
#   [ ] If trunk or footwell: run 4 AWG battery cable + separate ground
#   [ ] Add ANL or MAXI fuse within 18 inches of battery positive
#   [ ] **CUTOFF SWITCH MUST BE 4-POST (e.g. Moroso 74108)** -- NOT a 2-post switch.
#       A standard 2-post switch only disconnects the battery; with an alternator present
#       the car will not actually shut off because the alternator keeps producing current.
#       The Moroso 74108 4-post loops the alternator through the switch:
#         Posts 1/2 (bottom) = Battery IN + Alternator IN
#         Posts 3/4 (top)    = Output to loads + Alternator charge loop back to battery
#       When switch is OFF: both battery AND alternator are disconnected simultaneously.
#       Source: StreetCarJoe Race Car Wiring Series Pt.2 (youtube.com/watch?v=PNyScqftGQw)
#
#   GROUND STRATEGY -- TWO SEPARATE LEADS OFF BATTERY NEGATIVE:
#   [x] Lead 1: Battery negative → chassis stud (engine bay) -- 4 AWG welding cable
#   [x] Lead 2: Battery negative → engine block directly -- 4 AWG welding cable (DEDICATED)
#       *** Do NOT rely on engine→chassis→battery chain. Run a direct cable from battery
#           negative terminal all the way up to the engine block. This eliminates the
#           vast majority of race-car electrical issues. Keep the chassis lead as well --
#           you want both, not one or the other. ***
#       Source: StreetCarJoe Race Car Wiring Series Pt.2 (youtube.com/watch?v=PNyScqftGQw)
#   [ ] Separate cylinder head ground strap (head → chassis or head → battery) -- for
#       coil packs: each bank of coils needs a secondary ground to the cylinder head
#       (in addition to the main coil power/GND running directly to the battery).
#   [ ] E36 has known ground issues -- run all new straps, do not rely on OEM
#
#   ECU AND COIL POWER/GROUND -- MUST GO DIRECTLY TO BATTERY TERMINALS:
#   [ ] MaxxECU main power (PMU16 O1 output) and ECU GND must ultimately reference battery
#       terminals, NOT a chassis star point. PMU16 M6 stud connects to ANL fuse, which
#       connects directly to battery (or 4-post cutoff switch output).
#   [ ] Coil pack GND: run secondary GND from coil packs to cylinder head -- not chassis.
#       Source: StreetCarJoe Race Car Wiring Series Pt.2 (youtube.com/watch?v=PNyScqftGQw)
#
#   DOWNSTREAM HARNESS UPDATES NEEDED:
#   [ ] ewp-controller.wv: internal MAIN_RELAY is replaced by PMU16 O5 direct output.
#       Update to remove relay -- connect PMU16 O5 wire directly to CWA400 pin 3.
#       (Pending resolution of 35.5A current draw vs 25A O5 limit -- see above.)
#   [ ] fuel-pump-hanger.wv: SSR (Crydom D1D40) is replaced by PMU16 O4 PWM output.
#       Update SSR section -- PMU16 O4 wire goes directly to pump(+) stud on hanger.
#   [ ] ac-compressor.wv: AC_RELAY coil is now driven by PMU16 O7 output (low current).
#       Update coil power source reference from fuse block F10 to PMU16 O7.

# ── Connectors ─────────────────────────────────────────────────────────────────

connectors:

  # ── Battery ────────────────────────────────────────────────────────────────
  BATT_POS:
    type: "Battery positive terminal"
    subtype: "12V lead-acid or AGM"
    pincount: 1
    pinlabels: ["+12V BATT"]
    notes: >-
      TODO: confirm battery location and cable run length.
      E36 stock location is driver-side footwell -- long cable run.
      Many builds relocate battery to engine bay or trunk for weight.
      Positive goes to CUTOFF_4POST battery-in post first.

  BATT_NEG:
    type: "Battery negative terminal"
    subtype: "12V lead-acid or AGM"
    pincount: 2
    pinlabels: ["BATT GND → chassis stud", "BATT GND → engine block (direct)"]
    notes: >-
      TWO separate leads from battery negative terminal:
      Pin 1: 4 AWG welding cable → chassis stud (engine bay) -- W_BATT_NEG_CHASSIS
      Pin 2: 4 AWG welding cable → engine block directly -- W_BATT_NEG_ENGINE (dedicated run)
      Do NOT rely on engine-block-to-chassis strap to complete the battery ground path.
      Run both leads. Ring lug both ends. Welding cable preferred (EWCS 4 AWG or equiv).

  # ── 4-post battery cutoff switch ────────────────────────────────────────────
  CUTOFF_4POST:
    type: "4-post battery cutoff switch -- Moroso 74108 or equiv"
    subtype: "Required for alternator-equipped builds -- 2-post switch insufficient"
    pincount: 4
    pinlabels:
      - "Batt IN (from BATT_POS)"
      - "Alt IN (from alternator B+)"
      - "Output (to main ANL fuse → PMU16 stud)"
      - "Alt charge loop (charges battery via alt when switch ON)"
    notes: >-
      MUST be a 4-post switch, NOT a 2-post. On an alternator-equipped car a 2-post
      cutoff only disconnects the battery; the alternator continues to power the car
      and the engine will not shut off. The Moroso 74108 4-post simultaneously
      disconnects battery AND alternator when switched OFF -- the only safe approach.
      How it works (Moroso 74108):
        ON:  Battery IN + Alt IN both connected to Output. Alt charge loop closes =
             alternator charges battery normally. Car runs from battery + alternator.
        OFF: All four posts open. Battery and alternator both disconnected.
             Car dies immediately. Safe for use as kill switch.
      Mount in accessible location (driver reach or HPDE-required external pull).
      Reference: StreetCarJoe Race Car Wiring Series Pt.3 (youtube.com/watch?v=l59_-01VgEc)
      and Pt.2 (youtube.com/watch?v=PNyScqftGQw)
      Part: Moroso 74108 (standard), or Longacre or equivalent 4-post racing cutoff.

  # ── Engine block ground (direct from battery negative) ──────────────────────
  ENGINE_BLOCK_GND:
    type: "Engine block ground stud"
    subtype: "M8 bolt -- existing block boss or welded stud"
    pincount: 1
    pinlabels: ["ENGINE BLOCK GND"]
    notes: >-
      Direct 4 AWG welding cable from battery negative terminal to engine block.
      This is a SEPARATE lead from the chassis ground -- do NOT merge these.
      Run both: battery→chassis AND battery→engine block (two cables, both 4 AWG).
      Ring lug both ends. Clean ground contact (no paint under lug).
      This eliminates the majority of race-car electrical noise/ground-offset issues.
      Separate from the M52 head-to-chassis strap (which stays in place for EMC).
      Reference: StreetCarJoe Race Car Wiring Series Pt.2 (youtube.com/watch?v=PNyScqftGQw)

  # ── Main fuse (close to battery) ───────────────────────────────────────────
  MAIN_FUSE:
    type: "Inline ANL or MAXI fuse holder"
    subtype: "TODO: size -- likely 80-100A for PMU16 total load"
    pincount: 2
    pinlabels: ["In (from CUTOFF_4POST output)", "Out (to PMU16 M6 BATT+ stud)"]
    notes: >-
      Must be mounted within 18 inches of battery positive terminal / cutoff switch output.
      Power path: BATT_POS → CUTOFF_4POST → MAIN_FUSE → PMU16 M6 BATT+ stud.
      Protects entire power distribution loom from dead short.
      TODO: size after summing all PMU16 channel loads with 20% headroom.
      PMU16 has 10x 25A outputs + 6x 15A outputs; this build uses ~4x 25A + 3x 15A max.
      Estimated peak: ECU 10A + coil/inj 20A + fan 15A + pump 20A + EWP 35A = ~100A.
      Blue Sea 5191 (MRBF) or equivalent.
      Product: https://www.bluesea.com/products/5191/MRBF_Terminal_Fuse_Block_-_30_to_300A

  # ── Chassis ground stud ────────────────────────────────────────────────────
  CHASSIS_GND:
    type: "Chassis ground stud"
    subtype: "M8 engine bay stud"
    pincount: 1
    pinlabels: ["GND"]
    notes: >-
      Primary battery negative lead terminates here.
      PMU16 GND lug terminates here (W_PMU16_GND).
      Fan motor GND, condenser fan GND, and body electrical returns terminate here.
      E36 engine bay ground stud is on the strut tower or firewall.
      TODO: confirm exact stud location for this car.
      Keep M52 factory engine block-to-chassis bonding strap -- it provides the
      starter/alternator current return path from engine back to battery via chassis.
      Verify it is clean (no paint under lug, star washer, tight nut).

  # ── Ignition-switched +12V source ─────────────────────────────────────────
  IGN_12V_SOURCE:
    type: "Ignition-switched +12V"
    subtype: "From ignition switch or X20 -- TODO confirm pin"
    pincount: 1
    pinlabels: ["+12V IGN → PMU16 +12V SW"]
    notes: >-
      Feeds PMU16 pin 7 (+12V SW) -- this is the PMU16 on/off sense input.
      When IGN is ON: PMU16 activates and begins executing programmed output logic.
      When IGN is OFF: PMU16 runs post-shutdown logic (e.g. EWP cooling) then powers down.
      TODO: confirm which ignition switch terminal or X20 pin carries
      key-on switched +12V for this RHD car.
      On E36, the ignition switch (pin 15) provides switched +12V.
      May be accessible at the fuse box or tapped from X20.
      Wire gauge: 18 AWG is sufficient (PMU16 +12V SW is a signal input, very low current).

  # ── Ecumaster PMU16 Power Management Unit ─────────────────────────────────
  #
  # Physical connections:
  #   M6 BATT+ stud (body of unit): main power in from ANL fuse. Up to 150A continuous.
  #   GND lug (body of unit): chassis GND. Must be shortest possible run.
  #   39-pin Sicma/FCI connector: all signal, control, and output pins.
  #
  # Connector terminals:
  #   1.5mm (211CC2S2160P): 14-17 AWG -- use for signal/low-current pins
  #   2.8mm (211CC3S2120):  14-16 AWG -- use for medium outputs (fan, SSR ctrl)
  #   2.8mm heavy (211CC3S3120): 10-12 AWG -- use for high-current outputs (pump, EWP)
  #
  # Procurement: ecumasterusa.com ~$500 USD
  # Manual: ecumaster.com/files/PMU/PMU_Manual.pdf
  # Pinout: ecumaster.com/files/PMU/PMU-16_Pinout_v1.2.pdf
  # MaxxECU integration: ecumaster.com/files/ADU/AN/maxxEcu.pdf
  # MaxxECU.canx template: available from Ecumaster download page
  #
  PMU16:
    type: "Ecumaster PMU16 Power Management Unit"
    subtype: "39-way Sicma/FCI + M6 BATT+ stud + GND lug"
    pincount: 12
    pinlabels:
      - "BATT+ (M6 stud -- to ANL fuse output)"
      - "GND (body lug -- PHYS chassis GND)"
      - "+12V SW (PHYS pin 7 -- IGN sense)"
      - "CAN2.H (PHYS pin 24 -- MaxxECU CAN1H)"
      - "CAN2.L (PHYS pin 34 -- MaxxECU CAN1L)"
      - "O1 25A -- ECU logic power (PHYS pin 38)"
      - "O2 25A -- coil+inj supply (PHYS pin 39)"
      - "O3 25A -- radiator fan PWM (PHYS pin 26)"
      - "O4 25A -- fuel pump PWM (PHYS pin 13)"
      - "O5 25A -- EWP supply ⚠️ see TODO (PHYS pin 12)"
      - "O6 15A -- condenser fan (PHYS pin 11)"
      - "O7 15A -- AC relay coil drive (PHYS pin 10)"
    notes: >-
      PDM replaces: relay board (ECU main, coil/inj, fan, EWP, condenser relays),
      blade fuse block, and Crydom D1D40 SSR.
      No flyback diodes needed -- MOSFET outputs have integrated protection.
      Per-channel current sensing: all output currents are logged over CAN to MaxxECU.
      Post-shutdown EWP: O5 programmed to stay active after key-off until
        MaxxECU CAN CLT channel drops below 70 deg C or 3-min fallback timer.
        PMU16 M6 stud is BATT+ always (not IGN-switched), enabling this behavior.
      EWP current warning: CWA400 draws up to 35.5A. O5 is 25A rated.
        Resolve per TODO block at top of file before building.
      Spare outputs available for future: O8-O16, plus 16x analog inputs A1-A16.
      CAN1 (PHYS pins 23/35): reserved for PC programming via Ecumaster USB-CAN.
        Do NOT connect CAN1 to MaxxECU -- CAN1 is PC-only on PMU16.

  # ── MaxxECU CAN1 stub (cross-reference) ──────────────────────────────────
  MAXXECU_CAN1_STUB:
    type: "MaxxECU RACE CAN1 stub"
    subtype: "Cross-reference maxxecu-m52.wv -- CAN1H/CAN1L pins"
    pincount: 2
    pinlabels: ["CAN1H (to PMU16 CAN2.H)", "CAN1L (to PMU16 CAN2.L)"]
    notes: >-
      PMU16 CAN2 (pins 24/34) connects to MaxxECU RACE CAN1H/CAN1L.
      Twisted pair cable, 22 AWG shielded. Drain at MaxxECU end only.
      Speed: must match on both sides. PMU16 CAN2 default = 500kbps or 1Mbit
        (configure in PMU software). MaxxECU MTune: set CAN1 to same speed.
      Bus termination: 120 ohm at each end. Enable PMU16 CAN2 software
        termination in PMU config. Verify MaxxECU CAN1 has termination.
      Cross-reference: maxxecu-m52.wv for ECU CAN1 physical pin assignment.

  # ── ECU power stubs (cross-ref to maxxecu-m52.wv) ────────────────────────
  ECU_POWER_STUBS:
    type: "MaxxECU Race 12-pin power stub"
    subtype: "Cross-reference maxxecu-m52.wv ECU_12PIN"
    pincount: 2
    pinlabels: ["Pin 1 (+12V coil/inj -- from PMU16 O2)", "Pin 7 (+12V ECU logic -- from PMU16 O1)"]
    notes: >-
      Both power pins must be supplied. Previously from relay outputs -- now from PMU16.
      Pin 1: coil and injector supply -- from PMU16 O2 (25A channel).
      Pin 7: ECU logic supply -- from PMU16 O1 (25A channel).
      See maxxecu-m52.wv for full 12-pin connector wiring.
      *** GROUND CRITICAL: MaxxECU GND pins (power GND and sensor GND) must run
          directly to battery negative terminal -- not to chassis star point.
          Using a chassis intermediate ground causes ground offsets that manifest
          as sensor drift and ignition noise at high RPM.
          Reference: StreetCarJoe Race Car Wiring Series Pt.2 (youtu.be/PNyScqftGQw) ***
      *** COIL SECONDARY GROUND: Ignition coil packs need a secondary GND to the
          cylinder head (one per coil bank) in addition to the main coil power/GND
          running to the battery. Do not skip or merge with sensor ground path. ***

  # ── Fan and condenser fan load connectors ─────────────────────────────────
  FAN_MOTOR:
    type: "Radiator fan motor"
    subtype: "TODO: SPAL model -- 2-pin"
    pincount: 2
    pinlabels: ["+12V (from PMU16 O3)", "GND"]
    notes: >-
      TODO: confirm SPAL fan model and connector.
      Common choice: SPAL 30102049 (12-inch puller, 15A single-speed).
      Phase 2 upgrade: SPAL 30102057 (PWM-capable) -- PMU16 O3 PWMs directly
        to this fan, enabling variable speed control without any relay or driver.
        Update output channel assignment in PMU config (frequency, duty table).
      Fan GND to chassis GND stud (W_FAN_GND).

  CONDENSER_FAN:
    type: "Condenser fan motor"
    subtype: "TODO: SPAL slimline or equivalent -- 2-pin"
    pincount: 2
    pinlabels: ["+12V (from PMU16 O6)", "GND"]
    notes: >-
      AC condenser fan. Must run whenever AC compressor is active.
      PMU16 O6 configured to activate when MaxxECU CAN signals AC on.
      TODO: confirm model. SPAL slimline or equivalent.
      Fan GND to chassis GND stud (W_CONDENSER_FAN_GND).

  # ── External harness stubs ─────────────────────────────────────────────────
  EWP_OUTPUT_STUB:
    type: "Stub: PMU16 O5 → ewp-controller.wv CWA400 supply"
    subtype: "See harnesses/ewp-controller.wv -- replaces MAIN_RELAY"
    pincount: 1
    pinlabels: ["EWP +12V supply (from PMU16 O5)"]
    notes: >-
      PMU16 O5 output drives the EWP directly -- MAIN_RELAY in ewp-controller.wv
      is replaced. TODO: update ewp-controller.wv to remove internal relay and
      connect this wire directly to CWA400 Pin 3 (+12V supply input).
      CWA400 GND (Pin 4) still to chassis GND stud.
      ⚠️ CWA400 draws up to 35.5A nominal. PMU16 O5 is 25A max.
         Resolve per TODO block at top of file before building this run.
      Wire gauge: 10 AWG minimum (35.5A load; use 8 AWG if paralleling outputs).
      Post-shutdown cooling: PMU16 logic keeps O5 active after key-off per
        programmed CLT threshold -- no separate power-hold relay needed.

  RADIUM_HANGER_STUB:
    type: "Stub: PMU16 O4 → Radium 20-1170 hanger pump stud"
    subtype: "See harnesses/fuel-pump-hanger.wv -- replaces Crydom D1D40 SSR"
    pincount: 1
    pinlabels: ["Pump+ stud (from PMU16 O4 PWM output)"]
    notes: >-
      PMU16 O4 (25A, PWM-capable) output connects to pump positive stud on
      Radium 20-1170 hanger, replacing the Crydom D1D40 DC SSR.
      TODO: update fuel-pump-hanger.wv to remove SSR -- wire PMU16 O4 directly
        to pump+ stud. The Ctrl+/Ctrl- SSR wires to MaxxECU GPO are eliminated;
        PWM duty is now commanded by MaxxECU over CAN to PMU16 channel O4.
      Wire gauge: 12 AWG (Walbro F90000267 draws 14.1A max).
      See fuel-pump-hanger.wv for full hanger pinout and return wiring.

  AC_RELAY_COIL_STUB:
    type: "Stub: PMU16 O7 → ac-compressor.wv AC_RELAY coil pin 86"
    subtype: "See harnesses/ac-compressor.wv AC_RELAY"
    pincount: 1
    pinlabels: ["AC relay coil 86 (from PMU16 O7)"]
    notes: >-
      PMU16 O7 (15A) drives AC relay coil -- replaces fuse block F10 feed.
      Very low current (relay coil ~200mA); 18 AWG sufficient.
      TODO: update ac-compressor.wv to reference PMU16 O7 as coil power source.
      Condenser fan coil is no longer tapped from AC relay coil wire;
        PMU16 O6 drives condenser fan directly (separate channel).

  # ── AC system cross-reference ───────────────────────────────────────────────
  AC_SWITCH_TAP:
    type: "AC enable signal tap -- from ac-compressor.wv AC_SWITCH pin 2"
    subtype: "Junction at AC switch output -- see ac-compressor.wv"
    pincount: 1
    pinlabels: ["AC switch output (+12V IGN when AC on)"]
    notes: >-
      With PMU16, this tap may no longer be needed for condenser fan control.
      PMU16 O6 (condenser fan) can be activated by MaxxECU CAN AC-on signal
      rather than a hardwired tap from the AC switch output.
      Cross-reference ac-compressor.wv for AC switch wiring.
      TODO: decide whether to keep hardwired tap or use CAN logic for condenser fan.


# ── Cables ─────────────────────────────────────────────────────────────────────

cables:

  # ── Main power path ─────────────────────────────────────────────────────────
  W_BATT_POS_TO_CUTOFF:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V batt → cutoff"]
    notes: "4 AWG welding cable (EWCS). Red. Battery positive terminal → CUTOFF_4POST batt-in post. Ring lug both ends. Keep run short -- cutoff should be near battery."

  W_CUTOFF_TO_ANL:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V cutoff out → ANL"]
    notes: "4 AWG welding cable. Red. CUTOFF_4POST output post → MAIN_FUSE input. ANL fuse within 18 in of cutoff switch output. Ring lug both ends."

  W_MAIN_TO_PMU16:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V fused batt → PMU16 stud"]
    notes: "4 AWG welding cable. Red. MAIN_FUSE output → PMU16 M6 BATT+ stud. Ring lug at fuse end. M6 ring lug at PMU16 stud. Keep run as short as practical."

  # ── Battery negative: two separate leads ────────────────────────────────────
  W_BATT_NEG_CHASSIS:
    wirecount: 1
    colors: [BK]
    wirelabels: ["batt GND → chassis"]
    notes: "4 AWG welding cable (EWCS). Black. Battery negative terminal → chassis stud (engine bay). Ring lug both ends. One of TWO ground leads from battery negative."

  W_BATT_NEG_ENGINE:
    wirecount: 1
    colors: [BK]
    wirelabels: ["batt GND → engine block (direct)"]
    notes: >-
      4 AWG welding cable (EWCS). Black. Battery negative terminal → engine block
      ground stud directly. Ring lug both ends. SEPARATE from chassis lead.
      This is the critical direct-to-battery ground that eliminates ground offset
      and electrical noise. Do NOT merge with W_BATT_NEG_CHASSIS at either end.
      Route through cabin or alongside fuel pump run. P-clamp every 12 inches.
      Reference: StreetCarJoe Race Car Wiring Series Pt.2 (youtu.be/PNyScqftGQw)

  # ── PMU16 power and control wiring ──────────────────────────────────────────
  W_PMU16_GND:
    wirecount: 1
    colors: [BK]
    wirelabels: ["PMU16 GND → chassis stud"]
    notes: "4 AWG or 8 AWG welding cable. Black. PMU16 GND lug (body of unit) → chassis GND stud. Keep as short as possible. Ring lug both ends. Critical -- PMU16 output return currents all flow through this wire."

  W_IGN_TO_PMU16:
    wirecount: 1
    colors: [RD]
    wirelabels: ["+12V IGN → PMU16 +12V SW"]
    notes: "18 AWG. Red. IGN-switched +12V source → PMU16 39-pin pin 7 (+12V SW). Low current -- PMU16 on/off sense only. Fuse at source end: 5A."

  W_CAN2_PMU16:
    wirecount: 2
    colors: [GY, PU]
    wirelabels: ["CAN2.H → MaxxECU CAN1H", "CAN2.L → MaxxECU CAN1L"]
    notes: "22 AWG shielded twisted pair. Grey = CAN H (pin 24), Purple = CAN L (pin 34). Drain at MaxxECU end only (chassis GND at ECU connector body). Do NOT untwist more than 5cm at each end. Route away from coil primaries and injector wires. 120 ohm terminators: enable PMU16 CAN2 software termination + verify MaxxECU CAN1 termination."

  # ── PMU16 output wires ───────────────────────────────────────────────────────
  W_PMU16_O1_ECU:
    wirecount: 1
    colors: [RD]
    wirelabels: ["O1 → ECU logic +12V"]
    notes: "16 AWG. Red. PMU16 O1 (PHYS pin 38, 25A) → MaxxECU 12-pin pin 7 (+12V ECU logic). Cross-reference maxxecu-m52.wv ECU_12PIN pin 7."

  W_PMU16_O2_COIL_INJ:
    wirecount: 1
    colors: [RD]
    wirelabels: ["O2 → coil+inj +12V"]
    notes: "12 AWG. Red. PMU16 O2 (PHYS pin 39, 25A) → MaxxECU 12-pin pin 1 (+12V coil/injector supply). Cross-reference maxxecu-m52.wv ECU_12PIN pin 1."

  W_PMU16_O3_FAN:
    wirecount: 1
    colors: [RD]
    wirelabels: ["O3 → fan motor +12V"]
    notes: "12 AWG. Red. PMU16 O3 (PHYS pin 26, 25A PWM) → FAN_MOTOR pin 1. PMU16 PWMs O3 directly for variable speed (future SPAL PWM fan). No relay needed."

  W_PMU16_O4_PUMP:
    wirecount: 1
    colors: [RD]
    wirelabels: ["O4 → pump+ stud (PWM)"]
    notes: "12 AWG. Red. PMU16 O4 (PHYS pin 13, 25A PWM) → RADIUM_HANGER_STUB pump+ stud. Replaces Crydom D1D40 SSR. PMU16 O4 PWMs fuel pump speed via MaxxECU CAN command."

  W_PMU16_O5_EWP:
    wirecount: 1
    colors: [RD]
    wirelabels: ["O5 → EWP +12V supply"]
    notes: "10 AWG (or 8 AWG if paralleling O5+O14). Red. PMU16 O5 (PHYS pin 12, 25A) → EWP_OUTPUT_STUB. See TODO re: 35.5A CWA400 current vs 25A channel limit."

  W_PMU16_O6_CONDENSER:
    wirecount: 1
    colors: [RD]
    wirelabels: ["O6 → condenser fan +12V"]
    notes: "12 AWG. Red. PMU16 O6 (PHYS pin 11, 15A) → CONDENSER_FAN pin 1. PMU16 activates O6 when MaxxECU CAN AC-on signal received."

  W_PMU16_O7_AC_RELAY:
    wirecount: 1
    colors: [RD]
    wirelabels: ["O7 → AC relay coil 86"]
    notes: "18 AWG. Red. PMU16 O7 (PHYS pin 10, 15A) → AC_RELAY_COIL_STUB (ac-compressor.wv AC_RELAY pin 86). Very low current -- relay coil only (~200mA). Replaces fuse block F10 feed."

  # ── Fan and condenser GND returns ───────────────────────────────────────────
  W_FAN_GND:
    wirecount: 1
    colors: [BK]
    wirelabels: ["fan GND"]
    notes: "FAN_MOTOR pin 2 :: chassis GND stud. 12 AWG. Return current path."

  W_CONDENSER_FAN_GND:
    wirecount: 1
    colors: [BK]
    wirelabels: ["condenser fan GND"]
    notes: "CONDENSER_FAN pin 2 :: chassis GND stud. 12 AWG."


# ── Connections ─────────────────────────────────────────────────────────────────
# Format: connector -- cable -- connector (must strictly alternate)
# Every connection must have the same pin count on both connector ends.

connections:

  # ── Main power path: BATT+ → 4-post cutoff → ANL fuse → PMU16 stud ──────────
  - - BATT_POS: [1]
    - W_BATT_POS_TO_CUTOFF: [1]
    - CUTOFF_4POST: [1]

  - - CUTOFF_4POST: [3]
    - W_CUTOFF_TO_ANL: [1]
    - MAIN_FUSE: [1]

  - - MAIN_FUSE: [2]
    - W_MAIN_TO_PMU16: [1]
    - PMU16: [1]

  # ── Battery negative: two separate leads ─────────────────────────────────────
  # Lead 1: battery → chassis stud (PMU16 GND, body returns, fan/pump GND)
  - - BATT_NEG: [1]
    - W_BATT_NEG_CHASSIS: [1]
    - CHASSIS_GND: [1]

  # Lead 2: battery → engine block directly (ECU GND, coil GND reference)
  - - BATT_NEG: [2]
    - W_BATT_NEG_ENGINE: [1]
    - ENGINE_BLOCK_GND: [1]

  # ── PMU16 GND and IGN sense ───────────────────────────────────────────────────
  - - CHASSIS_GND: [1]
    - W_PMU16_GND: [1]
    - PMU16: [2]

  - - IGN_12V_SOURCE: [1]
    - W_IGN_TO_PMU16: [1]
    - PMU16: [3]

  # ── PMU16 CAN2 to MaxxECU CAN1 ───────────────────────────────────────────────
  - - PMU16: [4, 5]
    - W_CAN2_PMU16: [1, 2]
    - MAXXECU_CAN1_STUB: [1, 2]

  # ── PMU16 outputs to loads ────────────────────────────────────────────────────
  - - PMU16: [6]
    - W_PMU16_O1_ECU: [1]
    - ECU_POWER_STUBS: [2]

  - - PMU16: [7]
    - W_PMU16_O2_COIL_INJ: [1]
    - ECU_POWER_STUBS: [1]

  - - PMU16: [8]
    - W_PMU16_O3_FAN: [1]
    - FAN_MOTOR: [1]

  - - PMU16: [9]
    - W_PMU16_O4_PUMP: [1]
    - RADIUM_HANGER_STUB: [1]

  - - PMU16: [10]
    - W_PMU16_O5_EWP: [1]
    - EWP_OUTPUT_STUB: [1]

  - - PMU16: [11]
    - W_PMU16_O6_CONDENSER: [1]
    - CONDENSER_FAN: [1]

  - - PMU16: [12]
    - W_PMU16_O7_AC_RELAY: [1]
    - AC_RELAY_COIL_STUB: [1]

  # ── Fan and condenser GND returns ─────────────────────────────────────────────
  - - CHASSIS_GND: [1]
    - W_FAN_GND: [1]
    - FAN_MOTOR: [2]

  - - CHASSIS_GND: [1]
    - W_CONDENSER_FAN_GND: [1]
    - CONDENSER_FAN: [2]
